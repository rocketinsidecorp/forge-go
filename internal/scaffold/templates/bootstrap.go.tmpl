// Package bootstrap is {{.Name}}'s composition root: it builds the adapters
// and wires them into the Forge runtime.
{{- if .API}}
//
// {{.Name}} is an API-only application (forge new --api): JSON handlers
// only, with no views, assets, translations or browser middleware (CSRF,
// method override, flash). The generators that write pages refuse it.
{{- end}}
package bootstrap

import (
	"context"
{{- if or (not .API) (and .DB .DB.Jobs)}}
	"errors"
{{- end}}
	"net/http"

	forge "github.com/rocketinsidecorp/forge-go"
{{- if not .API}}
	"github.com/rocketinsidecorp/forge-go/csrf"
	"github.com/rocketinsidecorp/forge-go/i18n"
{{- end}}
{{- if and .DB .DB.Jobs}}
	"github.com/rocketinsidecorp/forge-go/jobs"
	jobs{{.DB.Adapter}} "github.com/rocketinsidecorp/forge-go/jobs/{{.DB.Adapter}}"
{{- end}}
	"github.com/rocketinsidecorp/forge-go/openapi"
{{- if .DB}}
	"github.com/rocketinsidecorp/forge-go/{{.DB.Adapter}}"
	"github.com/rocketinsidecorp/forge-go/queue"
	queue{{.DB.Adapter}} "github.com/rocketinsidecorp/forge-go/queue/{{.DB.Adapter}}"
{{- if ne .DB.Adapter "postgres"}}
	"github.com/rocketinsidecorp/forge-go/sqldb"
{{- end}}
{{- end}}
{{- if not .API}}
	"github.com/rocketinsidecorp/forge-go/web"

	appassets "{{.Module}}/app/assets"
	"{{.Module}}/config/locales"
{{- end}}
)

// Configure registers dependencies, readiness checks and routes. Keep
// business rules in app/domain and app/application; only wire them here.
{{- if .DB}}
func Configure(ctx context.Context, app *forge.App) error {
{{- if eq .DB.Adapter "postgres"}}
	// Outside development and test, Open refuses a role that could bypass
	// row-level security (superuser, BYPASSRLS, CREATEROLE, TRUNCATE on a
	// tenant table, a role setting): serve as the runtime role. `routes`
	// and `openapi` compose the application without serving it
	// (app.Serving() is false): the pool then connects only if something
	// queries, so they need no reachable database.
	database, err := postgres.Open(ctx, app.Config().Database, postgres.WithTelemetry(app.Telemetry()),
		postgres.Lazy(!app.Serving()))
{{- else if eq .DB.Adapter "mysql"}}
	// `routes` and `openapi` compose the application without serving it
	// (app.Serving() is false): the pool then connects only if something
	// queries, so they need no reachable database.
	database, err := mysql.Open(ctx, app.Config().Database, mysql.WithTelemetry(app.Telemetry()),
		mysql.Lazy(!app.Serving()))
{{- else}}
	database, err := {{.DB.Adapter}}.Open(ctx, app.Config().Database, {{.DB.Adapter}}.WithTelemetry(app.Telemetry()))
{{- end}}
	if err != nil {
		return err
	}
	if err := app.OnShutdown(database.Shutdown); err != nil {
{{- if eq .DB.Adapter "postgres"}}
		database.Close()
{{- else}}
		// The registration error is the one to report.
		_ = database.Close()
{{- end}}
		return err
	}
	if err := app.Readiness("database", database.Ping); err != nil {
		return err
	}
{{- if .API}}
	if err := routes(ctx, app); err != nil {
		return err
	}
{{- else}}
	// Translations (config/locales) for the pages and flash messages, in
	// each request's locale.
	translator, err := locales.New(app.Config(), app.Logger())
	if err != nil {
		return err
	}
	if err := routes(ctx, app, translator); err != nil {
		return err
	}
{{- end}}
	// The routes `forge generate scaffold`, `resource` and `controller` add
	// (app/bootstrap/routes_gen.go, which they rewrite; this file is yours).
{{- if .DB.Identity}}
	// The seam mounts the sign-in pages first (identityRoutes, identity.go)
	// and guards those routes with their session store.
{{- end}}
	if err := {{.RoutesCall}}; err != nil {
		return err
	}
	// The persistent job queue (its tables come with `migrate`, its
	// `jobs` command with the binary): a worker for the jobs registered in
	// QueueConfigure, started only while serving.
	if err := QueueConfigure(ctx, app, database, queue.NewRegistry()); err != nil {
		return err
	}
{{- if .DB.Jobs}}
	// Recurring jobs. Their ticks are recorded in the database
	// (forge_job_schedules), so with several replicas each tick of a job
	// runs on exactly one of them.
	return JobsConfigure(app, jobs{{.DB.Adapter}}.NewTickClaimer(database))
{{- else}}
	return nil
{{- end}}
}
{{- else if .API}}
func Configure(ctx context.Context, app *forge.App) error {
	if err := routes(ctx, app); err != nil {
		return err
	}
	// The routes `forge generate controller` adds
	// (app/bootstrap/routes_gen.go, which it rewrites; this file is yours).
	return {{.RoutesCall}}
}
{{- else}}
func Configure(ctx context.Context, app *forge.App) error {
	// Translations (config/locales) for the pages and flash messages, in
	// each request's locale.
	translator, err := locales.New(app.Config(), app.Logger())
	if err != nil {
		return err
	}
	if err := routes(ctx, app, translator); err != nil {
		return err
	}
	// The routes `forge generate controller` adds
	// (app/bootstrap/routes_gen.go, which it rewrites; this file is yours).
	return {{.RoutesCall}}
}
{{- end}}

{{ if .DB}}
// QueueConfigure runs the persistent job queue (package queue, docs/JOBS.md):
// the tables are a migration set of this application (db.MigrationSets), so
// `{{.Name}} migrate` creates them, and `{{.Name}} jobs status` inspects the queue.
// Register handlers on registry (`forge generate job NAME --queue` writes
// the typed handler and prints how); a worker for them starts only while the
// application serves (app.Serving()), so `routes` and `openapi` claim no job,
// and only once a handler exists: a worker without handlers refuses to start.
// FORGE_JOBS_NOTIFY=true wakes idle workers on enqueue (PostgreSQL only);
// unset keeps polling. Shutdown stops claiming and lets running jobs finish
// within the shutdown budget.
func QueueConfigure(ctx context.Context, app *forge.App, database {{if eq .DB.Adapter "postgres"}}*postgres.DB{{else}}*sqldb.DB{{end}}, registry *queue.Registry) error {
{{- if eq .DB.Adapter "postgres"}}
	var options []queuepostgres.Option
	if app.Config().Jobs.Notifies(false) {
		options = append(options, queuepostgres.WithNotify())
	}
	store, err := queuepostgres.NewStore(database, options...)
{{- else}}
	store, err := queue{{.DB.Adapter}}.NewStore(database)
{{- end}}
	if err != nil {
		return err
	}
	worker, err := queue.NewWorker(store, registry, queue.WorkerOptions{
		Logger:    app.Logger(),
		Telemetry: app.Telemetry(),
	})
	if err != nil {
		return err
	}
	if !app.Serving() || len(registry.Kinds()) == 0 {
		return nil
	}
	if err := worker.Start(ctx); err != nil {
		return err
	}
	return app.OnShutdown(worker.Shutdown)
}
{{- end}}

{{ if and .DB .DB.Jobs}}
// JobsConfigure starts the in-process scheduler for recurring jobs and stops
// it, waiting for running jobs within the shutdown budget, when the application
// shuts down. It starts nothing while `routes` or `openapi` only describe the
// application (app.Serving() is false). Register application jobs on the scheduler below. Configure
// passes the database's tick claimer (jobs{{.DB.Adapter}}.NewTickClaimer): every
// replica runs the scheduler, and each tick of a job runs on exactly one
// replica, the first to record it in forge_job_schedules once it has a free
// slot. Recording a tick borrows a connection for one statement only. A tick
// that cannot be recorded (database unreachable) is skipped and reported
// through OnError. Two replicas may run consecutive ticks of one job at the
// same time, so a job longer than its interval must tolerate that.
func JobsConfigure(app *forge.App, ticks jobs.TickClaimer) error {
	options := jobs.SchedulerOptions{
		MaxConcurrentJobs: 4,
		Telemetry:         app.Telemetry(),
		OnError: func(name string, err error) {
			// A job that fell behind its schedule runs the latest missed
			// tick once and skips the others instead of replaying them
			// (MaxLateness, one interval by default).
			var skipped *jobs.SkippedTicksError
			if errors.As(err, &skipped) {
				app.Logger().Warn("scheduled ticks skipped", "job", name, "skipped", skipped.Skipped, "behind", skipped.Behind)
				return
			}
			app.Logger().Error("scheduled job failed", "job", name, "error", err)
		},
		Ticks: ticks,
	}
	// NewScheduler would silently clamp a bad value: refuse it at startup.
	if err := options.Validate(); err != nil {
		return err
	}
	scheduler := jobs.NewScheduler(options)
	// Register application jobs here (they need the time package), e.g.:
	// if err := scheduler.Register("cleanup", jobs.ScheduleSpec{Every: 24 * time.Hour}, func(ctx context.Context) error {
	//	// ctx is cancelled on shutdown: return promptly when it is done.
	//	return nil
	// }); err != nil {
	//	_ = scheduler.Stop()
	//	return err
	// }
	// A job that needs the database uses the handle Configure opened: pass it
	// to JobsConfigure and on to the job's constructor, and call
	// database.InTx(ctx, func(tx ...) error).
	if !app.Serving() {
		// `routes` and `openapi` only describe the application: no job
		// runs and no tick is recorded in forge_job_schedules.
		return nil
	}
	if err := app.OnShutdown(scheduler.StopContext); err != nil {
		_ = scheduler.Stop()
		return err
	}
	scheduler.Start()
	return nil
}
{{- end}}

{{- if .API}}

func routes(_ context.Context, app *forge.App) error {
	// JSON endpoints declare their types: GET /openapi.json (development
	// and test, or FORGE_OPENAPI_ENABLED=true) and `forge openapi` describe
	// them. openapi.Typed derives the description from the handler itself.
	if err := app.SetAPIInfo(openapi.Info{Title: "{{.Name}}", Version: apiVersion}); err != nil {
		return err
	}
	// Public routes. Forge serves /health, /health/live and /health/ready.
	if err := app.Handle("GET /{$}", openapi.Typed(http.StatusOK, openapi.Operation{
		Summary: "Application name and version",
		Tags:    []string{"status"},
	}, welcome)); err != nil {
		return err
	}
	if err := app.Handle("GET /v1/status", openapi.Typed(http.StatusOK, openapi.Operation{
		Summary: "Service status",
		Tags:    []string{"status"},
	}, status)); err != nil {
		return err
	}
	return nil
}
{{- else}}

func routes(ctx context.Context, app *forge.App, translator *i18n.Translator) error {
	if err := useBrowserPipeline(app, translator); err != nil {
		return err
	}
	// Digested, immutable static files: the stylesheet, the logo, the
	// JavaScript and the vendored Turbo and Stimulus (app/assets).
	bundle, err := appassets.Load()
	if err != nil {
		return err
	}
	logo, ok := bundle.Set.Path("forge-go-logo.png")
	if !ok {
		return errors.New("app/assets does not embed forge-go-logo.png")
	}
	// Public routes
	if err := app.HandleFunc("GET /{$}", welcomeHandler(logo)); err != nil {
		return err
	}
	if err := app.Handle("GET /assets/", bundle.Set.Handler()); err != nil {
		return err
	}
	// JSON endpoints declare their types: GET /openapi.json (development
	// and test, or FORGE_OPENAPI_ENABLED=true) and `forge openapi` describe
	// them. openapi.Typed derives the description from the handler itself.
	if err := app.SetAPIInfo(openapi.Info{Title: "{{.Name}}", Version: "0.1.0"}); err != nil {
		return err
	}
	if err := app.Handle("GET /v1/status", openapi.Typed(http.StatusOK, openapi.Operation{
		Summary: "Service status",
		Tags:    []string{"status"},
	}, status)); err != nil {
		return err
	}
	return nil
}

// useBrowserPipeline installs the middleware server-rendered HTML relies on,
// ahead of routing: each request gets its locale (the "locale" cookie, then
// Accept-Language, then the default) for i18n.T and the views' t helper;
// HTML forms reach PUT, PATCH and DELETE routes through a _method field;
// unsafe requests need the CSRF token (csrfField in a form, the
// X-CSRF-Token header in scripts) and must not come from another origin;
// flash messages survive one redirect. Bearer-token and JSON API requests
// are not affected by the token check. List webhook routes that
// authenticate by signature in csrf.Options.Exempt. Set PathPrefix (/pt-BR/...)
// or Param (?locale=pt-BR) in i18n.NegotiationOptions to let URLs choose the
// locale.
func useBrowserPipeline(app *forge.App, translator *i18n.Translator) error {
	translations, err := translator.Middleware(i18n.NegotiationOptions{})
	if err != nil {
		return err
	}
	protection, err := csrf.New(csrf.Options{})
	if err != nil {
		return err
	}
	for _, middleware := range []func(http.Handler) http.Handler{translations, web.MethodOverride, protection.Handler, web.Flash} {
		if err := app.Use(middleware); err != nil {
			return err
		}
	}
	return nil
}
{{- end}}

type statusResponse struct {
	Service string `json:"service" example:"{{.Name}}"`
	Status  string `json:"status" example:"ok"`
}

func status(*http.Request, openapi.NoBody) (statusResponse, error) {
	return statusResponse{Service: "{{.Name}}", Status: "ok"}, nil
}
