// Package bootstrap is {{.Name}}'s composition root: it builds the adapters
// and wires them into the Forge runtime.
package bootstrap

import (
	"context"
	{{- if and .DB .DB.Identity}}
	"errors"
	"log/slog"
	{{- end}}
	"net/http"

	forge "github.com/rocketinsidecorp/forge-go"
{{- if and .DB .DB.Identity}}
	"github.com/rocketinsidecorp/forge-go/auth"
	authpostgres "github.com/rocketinsidecorp/forge-go/auth/postgres"
{{- end}}
	"github.com/rocketinsidecorp/forge-go/csrf"
{{- if and .DB .DB.Jobs}}
	"github.com/rocketinsidecorp/forge-go/jobs"
{{- end}}
{{- if .DB}}
	"github.com/rocketinsidecorp/forge-go/{{.DB.Adapter}}"
{{- end}}
	"github.com/rocketinsidecorp/forge-go/web"
{{- if and .DB .DB.Identity}}

	"{{.Module}}/app/adapters/htmlauth"
	"{{.Module}}/app/views"
{{- end}}
)

// Configure registers dependencies, readiness checks and routes. Keep
// business rules in app/domain and app/application; only wire them here.
{{- if .DB}}
func Configure(ctx context.Context, app *forge.App) error {
	database, err := {{.DB.Adapter}}.Open(ctx, app.Config().Database)
	if err != nil {
		return err
	}
	if err := app.OnShutdown(database.Shutdown); err != nil {
{{- if eq .DB.Adapter "postgres"}}
		database.Close()
{{- else}}
		// The registration error is the one to report.
		_ = database.Close()
{{- end}}
		return err
	}
	if err := app.Readiness("database", database.Ping); err != nil {
		return err
	}
	if err := routes(ctx, app); err != nil {
		return err
	}
{{- if and .DB .DB.Identity}}
	return identityRoutes(app, database)
{{- else}}
	return nil
{{- end}}
}
{{- else}}
func Configure(_ context.Context, app *forge.App) error {
	return routes(context.Background(), app)
}
{{- end}}

{{- if and .DB .DB.Jobs}}
func JobsConfigure(app *forge.App) error {
	scheduler := jobs.NewScheduler(jobs.SchedulerOptions{
		MaxConcurrentJobs: 4,
		OnError: func(name string, err error) {
			app.Logger().Error("scheduled job failed", "job", name, "error", err)
		},
	})
	// Register application jobs here, e.g.:
	// scheduler.Register("cleanup", jobs.ScheduleSpec{Every: 24 * time.Hour}, func(ctx context.Context) error {
	//     return app.InTx(ctx, func(tx pgx.Tx) error {
	//         // cleanup work
	//         return nil
	//     })
	// })
	if err := app.OnShutdown(func(ctx context.Context) error { return scheduler.Stop() }); err != nil {
		_ = scheduler.Stop()
		return err
	}
	scheduler.Start()
	return nil
}
{{- end}}

func routes(ctx context.Context, app *forge.App) error {
	if err := useBrowserPipeline(app); err != nil {
		return err
	}
	// Public routes
	if err := app.HandleFunc("GET /{$}", welcome); err != nil {
		return err
	}
	if err := app.Handle("GET /assets/", brandAssetsHandler()); err != nil {
		return err
	}
	if err := app.HandleFunc("GET /v1/status", status); err != nil {
		return err
	}
	return nil
}

// useBrowserPipeline installs the middleware server-rendered HTML relies on,
// ahead of routing: HTML forms reach PUT, PATCH and DELETE routes through a
// _method field; unsafe requests need the CSRF token (csrfField in a form,
// the X-CSRF-Token header in scripts) and must not come from another
// origin; flash messages survive one redirect. Bearer-token and JSON API
// requests are not affected by the token check. List webhook routes that
// authenticate by signature in csrf.Options.Exempt.
func useBrowserPipeline(app *forge.App) error {
	protection, err := csrf.New(csrf.Options{})
	if err != nil {
		return err
	}
	for _, middleware := range []func(http.Handler) http.Handler{web.MethodOverride, protection.Handler, web.Flash} {
		if err := app.Use(middleware); err != nil {
			return err
		}
	}
	return nil
}

func status(w http.ResponseWriter, _ *http.Request) {
	web.JSON(w, http.StatusOK, map[string]string{"service": "{{.Name}}", "status": "ok"})
}

{{- if and .DB .DB.Identity}}

func identityRoutes(app *forge.App, database *postgres.DB) error {
	repository, err := authpostgres.New(database)
	if err != nil {
		return err
	}
	throttler, err := authpostgres.NewLoginThrottler(database, auth.DefaultLoginThrottleConfig())
	if err != nil {
		return err
	}
	loginOptions := []auth.LoginOption{
		auth.WithLoginThrottler(throttler),
		auth.WithSecurityAuditor(repository),
	}
	var mfaCompletion http.Handler
	var mfaService *auth.MFAService
	if !app.Config().Auth.MFAKey.IsZero() {
		cipher, err := auth.NewAESGCMSecretCipherBase64(app.Config().Auth.MFAKey.Reveal())
		if err != nil {
			return err
		}
		mfaThrottler, err := authpostgres.NewLoginThrottler(database, auth.DefaultMFAThrottleConfig())
		if err != nil {
			return err
		}
		mfa, err := auth.NewMFAService(
			repository,
			repository,
			cipher,
			auth.WithMFAThrottler(mfaThrottler),
			auth.WithMFAAuditor(repository),
		)
		if err != nil {
			return err
		}
		mfaService = mfa
		loginOptions = append(loginOptions, auth.WithMFAChallengeIssuer(mfa))
		mfaCompletion, err = auth.NewMFACompletionHandler(mfa)
		if err != nil {
			return err
		}
	}
	login, err := auth.NewLoginService(repository, repository, loginOptions...)
	if err != nil {
		return err
	}
	// The view renderer every HTML page shares (app/views).
	renderer, err := views.New()
	if err != nil {
		return err
	}
	middleware, err := auth.NewMiddleware(repository)
	if err != nil {
		return err
	}
	loginHandler, err := auth.NewLoginHandler(login)
	if err != nil {
		return err
	}
	logoutHandler, err := auth.NewAuditedLogoutHandler(repository, repository)
	if err != nil {
		return err
	}
	if err := app.Handle("POST /auth/login", loginHandler); err != nil {
		return err
	}
	if err := app.Handle("POST /auth/logout", logoutHandler); err != nil {
		return err
	}
	if mfaCompletion != nil {
		if err := app.Handle("POST /auth/mfa/complete", mfaCompletion); err != nil {
			return err
		}
	}

	// Password recovery routes (public, non-enumerating)
	recoveryService, err := auth.NewRecoveryService(repository, recoveryDeliveryNotConfigured{logger: app.Logger()}, auth.WithRecoveryThrottler(throttler), auth.WithRecoveryAuditor(repository))
	if err != nil {
		return err
	}
	recoveryRequestHandler, err := auth.NewAuditedPasswordRecoveryRequestHandler(recoveryService, repository)
	if err != nil {
		return err
	}
	recoveryResetHandler, err := auth.NewAuditedPasswordResetHandler(recoveryService, repository)
	if err != nil {
		return err
	}
	if err := app.Handle("POST /auth/recovery/request", recoveryRequestHandler); err != nil {
		return err
	}
	if err := app.Handle("POST /auth/recovery/reset", recoveryResetHandler); err != nil {
		return err
	}

	// Cookie-based authentication routes (browser applications)
	cookieLoginHandler, err := auth.NewCookieLoginHandler(login)
	if err != nil {
		return err
	}
	if err := app.Handle("POST /auth/cookie/login", cookieLoginHandler); err != nil {
		return err
	}
	if mfaService != nil {
		cookieMFACompletionHandler, err := auth.NewCookieMFACompletionHandler(mfaService)
		if err != nil {
			return err
		}
		if err := app.Handle("POST /auth/cookie/mfa/complete", cookieMFACompletionHandler); err != nil {
			return err
		}
	}
	cookieLogoutHandler, err := auth.NewAuditedCookieLogoutHandler(repository, repository)
	if err != nil {
		return err
	}
	if err := app.Handle("POST /auth/cookie/logout", cookieLogoutHandler); err != nil {
		return err
	}

	// HTML sign-in, sign-out, two-factor and password-reset pages
	// (app/adapters/htmlauth). They set the same session cookies as the
	// cookie routes above; auth.Browser verifies the CSRF token of every form.
	browser, err := auth.NewBrowser(auth.BrowserOptions{
		Login:    login,
		Sessions: repository,
		MFA:      mfaService,
		Recovery: recoveryService,
		Auditor:  repository,
	})
	if err != nil {
		return err
	}
	if err := htmlauth.Register(app, browser, renderer); err != nil {
		return err
	}

	// MFA enrollment/management routes (require authenticated principal + step-up authorizer)
	// These are intentionally left for application-specific step-up policy.
	// Applications can wire them in app/bootstrap/bootstrap.go after generation.

	// Pages behind a permission authenticate the session cookie and send
	// signed-out browsers to the sign-in page, for example:
	//
	//	page, err := auth.RequireAudited("reports:read", reportsPage, repository)
	//	...
	//	guarded, err := middleware.AuthenticateBrowser(htmlauth.SignInPath, page)

	return app.Handle("GET /v1/auth/session", middleware.Authenticate(http.HandlerFunc(currentSession)))
}

// recoveryDeliveryNotConfigured fails closed until the application installs a
// delivery adapter. It never logs recipient addresses, tokens, or reset URLs.
type recoveryDeliveryNotConfigured struct{ logger *slog.Logger }

func (s recoveryDeliveryNotConfigured) SendPasswordRecovery(ctx context.Context, _ auth.PasswordRecoveryMessage) error {
	if s.logger != nil {
		s.logger.ErrorContext(ctx, "password recovery delivery is not configured")
	}
	return errors.New("password recovery delivery is not configured")
}

type sessionResponse struct {
	SubjectID   string            `json:"subject_id"`
	TenantID    string            `json:"tenant_id"`
	Permissions []auth.Permission `json:"permissions"`
}

func currentSession(w http.ResponseWriter, r *http.Request) {
	principal, ok := auth.FromContext(r.Context())
	if !ok {
		web.Error(w, r, auth.ErrCredentialsRequired)
		return
	}
	web.JSON(w, http.StatusOK, sessionResponse{
		SubjectID:   principal.SubjectID().String(),
		TenantID:    principal.Tenant().ID.String(),
		Permissions: principal.Permissions(),
	})
}
{{- end}}
