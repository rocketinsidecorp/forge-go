// TestLayoutRendersFlashAndCSRF renders a page inside the application layout
// through the same middleware app/bootstrap installs.
func TestLayoutRendersFlashAndCSRF(t *testing.T) {
	t.Parallel()
	tree := fstest.MapFS{
		"pages/example.gohtml": {Data: []byte(`{{"{{"}}define "title"{{"}}"}}Example{{"{{"}}end{{"}}"}}{{"{{"}}define "content"{{"}}"}}<form method="post" action="/example">{{"{{"}}csrfField{{"}}"}}</form>{{"{{"}}end{{"}}"}}`)},
	}
	err := fs.WalkDir(Files(), ".", func(name string, entry fs.DirEntry, err error) error {
		if err != nil || entry.IsDir() {
			return err
		}
		data, err := fs.ReadFile(Files(), name)
		tree[name] = &fstest.MapFile{Data: data}
		return err
	})
	if err != nil {
		t.Fatal(err)
	}
	options, err := Options()
	if err != nil {
		t.Fatal(err)
	}
	renderer, err := forgeviews.Load(tree, options)
	if err != nil {
		t.Fatal(err)
	}
	protection, err := csrf.New(csrf.Options{})
	if err != nil {
		t.Fatal(err)
	}
	cfg := config.Default()
	cfg.I18n.DefaultLocale = "en"
	translator, err := locales.New(cfg, nil)
	if err != nil {
		t.Fatal(err)
	}
	translations, err := translator.Middleware(i18n.NegotiationOptions{})
	if err != nil {
		t.Fatal(err)
	}
	handler := translations(web.Flash(protection.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if err := renderer.RenderRequest(w, r, "pages/example", http.StatusOK, nil); err != nil {
			t.Error(err)
		}
	}))))

	// A flash message set by a previous response.
	saved := httptest.NewRecorder()
	web.Flash(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		_ = web.SetFlash(w, r, web.FlashNotice, "Saved <b>draft</b>")
	})).ServeHTTP(saved, httptest.NewRequest(http.MethodPost, "/example", nil))

	request := httptest.NewRequest(http.MethodGet, "/example", nil)
	for _, cookie := range saved.Result().Cookies() {
		request.AddCookie(cookie)
	}
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	body := recorder.Body.String()
	var token string
	for _, cookie := range recorder.Result().Cookies() {
		if cookie.Name == csrf.CookieName {
			token = cookie.Value
		}
	}
	bundle, err := assets.Load()
	if err != nil {
		t.Fatal(err)
	}
	stylesheet, _ := bundle.Set.Path("application.css")
	entry, _ := bundle.Set.Path("application.js")
	for _, want := range []string{
		`<html lang="en">`,
		`<a class="skip-link" href="#main">Skip to content</a>`,
		"<title>Example</title>",
		`<link rel="stylesheet" href="` + stylesheet + `">`,
		string(bundle.ImportMap.Tag()),
		`<script type="module" src="` + entry + `"></script>`,
		`<p class="flash flash-notice" role="status">Saved &lt;b&gt;draft&lt;/b&gt;</p>`,
	} {
		if token == "" || !strings.Contains(body, want) {
			t.Fatalf("missing %q in:\n%s", want, body)
		}
	}
	// The page embeds the cookie's token masked with a fresh pad on every
	// call (csrf.Token), so no two renders, nor the meta tag and the form
	// field, carry the same bytes, and neither is the token itself.
	meta := embeddedValue(body, `<meta name="csrf-token" content="`)
	field := embeddedValue(body, `<input type="hidden" name="authenticity_token" value="`)
	if !csrf.Match(token, meta) || !csrf.Match(token, field) || meta == field || meta == token || field == token {
		t.Fatalf("the embedded CSRF tokens do not carry the cookie token masked: meta=%q field=%q", meta, field)
	}
	// The import map is the one inline script, allowed by its hash alone.
	policy := recorder.Header().Get("Content-Security-Policy")
	if !strings.Contains(policy, "script-src 'self' "+bundle.ImportMap.CSPSource()+";") || strings.Contains(policy, "unsafe-") {
		t.Fatalf("Content-Security-Policy = %q", policy)
	}
	scripts := strings.Count(body, "<script")
	if scripts != 2 || strings.Count(body, `<script type="importmap">`) != 1 || strings.Contains(body, " style=") || strings.Contains(body, "<style") {
		t.Fatalf("the layout must have only the import map and the module script, and no inline styles:\n%s", body)
	}
}

// embeddedValue is the attribute value that follows prefix in body.
func embeddedValue(body, prefix string) string {
	_, rest, found := strings.Cut(body, prefix)
	if !found {
		return ""
	}
	value, _, _ := strings.Cut(rest, `"`)
	return value
}
