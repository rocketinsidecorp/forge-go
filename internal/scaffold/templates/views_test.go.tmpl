// TestLayoutRendersFlashAndCSRF renders a page inside the application layout
// through the same middleware app/bootstrap installs.
func TestLayoutRendersFlashAndCSRF(t *testing.T) {
	t.Parallel()
	tree := fstest.MapFS{
		"pages/example.gohtml": {Data: []byte(`{{"{{"}}define "title"{{"}}"}}Example{{"{{"}}end{{"}}"}}{{"{{"}}define "content"{{"}}"}}<form method="post" action="/example">{{"{{"}}csrfField{{"}}"}}</form>{{"{{"}}end{{"}}"}}`)},
	}
	err := fs.WalkDir(Files(), ".", func(name string, entry fs.DirEntry, err error) error {
		if err != nil || entry.IsDir() {
			return err
		}
		data, err := fs.ReadFile(Files(), name)
		tree[name] = &fstest.MapFile{Data: data}
		return err
	})
	if err != nil {
		t.Fatal(err)
	}
	renderer, err := forgeviews.Load(tree, forgeviews.Options{})
	if err != nil {
		t.Fatal(err)
	}
	protection, err := csrf.New(csrf.Options{})
	if err != nil {
		t.Fatal(err)
	}
	handler := web.Flash(protection.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if err := renderer.RenderRequest(w, r, "pages/example", http.StatusOK, nil); err != nil {
			t.Error(err)
		}
	})))

	// A flash message set by a previous response.
	saved := httptest.NewRecorder()
	web.Flash(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		_ = web.SetFlash(w, r, web.FlashNotice, "Saved <b>draft</b>")
	})).ServeHTTP(saved, httptest.NewRequest(http.MethodPost, "/example", nil))

	request := httptest.NewRequest(http.MethodGet, "/example", nil)
	for _, cookie := range saved.Result().Cookies() {
		request.AddCookie(cookie)
	}
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	body := recorder.Body.String()
	var token string
	for _, cookie := range recorder.Result().Cookies() {
		if cookie.Name == csrf.CookieName {
			token = cookie.Value
		}
	}
	for _, want := range []string{
		"<title>Example</title>",
		`<link rel="stylesheet" href="/assets/application.css">`,
		`<meta name="csrf-token" content="` + token + `">`,
		`<input type="hidden" name="authenticity_token" value="` + token + `">`,
		`<p class="flash flash-notice" role="status">Saved &lt;b&gt;draft&lt;/b&gt;</p>`,
	} {
		if token == "" || !strings.Contains(body, want) {
			t.Fatalf("missing %q in:\n%s", want, body)
		}
	}
	if recorder.Header().Get("Content-Security-Policy") != forgeviews.DefaultContentSecurityPolicy {
		t.Fatalf("Content-Security-Policy = %q", recorder.Header().Get("Content-Security-Policy"))
	}
	if strings.Contains(body, "<script") || strings.Contains(body, " style=") || strings.Contains(body, "<style") {
		t.Fatalf("the layout must not need inline scripts or styles:\n%s", body)
	}
}
