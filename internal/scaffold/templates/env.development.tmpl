# Development settings for {{.Name}}, read by `forge dev`, `forge test`,
# `forge migrate` and `forge rollback`. Variables already set in the
# environment win. Put personal overrides in .env.local (git-ignored).
# This file is excluded from Docker images and must never hold real secrets.
FORGE_ENV=development
{{- if .DB}}
FORGE_DATABASE_URL={{.DevDatabaseURL}}
{{- if .TestDatabaseURL}}
# Tests create and drop their own databases on this server.
FORGE_TEST_DATABASE_URL={{.TestDatabaseURL}}
{{- end}}
{{- end}}
{{- if and .DB .DB.Identity}}
# Password-reset emails. Without FORGE_MAIL_URL the reset pages and the
# "Forgot your password?" link are off. Uncomment to write each email as an
# .eml file under tmp/mail (put a real smtps:// URL only in .env.local):
# FORGE_MAIL_URL=file:tmp/mail
# FORGE_MAIL_FROM={{.Name}} <no-reply@example.com>
# FORGE_AUTH_PASSWORD_RESET_URL=http://localhost:8080/passwords/edit
{{- end}}
