# syntax=docker/dockerfile:1
# Production image for {{.Name}}, generated by Forge.
#
#   docker build -t {{.Name}} .
#   docker run --rm -p 8080:8080 {{.Name}}
#
# The binary is static and runs as a non-root user on a distroless base: no
# shell, no package manager. TLS is expected to terminate at a reverse proxy or
# load balancer (FORGE_HTTP_TRANSPORT=trusted-proxy); expose the container only
# through that proxy, or switch to FORGE_HTTP_TRANSPORT=tls with mounted certs.
# Set FORGE_HTTP_TRUSTED_PROXIES to the proxy's network (forge deploy does) so
# throttles and rate limits see client addresses instead of the proxy's.

ARG GO_VERSION=1.27

# The build stage runs on the builder's platform and cross-compiles for the
# target one, so a multi-platform build (docker buildx build --platform
# linux/amd64,linux/arm64, as the release workflow does) needs no emulator.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/{{.Name}}
{{- if and .DB (not .DB.Server)}}
# The distroless image has no shell to create directories at runtime.
RUN mkdir -p /out/storage
{{- end}}

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/server /app/server
{{- if and .DB (not .DB.Server)}}
# SQLite database directory, owned by the runtime user. Mount a persistent
# volume here: docker run -v {{.Name}}-storage:/app/storage {{.Name}}
COPY --from=build --chown=nonroot:nonroot /out/storage /app/storage
{{- end}}
ENV FORGE_ENV=production \
    FORGE_HTTP_ADDR=0.0.0.0:8080 \
    FORGE_HTTP_TRANSPORT=trusted-proxy{{if and .DB (not .DB.Server)}} \
    FORGE_DATABASE_URL=sqlite:///app/storage/production.db{{end}}
EXPOSE 8080
USER nonroot:nonroot
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD ["/app/server", "healthcheck"]
ENTRYPOINT ["/app/server"]
CMD ["serve"]
