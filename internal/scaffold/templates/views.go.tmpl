// Package views holds {{.Name}}'s server-rendered HTML. Templates live in
// directories next to this file: layouts/ wraps pages, files named
// _NAME.gohtml are partials ({{"{{"}}template "shared/_flash" .{{"}}"}}), and
// every other .gohtml file is a page named by its path, such as
// "posts/index". See the Forge views guide (docs/VIEWS.md).
package views

import (
	"embed"
	"io/fs"

	"github.com/rocketinsidecorp/forge-go/broadcast"
	"github.com/rocketinsidecorp/forge-go/hotwire"
	"github.com/rocketinsidecorp/forge-go/i18n"
	forgeviews "github.com/rocketinsidecorp/forge-go/views"

	"{{.Module}}/app/assets"
)

// files holds every template one directory below app/views, partials
// included. Add a pattern such as */*/*.gohtml before nesting deeper.
//
//go:embed */*.gohtml
var files embed.FS

// Files returns the embedded templates.
func Files() fs.FS { return files }

// Option customizes the renderer New builds.
type Option func(*forgeviews.Options)

// WithStreams lets pages subscribe to real-time updates with
// {{"{{"}}turboStreamFrom "posts"{{"}}"}}: signer signs the channel names the
// browser later presents to the event stream handler (see Forge's broadcast
// package and docs/VIEWS.md).
func WithStreams(signer *broadcast.Signer) Option {
	return func(opts *forgeviews.Options) { opts.Streams = signer }
}

// WithI18n gives the {{"{{"}}t{{"}}"}}, {{"{{"}}l{{"}}"}} and {{"{{"}}number{{"}}"}} helpers a translator for
// fragments rendered without a request, such as broadcasts, which then use
// the default locale. Pages read the translator and the locale the
// i18n middleware puts in the request (app/bootstrap installs it).
func WithI18n(translator *i18n.Translator) Option {
	return func(opts *forgeviews.Options) { opts.I18n = translator }
}

// Options returns the options New passes to forgeviews.Load: the asset bundle
// for {{"{{"}}stylesheetTag{{"}}"}} and {{"{{"}}javascriptImportmapTags{{"}}"}}, and the
// Content-Security-Policy additions they need (the import map's hash and
// Turbo's progress bar style).
func Options(options ...Option) (forgeviews.Options, error) {
	bundle, err := assets.Load()
	if err != nil {
		return forgeviews.Options{}, err
	}
	opts := forgeviews.Options{
		Assets:      bundle.Set,
		ImportMap:   bundle.ImportMap,
		StyleHashes: hotwire.StyleHashes(),
	}
	for _, option := range options {
		option(&opts)
	}
	return opts, nil
}

// New parses the templates. Build one renderer at startup and share it: it
// is safe for concurrent use.
func New(options ...Option) (*forgeviews.Renderer, error) {
	opts, err := Options(options...)
	if err != nil {
		return nil, err
	}
	return forgeviews.Load(files, opts)
}
