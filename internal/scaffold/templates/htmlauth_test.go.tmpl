const (
	testTenant = "kimco"
	// testEmail is the canonical login; the account's stored address keeps
	// its own spelling, and reset links go to that one.
	testEmail    = "kim.owner@example.com"
	storedEmail  = "Kim.Owner@Example.com"
	testPassword = "correct horse battery staple"
)

// memoryIdentity is one account in one tenant, enough to drive the pages
// without a database. TestPagesAgainstTheIdentityStore uses the real repository.
//
// Like a database with a case-insensitive Unicode collation, it matches logins
// with strings.ToLower (which folds the Kelvin sign to "k"): the pages must
// keep look-alike spellings away from it, because it would accept them.
type memoryIdentity struct {
	mu           sync.Mutex
	subjectID    uuid.UUID
	membershipID uuid.UUID
	tenantID     uuid.UUID
	hash         string
	sessions     map[auth.Digest]bool
	resets       map[auth.Digest]bool
	lookups      []string // logins and tenants of every credential lookup
	tokenChecks  int
	consumes     int
}

func (m *memoryIdentity) matches(email, tenant string) bool {
	return strings.ToLower(email) == testEmail && strings.ToLower(tenant) == testTenant
}

func newMemoryIdentity(t *testing.T) *memoryIdentity {
	t.Helper()
	hash, err := auth.HashPassword(testPassword)
	if err != nil {
		t.Fatal(err)
	}
	return &memoryIdentity{
		subjectID: uuid.MustNew(), membershipID: uuid.MustNew(), tenantID: uuid.MustNew(), hash: hash,
		sessions: map[auth.Digest]bool{}, resets: map[auth.Digest]bool{},
	}
}

func (m *memoryIdentity) LookupPassword(_ context.Context, email, tenant string) (auth.PasswordIdentity, bool, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.lookups = append(m.lookups, email+" "+tenant)
	if !m.matches(email, tenant) {
		return auth.PasswordIdentity{}, false, nil
	}
	return auth.PasswordIdentity{SubjectID: m.subjectID, MembershipID: m.membershipID, PasswordHash: m.hash, CredentialVersion: 1}, true, nil
}

func (m *memoryIdentity) ReplacePasswordHash(context.Context, uuid.UUID, string, string) (bool, error) {
	return false, nil
}

func (m *memoryIdentity) CreateSessionAtVersion(context.Context, uuid.UUID, int64, time.Time) (auth.Token, error) {
	token, err := auth.NewToken()
	if err != nil {
		return auth.Token{}, err
	}
	m.mu.Lock()
	defer m.mu.Unlock()
	m.sessions[token.Digest()] = true
	return token, nil
}

// ResolveSession lets auth.Middleware authenticate the session cookie.
func (m *memoryIdentity) ResolveSession(_ context.Context, digest auth.Digest) (auth.Session, bool, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	if !m.sessions[digest] {
		return auth.Session{}, false, nil
	}
	tenant, err := tenancy.New(m.tenantID)
	if err != nil {
		return auth.Session{}, false, err
	}
	principal, err := auth.NewPrincipal(m.subjectID, tenant)
	if err != nil {
		return auth.Session{}, false, err
	}
	return auth.Session{Principal: principal, ExpiresAt: time.Now().Add(time.Hour)}, true, nil
}

func (m *memoryIdentity) RevokeSession(_ context.Context, token auth.Token) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	delete(m.sessions, token.Digest())
	return nil
}

func (m *memoryIdentity) LookupRecovery(_ context.Context, email, tenant string) (auth.RecoveryIdentity, bool, error) {
	if !m.matches(email, tenant) {
		return auth.RecoveryIdentity{}, false, nil
	}
	return auth.RecoveryIdentity{SubjectID: m.subjectID, Email: storedEmail}, true, nil
}

func (m *memoryIdentity) CreateRecovery(_ context.Context, _ uuid.UUID, digest auth.Digest, _ time.Time) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.resets[digest] = true
	return nil
}

func (m *memoryIdentity) InvalidateRecovery(_ context.Context, digest auth.Digest) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	delete(m.resets, digest)
	return nil
}

// RecoveryTokenUsable lets a reset be refused before the new password is
// hashed (auth.RecoveryTokenChecker).
func (m *memoryIdentity) RecoveryTokenUsable(_ context.Context, digest auth.Digest) (bool, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.tokenChecks++
	return m.resets[digest], nil
}

func (m *memoryIdentity) ConsumeRecovery(_ context.Context, digest auth.Digest, hash string) (bool, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.consumes++
	if !m.resets[digest] {
		return false, nil
	}
	clear(m.resets)
	clear(m.sessions)
	m.hash = hash
	return true, nil
}

func (m *memoryIdentity) sessionCount() int {
	m.mu.Lock()
	defer m.mu.Unlock()
	return len(m.sessions)
}

func (m *memoryIdentity) hasSession(digest auth.Digest) bool {
	m.mu.Lock()
	defer m.mu.Unlock()
	return m.sessions[digest]
}

// mailbox captures reset messages instead of sending email. Delivery happens
// on the recovery queue, after the page answered, so tests wait for it. A
// non-nil hold makes every delivery wait until it is closed (holdDeliveries).
type mailbox struct {
	mu       sync.Mutex
	messages []auth.PasswordRecoveryMessage
	hold     chan struct{}
}

func (b *mailbox) SendPasswordRecovery(ctx context.Context, message auth.PasswordRecoveryMessage) error {
	b.mu.Lock()
	b.messages = append(b.messages, message)
	hold := b.hold
	b.mu.Unlock()
	if hold != nil {
		select {
		case <-hold:
		case <-ctx.Done():
			return ctx.Err()
		}
	}
	return nil
}

// holdDeliveries makes every later delivery wait, like a slow mail server,
// until the returned function is called.
func (b *mailbox) holdDeliveries() (release func()) {
	hold := make(chan struct{})
	b.mu.Lock()
	b.hold = hold
	b.mu.Unlock()
	return func() { close(hold) }
}

// delivered waits for want messages and returns them.
func (b *mailbox) delivered(t *testing.T, want int) []auth.PasswordRecoveryMessage {
	t.Helper()
	deadline := time.Now().Add(10 * time.Second)
	for {
		b.mu.Lock()
		messages := append([]auth.PasswordRecoveryMessage(nil), b.messages...)
		b.mu.Unlock()
		if len(messages) >= want || time.Now().After(deadline) {
			if len(messages) != want {
				t.Fatalf("%d reset messages, want %d", len(messages), want)
			}
			return messages
		}
		time.Sleep(5 * time.Millisecond)
	}
}

// none fails if a message is delivered within a short grace period.
func (b *mailbox) none(t *testing.T) {
	t.Helper()
	time.Sleep(200 * time.Millisecond)
	b.mu.Lock()
	defer b.mu.Unlock()
	if len(b.messages) != 0 {
		t.Fatalf("%d reset messages delivered, want none", len(b.messages))
	}
}

// serve mounts the pages behind the middleware app/bootstrap installs, with
// sessions resolving the session cookie. The pages are in English (en.json),
// whatever the application's default locale.
func serve(t *testing.T, browser *auth.Browser, sessions auth.Resolver, options ...htmlauth.Option) http.Handler {
	t.Helper()
	middleware, err := auth.NewMiddleware(sessions)
	if err != nil {
		t.Fatal(err)
	}
	cfg := config.Default()
	cfg.I18n.DefaultLocale = "en"
	translator, err := locales.New(cfg, nil)
	if err != nil {
		t.Fatal(err)
	}
	renderer, err := appviews.New(appviews.WithI18n(translator))
	if err != nil {
		t.Fatal(err)
	}
	app, err := forge.New()
	if err != nil {
		t.Fatal(err)
	}
	translations, err := translator.Middleware(i18n.NegotiationOptions{})
	if err != nil {
		t.Fatal(err)
	}
	protection, err := csrf.New(csrf.Options{})
	if err != nil {
		t.Fatal(err)
	}
	for _, middleware := range []func(http.Handler) http.Handler{translations, web.MethodOverride, protection.Handler, web.Flash} {
		if err := app.Use(middleware); err != nil {
			t.Fatal(err)
		}
	}
	if err := htmlauth.Register(app, browser, renderer, middleware, options...); err != nil {
		t.Fatal(err)
	}
	return app.Handler()
}

func memoryPages(t *testing.T, loginOptions ...auth.LoginOption) (http.Handler, *memoryIdentity, *mailbox) {
	t.Helper()
	identity := newMemoryIdentity(t)
	login, err := auth.NewLoginService(identity, identity, loginOptions...)
	if err != nil {
		t.Fatal(err)
	}
	mail := &mailbox{}
	// The wiring app/bootstrap uses: reset requests go to a bounded queue the
	// test's lifecycle owns, and the page answers after at least 100 ms.
	queue, err := auth.NewRecoveryQueue(auth.RecoveryQueueConfig{})
	if err != nil {
		t.Fatal(err)
	}
	recovery, err := auth.NewRecoveryService(identity, mail, auth.WithRecoveryDispatcher(queue))
	if err != nil {
		t.Fatal(err)
	}
	if err := queue.Start(recovery); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = queue.Shutdown(ctx)
	})
	browser, err := auth.NewBrowser(auth.BrowserOptions{Login: login, Sessions: identity, Recovery: recovery})
	if err != nil {
		t.Fatal(err)
	}
	return serve(t, browser, identity), identity, mail
}

// client is a browser: it keeps cookies between requests and sends the CSRF
// token in the forms it submits.
type client struct {
	t       *testing.T
	handler http.Handler
	cookies map[string]*http.Cookie
}

func newClient(t *testing.T, handler http.Handler) *client {
	return &client{t: t, handler: handler, cookies: map[string]*http.Cookie{}}
}

func (c *client) do(method, target string, form url.Values) *httptest.ResponseRecorder {
	c.t.Helper()
	var body io.Reader
	if form != nil {
		body = strings.NewReader(form.Encode())
	}
	request := httptest.NewRequest(method, "https://app.example.com"+target, body)
	request.Header.Set("Accept", "text/html")
	if form != nil {
		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	}
	for _, cookie := range c.cookies {
		request.AddCookie(cookie)
	}
	recorder := httptest.NewRecorder()
	c.handler.ServeHTTP(recorder, request)
	if strings.Contains(recorder.Body.String(), "translation missing") {
		c.t.Errorf("%s %s shows a missing translation:\n%s", method, target, recorder.Body.String())
	}
	for _, cookie := range recorder.Result().Cookies() {
		if cookie.MaxAge < 0 {
			delete(c.cookies, cookie.Name)
		} else {
			c.cookies[cookie.Name] = cookie
		}
	}
	return recorder
}

// submit posts form with the CSRF token of the last page shown.
func (c *client) submit(target string, form url.Values) *httptest.ResponseRecorder {
	c.t.Helper()
	token, ok := c.cookies[csrf.CookieName]
	if !ok {
		c.t.Fatal("no CSRF cookie: show a form first")
	}
	form.Set(csrf.FormField, token.Value)
	return c.do(http.MethodPost, target, form)
}

func (c *client) signIn(password, returnTo string) *httptest.ResponseRecorder {
	c.t.Helper()
	if page := c.do(http.MethodGet, htmlauth.SignInPath, nil); page.Code != http.StatusOK {
		c.t.Fatalf("GET %s = %d", htmlauth.SignInPath, page.Code)
	}
	form := url.Values{"tenant": {testTenant}, "email": {testEmail}, "password": {password}}
	if returnTo != "" {
		form.Set("return_to", returnTo)
	}
	return c.submit("/session", form)
}

func TestSignInPageKeepsOnlyLocalReturnPaths(t *testing.T) {
	t.Parallel()
	handler, _, _ := memoryPages(t)
	browser := newClient(t, handler)
	page := browser.do(http.MethodGet, "/session/new?tenant=acme&return_to=%2Fproducts%3Fpage%3D2", nil)
	body := page.Body.String()
	for _, want := range []string{`name="authenticity_token"`, `name="return_to" value="/products?page=2"`, `name="tenant" type="text" value="acme"`, `href="/passwords/new"`} {
		if page.Code != http.StatusOK || !strings.Contains(body, want) {
			t.Fatalf("status=%d, missing %q in:\n%s", page.Code, want, body)
		}
	}
	for _, hostile := range []string{"//evil.example/", "https://evil.example/", "/\\evil.example"} {
		page := browser.do(http.MethodGet, "/session/new?return_to="+url.QueryEscape(hostile), nil)
		if page.Code != http.StatusOK || strings.Contains(page.Body.String(), "evil.example") {
			t.Fatalf("return_to %q was kept: %s", hostile, page.Body)
		}
	}
}

// TestNoResetPagesWithoutRecovery: an application that cannot send reset
// emails (no recovery service) must not offer or mount the reset pages.
func TestNoResetPagesWithoutRecovery(t *testing.T) {
	t.Parallel()
	identity := newMemoryIdentity(t)
	login, err := auth.NewLoginService(identity, identity)
	if err != nil {
		t.Fatal(err)
	}
	browser, err := auth.NewBrowser(auth.BrowserOptions{Login: login, Sessions: identity})
	if err != nil {
		t.Fatal(err)
	}
	visitor := newClient(t, serve(t, browser, identity))
	if page := visitor.do(http.MethodGet, htmlauth.SignInPath, nil); page.Code != http.StatusOK || strings.Contains(page.Body.String(), "/passwords/new") {
		t.Fatalf("status=%d; the sign-in page must not link to a reset that cannot be sent:\n%s", page.Code, page.Body)
	}
	for _, path := range []string{"/passwords/new", "/passwords/edit?token=" + strings.Repeat("A", 43)} {
		if page := visitor.do(http.MethodGet, path, nil); page.Code != http.StatusNotFound {
			t.Errorf("GET %s without recovery: status=%d", path, page.Code)
		}
	}
	if request := visitor.submit("/passwords", url.Values{"tenant": {testTenant}, "email": {testEmail}}); request.Code != http.StatusNotFound && request.Code != http.StatusMethodNotAllowed {
		t.Errorf("POST /passwords without recovery: status=%d", request.Code)
	}
}

func TestSignInRedirectsOnlyToLocalPaths(t *testing.T) {
	t.Parallel()
	handler, identity, _ := memoryPages(t)
	for returnTo, location := range map[string]string{
		"/products?page=2":      "/products?page=2",
		"":                      htmlauth.AfterSignInPath,
		"//evil.example/":       htmlauth.AfterSignInPath,
		"https://evil.example/": htmlauth.AfterSignInPath,
	} {
		browser := newClient(t, handler)
		signedIn := browser.signIn(testPassword, returnTo)
		if signedIn.Code != http.StatusSeeOther || signedIn.Header().Get("Location") != location {
			t.Fatalf("return_to %q: status=%d Location=%q", returnTo, signedIn.Code, signedIn.Header().Get("Location"))
		}
		session, ok := browser.cookies[auth.SessionCookieName]
		if !ok || !session.HttpOnly || !session.Secure {
			t.Fatalf("session cookie=%+v", session)
		}
		token, err := auth.ParseToken(session.Value)
		if err != nil || !identity.hasSession(token.Digest()) {
			t.Fatalf("the session cookie does not name a stored session: %v", err)
		}
	}
}

func TestFailedSignInIsUniform(t *testing.T) {
	t.Parallel()
	handler, _, _ := memoryPages(t)
	for name, form := range map[string]url.Values{
		"wrong password":      {"tenant": {testTenant}, "email": {testEmail}, "password": {"wrong password"}},
		"unknown email":       {"tenant": {testTenant}, "email": {"nobody@example.com"}, "password": {testPassword}},
		"unknown tenant":      {"tenant": {"other"}, "email": {testEmail}, "password": {testPassword}},
		"invalid tenant slug": {"tenant": {"?"}, "email": {testEmail}, "password": {testPassword}},
	} {
		browser := newClient(t, handler)
		browser.do(http.MethodGet, htmlauth.SignInPath, nil)
		password := form.Get("password")
		failed := browser.submit("/session", form)
		body := failed.Body.String()
		if failed.Code != http.StatusUnprocessableEntity || !strings.Contains(body, "That organization, email and password do not match an account.") {
			t.Fatalf("%s: status=%d body:\n%s", name, failed.Code, body)
		}
		if strings.Contains(body, password) {
			t.Fatalf("%s: the password was echoed", name)
		}
		if _, ok := browser.cookies[auth.SessionCookieName]; ok {
			t.Fatalf("%s: a failed sign-in set a session cookie", name)
		}
	}
}

func TestSignInIsThrottled(t *testing.T) {
	t.Parallel()
	throttler, err := auth.NewMemoryLoginThrottler(auth.LoginThrottleConfig{Window: time.Minute, AccountLimit: 1, SourceLimit: 100, MaxEntries: 100})
	if err != nil {
		t.Fatal(err)
	}
	handler, _, _ := memoryPages(t, auth.WithLoginThrottler(throttler))
	browser := newClient(t, handler)
	if first := browser.signIn("wrong password", ""); first.Code != http.StatusUnprocessableEntity {
		t.Fatalf("first attempt status=%d", first.Code)
	}
	throttled := browser.signIn(testPassword, "")
	if throttled.Code != http.StatusTooManyRequests || throttled.Header().Get("Retry-After") == "" || !strings.Contains(throttled.Body.String(), "Too many sign-in attempts") {
		t.Fatalf("status=%d Retry-After=%q body:\n%s", throttled.Code, throttled.Header().Get("Retry-After"), throttled.Body)
	}
}

func TestFormsRequireTheCSRFToken(t *testing.T) {
	t.Parallel()
	handler, identity, _ := memoryPages(t)
	browser := newClient(t, handler)
	if signedIn := browser.signIn(testPassword, ""); signedIn.Code != http.StatusSeeOther {
		t.Fatalf("sign in status=%d", signedIn.Code)
	}
	for _, request := range []struct {
		target string
		form   url.Values
	}{
		{"/session", url.Values{"tenant": {testTenant}, "email": {testEmail}, "password": {testPassword}}},
		{"/session", url.Values{"_method": {"DELETE"}}},
		{"/passwords", url.Values{"tenant": {testTenant}, "email": {testEmail}}},
	} {
		if rejected := browser.do(http.MethodPost, request.target, request.form); rejected.Code != http.StatusForbidden {
			t.Errorf("POST %s %v without the token: status=%d", request.target, request.form, rejected.Code)
		}
	}
	if identity.sessionCount() != 1 {
		t.Fatalf("a sign-out without the token ended the session (sessions=%d)", identity.sessionCount())
	}
}

func TestSignOutEndsTheSession(t *testing.T) {
	t.Parallel()
	handler, identity, _ := memoryPages(t)
	browser := newClient(t, handler)
	browser.signIn(testPassword, "")
	signedOut := browser.submit("/session", url.Values{"_method": {"DELETE"}})
	if signedOut.Code != http.StatusSeeOther || signedOut.Header().Get("Location") != htmlauth.SignInPath {
		t.Fatalf("status=%d Location=%q", signedOut.Code, signedOut.Header().Get("Location"))
	}
	if _, ok := browser.cookies[auth.SessionCookieName]; ok || identity.sessionCount() != 0 {
		t.Fatalf("session still present: cookie=%v stored=%d", ok, identity.sessionCount())
	}
	if page := browser.do(http.MethodGet, htmlauth.SignInPath, nil); !strings.Contains(page.Body.String(), "Signed out.") {
		t.Fatalf("missing the sign-out notice:\n%s", page.Body)
	}
}

func TestPasswordResetDoesNotRevealAccounts(t *testing.T) {
	t.Parallel()
	handler, _, mail := memoryPages(t)
	requestReset := func(email string) *httptest.ResponseRecorder {
		browser := newClient(t, handler)
		browser.do(http.MethodGet, "/passwords/new", nil)
		return browser.submit("/passwords", url.Values{"tenant": {testTenant}, "email": {email}})
	}
	known, unknown := requestReset(testEmail), requestReset("nobody@example.com")
	if known.Code != http.StatusSeeOther || known.Code != unknown.Code || known.Header().Get("Location") != unknown.Header().Get("Location") ||
		known.Body.String() != unknown.Body.String() {
		t.Fatalf("known: %d %v; unknown: %d %v", known.Code, known.Header(), unknown.Code, unknown.Header())
	}
	// Only the known account gets mail, to the address as stored.
	messages := mail.delivered(t, 1)
	if messages[0].Email != storedEmail {
		t.Fatalf("delivered to %q, want the stored address %q", messages[0].Email, storedEmail)
	}
	token := messages[0].Token.Reveal()

	browser := newClient(t, handler)
	if invalid := browser.do(http.MethodGet, "/passwords/edit?token=forged", nil); invalid.Code != http.StatusSeeOther {
		t.Fatalf("forged link status=%d", invalid.Code)
	}
	edit := browser.do(http.MethodGet, "/passwords/edit?token="+token, nil)
	if edit.Code != http.StatusOK || edit.Header().Get("Cache-Control") != "no-store" || !strings.Contains(edit.Body.String(), `name="token" value="`+token+`"`) {
		t.Fatalf("edit status=%d headers=%v", edit.Code, edit.Header())
	}
	const newPassword = "a brand new passphrase"
	mismatch := browser.submit("/passwords", url.Values{"_method": {"PATCH"}, "token": {token}, "password": {newPassword}, "password_confirmation": {"something else"}})
	if mismatch.Code != http.StatusUnprocessableEntity || !strings.Contains(mismatch.Body.String(), "does not match") {
		t.Fatalf("mismatch status=%d", mismatch.Code)
	}
	reset := browser.submit("/passwords", url.Values{"_method": {"PATCH"}, "token": {token}, "password": {newPassword}, "password_confirmation": {newPassword}})
	if reset.Code != http.StatusSeeOther || reset.Header().Get("Location") != htmlauth.SignInPath {
		t.Fatalf("reset status=%d Location=%q", reset.Code, reset.Header().Get("Location"))
	}
	if again := newClient(t, handler).signIn(testPassword, ""); again.Code != http.StatusUnprocessableEntity {
		t.Fatalf("the old password still works: status=%d", again.Code)
	}
	if signedIn := newClient(t, handler).signIn(newPassword, ""); signedIn.Code != http.StatusSeeOther {
		t.Fatalf("the new password does not work: status=%d", signedIn.Code)
	}
}

// TestResetLinksGoToTheStoredAddressAndLookAlikesGetNothing: the identity
// store folds case like a database collation, so a look-alike spelling of the
// account's login would find it there. The pages refuse such logins before
// the store sees them, and a request that does name the account delivers to
// the stored address, never to what was typed.
func TestResetLinksGoToTheStoredAddressAndLookAlikesGetNothing(t *testing.T) {
	t.Parallel()
	handler, identity, mail := memoryPages(t)
	request := func(email string) {
		t.Helper()
		browser := newClient(t, handler)
		browser.do(http.MethodGet, "/passwords/new", nil)
		if answered := browser.submit("/passwords", url.Values{"tenant": {testTenant}, "email": {email}}); answered.Code != http.StatusSeeOther {
			t.Fatalf("%q: status=%d", email, answered.Code)
		}
	}
	for _, lookAlike := range []string{"\u212aim.owner@example.com", "kim.owner@\u0435xample.com", "kim.owner@example.com\u00a0.evil"} {
		request(lookAlike)
	}
	mail.none(t)
	identity.mu.Lock()
	pending := len(identity.resets)
	identity.mu.Unlock()
	if pending != 0 {
		t.Fatalf("%d reset tokens issued for look-alike logins", pending)
	}

	request("  KIM.OWNER@EXAMPLE.COM ")
	if messages := mail.delivered(t, 1); messages[0].Email != storedEmail {
		t.Fatalf("delivered to %q, want %q", messages[0].Email, storedEmail)
	}
}

// TestResetRequestsAnswerWithoutWaitingForDelivery: the page never answers in
// less than 100 ms, and what depends on the account (the lookup, the token,
// the mail) happens after it answered, so a slow mail server cannot tell
// anyone that the account exists.
func TestResetRequestsAnswerWithoutWaitingForDelivery(t *testing.T) {
	t.Parallel()
	handler, _, mail := memoryPages(t)
	t.Cleanup(mail.holdDeliveries())
	for name, email := range map[string]string{"known": testEmail, "unknown": "nobody@example.com", "malformed": "not an email"} {
		browser := newClient(t, handler)
		browser.do(http.MethodGet, "/passwords/new", nil)
		started := time.Now()
		answered := browser.submit("/passwords", url.Values{"tenant": {testTenant}, "email": {email}})
		elapsed := time.Since(started)
		if answered.Code != http.StatusSeeOther {
			t.Fatalf("%s: status=%d", name, answered.Code)
		}
		if elapsed < 100*time.Millisecond {
			t.Errorf("%s: answered in %v, before the 100 ms floor", name, elapsed)
		}
		if elapsed > 5*time.Second {
			t.Errorf("%s: answered in %v: the page waited for the account's delivery", name, elapsed)
		}
	}
	mail.delivered(t, 1) // the known account's mail is held, not lost
}

// TestSignInLooksTheStoreUpWhateverIsTyped: a malformed organization or login
// costs the same credential lookup as an unknown one, with identifiers the
// visitor did not choose, and a look-alike login never matches.
func TestSignInLooksTheStoreUpWhateverIsTyped(t *testing.T) {
	t.Parallel()
	handler, identity, _ := memoryPages(t)
	for name, form := range map[string]url.Values{
		"unknown tenant":          {"tenant": {"other"}, "email": {testEmail}, "password": {testPassword}},
		"malformed tenant":        {"tenant": {"../global"}, "email": {testEmail}, "password": {testPassword}},
		"look-alike tenant":       {"tenant": {"\u212aIMCO"}, "email": {testEmail}, "password": {testPassword}},
		"look-alike login":        {"tenant": {testTenant}, "email": {"\u212aim.owner@example.com"}, "password": {testPassword}},
		"non-ASCII domain login":  {"tenant": {testTenant}, "email": {"kim.owner@\u0435xample.com"}, "password": {testPassword}},
	} {
		identity.mu.Lock()
		identity.lookups = nil
		identity.mu.Unlock()
		browser := newClient(t, handler)
		browser.do(http.MethodGet, htmlauth.SignInPath, nil)
		failed := browser.submit("/session", form)
		if failed.Code != http.StatusUnprocessableEntity {
			t.Fatalf("%s: status=%d, want the uniform failure", name, failed.Code)
		}
		if _, ok := browser.cookies[auth.SessionCookieName]; ok {
			t.Fatalf("%s: a session was created", name)
		}
		identity.mu.Lock()
		lookups := identity.lookups
		identity.mu.Unlock()
		if len(lookups) != 1 {
			t.Fatalf("%s: %d credential lookups, want 1", name, len(lookups))
		}
		if name != "unknown tenant" && strings.Contains(lookups[0], testEmail) {
			t.Fatalf("%s: looked up the typed login: %q", name, lookups[0])
		}
	}
}

// TestLetterCaseAndUnicodeVariantsDoNotGetFreshGuesses: every spelling of one
// login shares one throttle budget, and a look-alike that the store would
// fold onto the account cannot be used to guess its password.
func TestLetterCaseAndUnicodeVariantsDoNotGetFreshGuesses(t *testing.T) {
	t.Parallel()
	throttler, err := auth.NewMemoryLoginThrottler(auth.LoginThrottleConfig{Window: time.Minute, PairLimit: 2, AccountLimit: 10, SourceLimit: 100, MaxEntries: 100})
	if err != nil {
		t.Fatal(err)
	}
	handler, _, _ := memoryPages(t, auth.WithLoginThrottler(throttler))
	attempt := func(email string) *httptest.ResponseRecorder {
		browser := newClient(t, handler)
		browser.do(http.MethodGet, htmlauth.SignInPath, nil)
		return browser.submit("/session", url.Values{"tenant": {testTenant}, "email": {email}, "password": {"wrong password"}})
	}
	for _, email := range []string{"KIM.OWNER@example.com", " Kim.Owner@EXAMPLE.com "} {
		if failed := attempt(email); failed.Code != http.StatusUnprocessableEntity {
			t.Fatalf("%q: status=%d", email, failed.Code)
		}
	}
	if throttled := attempt("kim.owner@example.com"); throttled.Code != http.StatusTooManyRequests {
		t.Fatalf("a third spelling of one login got a fresh guess: status=%d", throttled.Code)
	}
	signedIn := newClient(t, handler)
	signedIn.do(http.MethodGet, htmlauth.SignInPath, nil)
	lookAlike := signedIn.submit("/session", url.Values{"tenant": {testTenant}, "email": {"\u212aim.owner@example.com"}, "password": {testPassword}})
	if lookAlike.Code == http.StatusSeeOther {
		t.Fatal("a look-alike login signed in as the account")
	}
}

// TestUnknownResetTokensAreRefusedBeforeHashing: a token that was never
// issued ends the reset before the (expensive) hash of the submitted
// password, so it cannot be used to make the server compute hashes. A
// password the hash would reject shows which step answered: the invalid link,
// not the password error.
func TestUnknownResetTokensAreRefusedBeforeHashing(t *testing.T) {
	t.Parallel()
	handler, identity, _ := memoryPages(t)
	unknown, err := auth.NewRecoveryToken()
	if err != nil {
		t.Fatal(err)
	}
	browser := newClient(t, handler)
	browser.do(http.MethodGet, "/passwords/edit?token="+unknown.Reveal(), nil)
	oversized := strings.Repeat("x", 5000)
	refused := browser.submit("/passwords", url.Values{"_method": {"PATCH"}, "token": {unknown.Reveal()}, "password": {oversized}, "password_confirmation": {oversized}})
	if refused.Code != http.StatusSeeOther || refused.Header().Get("Location") != "/passwords/new" {
		t.Fatalf("status=%d Location=%q, want the invalid-link redirect", refused.Code, refused.Header().Get("Location"))
	}
	identity.mu.Lock()
	checks, consumes := identity.tokenChecks, identity.consumes
	identity.mu.Unlock()
	if checks != 1 || consumes != 0 {
		t.Fatalf("token checks=%d consumes=%d, want the token checked and nothing consumed", checks, consumes)
	}
}

// TestPagesAgainstTheIdentityStore signs in and out through the real
// identity store of this application's database.
func TestPagesAgainstTheIdentityStore(t *testing.T) {
{{- if eq .DB.Adapter "postgres"}}
	database := postgrestest.NewRLS(t, authpostgres.Migrations()).Runtime // as the application serves
{{- else}}
	database := {{.DB.TestPackage}}.NewMigrated(t, auth{{.DB.Adapter}}.Migrations())
{{- end}}
	repository, err := auth{{.DB.Adapter}}.New(database)
	if err != nil {
		t.Fatal(err)
	}
	ctx := context.Background()
	if _, err := repository.ProvisionOwner(ctx, auth{{.DB.Adapter}}.OwnerAccount{
		Organization: "Acme", TenantSlug: testTenant, Email: testEmail, Password: testPassword,
	}); err != nil {
		t.Fatal(err)
	}
	login, err := auth.NewLoginService(repository, repository, auth.WithSecurityAuditor(repository))
	if err != nil {
		t.Fatal(err)
	}
	browser, err := auth.NewBrowser(auth.BrowserOptions{Login: login, Sessions: repository, Auditor: repository})
	if err != nil {
		t.Fatal(err)
	}
	visitor := newClient(t, serve(t, browser, repository))
	if failed := visitor.signIn("wrong password", ""); failed.Code != http.StatusUnprocessableEntity {
		t.Fatalf("wrong password status=%d", failed.Code)
	}
	if signedIn := visitor.signIn(testPassword, "/products"); signedIn.Code != http.StatusSeeOther || signedIn.Header().Get("Location") != "/products" {
		t.Fatalf("sign in status=%d Location=%q", signedIn.Code, signedIn.Header().Get("Location"))
	}
	token, err := auth.ParseToken(visitor.cookies[auth.SessionCookieName].Value)
	if err != nil {
		t.Fatal(err)
	}
	if _, found, err := repository.ResolveSession(ctx, token.Digest()); err != nil || !found {
		t.Fatalf("the new session does not resolve: found=%v err=%v", found, err)
	}
	if signedOut := visitor.submit("/session", url.Values{"_method": {"DELETE"}}); signedOut.Code != http.StatusSeeOther {
		t.Fatalf("sign out status=%d", signedOut.Code)
	}
	if _, found, err := repository.ResolveSession(ctx, token.Digest()); err != nil || found {
		t.Fatalf("the session survived sign-out: found=%v err=%v", found, err)
	}
}


// TestSingleOrganizationFormsAskForTheEmailOnly: in an application without
// organizations (forge new --auth) the forms have no organization field, and
// a sign-in with the email and password reaches the one organization.
func TestSingleOrganizationFormsAskForTheEmailOnly(t *testing.T) {
	identity := newMemoryIdentity(t)
	login, err := auth.NewLoginService(identity, identity, auth.WithSingleTenant(testTenant))
	if err != nil {
		t.Fatal(err)
	}
	browser, err := auth.NewBrowser(auth.BrowserOptions{Login: login, Sessions: identity})
	if err != nil {
		t.Fatal(err)
	}
	visitor := newClient(t, serve(t, browser, identity, htmlauth.WithOrganizations(false)))
	page := visitor.do(http.MethodGet, htmlauth.SignInPath, nil)
	if page.Code != http.StatusOK || strings.Contains(page.Body.String(), `name="tenant"`) {
		t.Fatalf("the sign-in page asks for an organization:\n%s", page.Body.String())
	}
	failed := visitor.submit("/session", url.Values{"email": {testEmail}, "password": {"wrong password!!"}})
	if failed.Code != http.StatusUnprocessableEntity || strings.Contains(failed.Body.String(), "organization") {
		t.Fatalf("wrong password status=%d:\n%s", failed.Code, failed.Body.String())
	}
	signedIn := visitor.submit("/session", url.Values{"email": {testEmail}, "password": {testPassword}})
	if signedIn.Code != http.StatusSeeOther {
		t.Fatalf("sign in status=%d:\n%s", signedIn.Code, signedIn.Body.String())
	}
	if _, err := auth.ParseToken(visitor.cookies[auth.SessionCookieName].Value); err != nil {
		t.Fatalf("no session cookie: %v", err)
	}
	// A posted organization is ignored: the sign-in still goes to the one
	// organization, never to the one named.
	other := newClient(t, serve(t, browser, identity, htmlauth.WithOrganizations(false)))
	other.do(http.MethodGet, htmlauth.SignInPath, nil)
	if posted := other.submit("/session", url.Values{"tenant": {"another-org"}, "email": {testEmail}, "password": {testPassword}}); posted.Code != http.StatusSeeOther {
		t.Fatalf("posting another organization: status=%d:\n%s", posted.Code, posted.Body.String())
	}
}
