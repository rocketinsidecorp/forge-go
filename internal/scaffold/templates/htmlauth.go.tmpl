// Package htmlauth serves {{.Name}}'s sign-in, sign-out, two-factor and
// password-reset pages, generated by Forge like Rails' authentication
// generator. It decodes the forms, chooses the messages (translated from
// config/locales for the request's locale) and renders app/views/sessions,
// app/views/passwords and app/views/mfa. Every security decision (CSRF
// verification, credential checks, step-up re-authentication, throttling,
// uniform failures, cookies) is made by auth.Browser in the framework, so
// change the pages and the wording freely, but keep calling Browser for
// anything that signs in, signs out, changes a password or changes a second
// factor.
//
//	| Method | Path                    | Page                                                         |
//	| ------ | ----------------------- | ------------------------------------------------------------ |
//	| GET    | /session/new            | sign-in form: organization (tenant slug), email, password    |
//	| POST   | /session                | sign in: 303, 422 on any wrong field, 429 when throttled     |
//	| DELETE | /session                | sign out                                                     |
//	| GET    | /session/mfa            | the code step of a sign-in (with FORGE_AUTH_MFA_KEY)         |
//	| POST   | /session/mfa            | checks the code: 303, 422 wrong code, 429 throttled          |
//	| GET    | /mfa                    | two-factor settings of the signed-in account                 |
//	| POST   | /mfa                    | turn on (password): shows the key to add                     |
//	| POST   | /mfa/confirm            | password and a code of the new key: backup codes, once       |
//	| POST   | /mfa/rotation           | replace the authenticator (password and current code)        |
//	| POST   | /mfa/rotation/confirm   | password, current code and a code of the new key             |
//	| POST   | /mfa/backup_codes       | new backup codes (password and current code)                 |
//	| DELETE | /mfa                    | turn off (password and current code); signs out everywhere   |
//	| GET    | /passwords/new          | asks which account forgot its password (with outgoing mail)  |
//	| POST   | /passwords              | sends reset instructions; the same answer for every account  |
//	| GET    | /passwords/edit?token=  | the page a reset link opens                                  |
//	| PATCH  | /passwords              | sets the new password and signs every session out            |
//
// Every two-factor change asks for the password again, and every change to
// an existing factor for a current code too, also when confirming a new key:
// a stolen session alone can neither see a pending key nor guess its code.
// Turning two-factor on, replacing it and turning it off sign the account
// out everywhere. Keys and backup codes appear only on no-store pages.
package htmlauth

import (
	"errors"
	"html/template"
	"net/http"
	"net/url"
	"time"
	"unicode/utf8"

	"github.com/rocketinsidecorp/forge-go/auth"
	"github.com/rocketinsidecorp/forge-go/i18n"
	"github.com/rocketinsidecorp/forge-go/views"
	"github.com/rocketinsidecorp/forge-go/web"
)

const (
	// SignInPath is the sign-in page. Protected pages redirect signed-out
	// browsers here (auth.Middleware.AuthenticateBrowser).
	SignInPath = "/session/new"
	// AfterSignInPath is where a sign-in without a valid return path lands.
	AfterSignInPath = "/"

	// MFASettingsPath is the two-factor settings page of the signed-in
	// account.
	MFASettingsPath = "/mfa"

	mfaPath         = "/session/mfa"
	newPasswordPath = "/passwords/new"

	// mfaIssuer names this application in authenticator apps.
	mfaIssuer = "{{.Name}}"

	// minimumPasswordLength is the shortest new password the reset form
	// accepts. It matches the owner password `{{.Name}} setup` requires.
	minimumPasswordLength = 12
)

// Router is where Register mounts the pages; *forge.App satisfies it.
type Router interface {
	Handle(pattern string, handler http.Handler) error
}

// Register mounts the pages. The routes need web.MethodOverride,
// csrf.Protection and web.Flash in front of them (app/bootstrap installs
// them); without a verified CSRF token Browser refuses to sign anyone in or
// out. The sign-in code step exists only when Browser has an MFA service,
// and password-reset routes only when it has a recovery service. The
// two-factor settings (/mfa) sit behind sessions.AuthenticateBrowser and say
// so when two-factor authentication is not configured.
func Register(routes Router, browser *auth.Browser, renderer *views.Renderer, sessions *auth.Middleware) error {
	if routes == nil || browser == nil || renderer == nil || sessions == nil {
		return errors.New("htmlauth: router, browser, view renderer and session middleware are required")
	}
	pages := pages{browser: browser, renderer: renderer}
	// Literal patterns let `forge routes` list these routes.
	if err := routes.Handle("GET /session/new", http.HandlerFunc(pages.newSession)); err != nil {
		return err
	}
	if err := routes.Handle("POST /session", http.HandlerFunc(pages.createSession)); err != nil {
		return err
	}
	if err := routes.Handle("DELETE /session", http.HandlerFunc(pages.destroySession)); err != nil {
		return err
	}
	if browser.MFAEnabled() {
		if err := routes.Handle("GET /session/mfa", http.HandlerFunc(pages.newMFA)); err != nil {
			return err
		}
		if err := routes.Handle("POST /session/mfa", http.HandlerFunc(pages.createMFA)); err != nil {
			return err
		}
	}
	// The two-factor settings need a signed-in account: signed-out browsers
	// go to the sign-in page.
	signedIn := func(handler http.HandlerFunc) http.Handler {
		guarded, err := sessions.AuthenticateBrowser(SignInPath, handler)
		if err != nil {
			// SignInPath is a constant local path, so this does not happen;
			// if it did, the page fails closed.
			return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { web.Error(w, r, err) })
		}
		return guarded
	}
	if err := routes.Handle("GET /mfa", signedIn(pages.showMFA)); err != nil {
		return err
	}
	if err := routes.Handle("POST /mfa", signedIn(pages.enableMFA)); err != nil {
		return err
	}
	if err := routes.Handle("POST /mfa/confirm", signedIn(pages.confirmMFA)); err != nil {
		return err
	}
	if err := routes.Handle("POST /mfa/rotation", signedIn(pages.rotateMFA)); err != nil {
		return err
	}
	if err := routes.Handle("POST /mfa/rotation/confirm", signedIn(pages.confirmMFARotation)); err != nil {
		return err
	}
	if err := routes.Handle("POST /mfa/backup_codes", signedIn(pages.regenerateBackupCodes)); err != nil {
		return err
	}
	if err := routes.Handle("DELETE /mfa", signedIn(pages.disableMFA)); err != nil {
		return err
	}
	if browser.RecoveryEnabled() {
		if err := routes.Handle("GET /passwords/new", http.HandlerFunc(pages.newPassword)); err != nil {
			return err
		}
		if err := routes.Handle("POST /passwords", http.HandlerFunc(pages.createPassword)); err != nil {
			return err
		}
		if err := routes.Handle("GET /passwords/edit", http.HandlerFunc(pages.editPassword)); err != nil {
			return err
		}
		if err := routes.Handle("PATCH /passwords", http.HandlerFunc(pages.updatePassword)); err != nil {
			return err
		}
	}
	return nil
}

type pages struct {
	browser  *auth.Browser
	renderer *views.Renderer
}

// sessionPage is the data of sessions/new. It never carries the password.
type sessionPage struct {
	Tenant          string
	Email           string
	ReturnTo        string
	Error           string
	RecoveryEnabled bool
}

// mfaPage is the data of sessions/mfa.
type mfaPage struct {
	ReturnTo string
	Error    string
}

// mfaSettingsPage is the data of mfa/show.
type mfaSettingsPage struct {
	Available bool
	Enabled   bool
	Remaining int
	Error     string
}

// mfaKeyPage is the data of mfa/new: the key of a pending enrollment or
// rotation. It is a credential: shown only after re-authentication, on a
// no-store page, never logged.
type mfaKeyPage struct {
	Rotation bool
	Key      string
	URI      template.URL
	Error    string
}

// backupCodesPage is the data of mfa/backup_codes, shown once.
type backupCodesPage struct {
	Codes     []string
	SignedOut bool
}

// passwordRequestPage is the data of passwords/new.
type passwordRequestPage struct {
	Tenant string
	Email  string
	Error  string
}

// passwordResetPage is the data of passwords/edit.
type passwordResetPage struct {
	Token  string
	Error  string
	Errors web.FormErrors
}

type signInForm struct {
	Tenant   string `form:"tenant"`
	Email    string `form:"email"`
	Password string `form:"password"`
	ReturnTo string `form:"return_to"`
}

type mfaForm struct {
	Code     string `form:"code"`
	ReturnTo string `form:"return_to"`
}

// stepUpForm re-authenticates a two-factor change. Code is a current
// authenticator or backup code; on the confirmation of a rotation the
// current code is CurrentCode and Code is a code of the new key.
type stepUpForm struct {
	Password    string `form:"password"`
	Code        string `form:"code"`
	CurrentCode string `form:"current_code"`
}

type passwordRequestForm struct {
	Tenant string `form:"tenant"`
	Email  string `form:"email"`
}

type passwordResetForm struct {
	Token                string `form:"token"`
	Password             string `form:"password"`
	PasswordConfirmation string `form:"password_confirmation"`
}

// newSession shows the sign-in form. ?tenant= pre-fills the organization and
// ?return_to= (set by AuthenticateBrowser) is kept only when it is a local
// path.
func (p pages) newSession(w http.ResponseWriter, r *http.Request) {
	query := r.URL.Query()
	p.render(w, r, "sessions/new", http.StatusOK, sessionPage{
		Tenant:          query.Get("tenant"),
		ReturnTo:        auth.ReturnPath(query.Get(auth.ReturnToParameter), ""),
		RecoveryEnabled: p.browser.RecoveryEnabled(),
	})
}

// createSession signs in. Success goes to the return path (or
// AfterSignInPath) with a notice; an account with a second factor goes to
// the code form first. Any wrong field shows the same message at 422.
func (p pages) createSession(w http.ResponseWriter, r *http.Request) {
	var form signInForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	page := sessionPage{
		Tenant:          form.Tenant,
		Email:           form.Email,
		ReturnTo:        auth.ReturnPath(form.ReturnTo, ""),
		RecoveryEnabled: p.browser.RecoveryEnabled(),
	}
	step, err := p.browser.SignIn(w, r, auth.SignInCredentials{Email: form.Email, Password: form.Password, Tenant: form.Tenant})
	var throttled *auth.LoginThrottledError
	switch {
	case errors.As(err, &throttled):
		page.Error = i18n.T(r.Context(), "throttled.sign_in", "count", retryMinutes(throttled.RetryAfter))
		p.render(w, r, "sessions/new", http.StatusTooManyRequests, page)
	case errors.Is(err, auth.ErrCredentialsInvalid):
		// The only message a failed sign-in shows: it must not say whether
		// the organization, the email or the password was wrong.
		page.Error = i18n.T(r.Context(), "sessions.invalid_credentials")
		p.render(w, r, "sessions/new", http.StatusUnprocessableEntity, page)
	case err != nil:
		web.Error(w, r, err)
	case step == auth.SignInNeedsMFA:
		redirect(w, r, withReturnTo(mfaPath, page.ReturnTo), "", "")
	default:
		redirect(w, r, auth.ReturnPath(form.ReturnTo, AfterSignInPath), web.FlashNotice, i18n.T(r.Context(), "sessions.signed_in"))
	}
}

// destroySession signs out: the form posts _method=DELETE with the CSRF token.
func (p pages) destroySession(w http.ResponseWriter, r *http.Request) {
	if err := p.browser.SignOut(w, r); err != nil {
		web.Error(w, r, err)
		return
	}
	redirect(w, r, SignInPath, web.FlashNotice, i18n.T(r.Context(), "sessions.signed_out"))
}

// newMFA shows the code form while a password step is pending.
func (p pages) newMFA(w http.ResponseWriter, r *http.Request) {
	if !p.browser.MFAPending(r) {
		redirect(w, r, SignInPath, web.FlashAlert, i18n.T(r.Context(), "sessions.sign_in_to_continue"))
		return
	}
	p.render(w, r, "sessions/mfa", http.StatusOK, mfaPage{
		ReturnTo: auth.ReturnPath(r.URL.Query().Get(auth.ReturnToParameter), ""),
	})
}

// createMFA checks an authenticator or backup code.
func (p pages) createMFA(w http.ResponseWriter, r *http.Request) {
	var form mfaForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	page := mfaPage{ReturnTo: auth.ReturnPath(form.ReturnTo, "")}
	err := p.browser.CompleteMFA(w, r, form.Code)
	var throttled *auth.LoginThrottledError
	switch {
	case errors.As(err, &throttled):
		page.Error = i18n.T(r.Context(), "throttled.code", "count", retryMinutes(throttled.RetryAfter))
		p.render(w, r, "sessions/mfa", http.StatusTooManyRequests, page)
	case errors.Is(err, auth.ErrMFAChallengeMissing):
		redirect(w, r, SignInPath, web.FlashAlert, i18n.T(r.Context(), "sessions.expired"))
	case errors.Is(err, auth.ErrMFAInvalid):
		page.Error = i18n.T(r.Context(), "sessions.invalid_code")
		p.render(w, r, "sessions/mfa", http.StatusUnprocessableEntity, page)
	case err != nil:
		web.Error(w, r, err)
	default:
		redirect(w, r, auth.ReturnPath(form.ReturnTo, AfterSignInPath), web.FlashNotice, i18n.T(r.Context(), "sessions.signed_in"))
	}
}

// showMFA shows the two-factor settings of the signed-in account.
func (p pages) showMFA(w http.ResponseWriter, r *http.Request) {
	p.renderMFASettings(w, r, http.StatusOK, "")
}

// enableMFA starts turning two-factor authentication on after the password,
// and shows the new key.
func (p pages) enableMFA(w http.ResponseWriter, r *http.Request) {
	var form stepUpForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	enrollment, err := p.browser.BeginMFAEnrollment(w, r, mfaIssuer, auth.MFAStepUp{Password: form.Password})
	if err != nil {
		p.mfaChangeFailed(w, r, err, false)
		return
	}
	p.renderMFAKey(w, r, http.StatusOK, enrollment, false, "")
}

// confirmMFA turns two-factor authentication on: the password again and a
// code of the new key. Every session of the account ends; the backup codes
// show once.
func (p pages) confirmMFA(w http.ResponseWriter, r *http.Request) {
	var form stepUpForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	codes, err := p.browser.ConfirmMFAEnrollment(w, r, mfaIssuer, auth.MFAStepUp{Password: form.Password}, form.Code)
	if err != nil {
		p.mfaChangeFailed(w, r, err, false)
		return
	}
	p.renderBackupCodes(w, r, codes, true)
}

// rotateMFA starts replacing the authenticator after the password and a
// current code; the old one keeps working until the new one is confirmed.
func (p pages) rotateMFA(w http.ResponseWriter, r *http.Request) {
	var form stepUpForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	enrollment, err := p.browser.BeginMFARotation(w, r, mfaIssuer, auth.MFAStepUp{Password: form.Password, Code: form.Code})
	if err != nil {
		p.mfaChangeFailed(w, r, err, true)
		return
	}
	p.renderMFAKey(w, r, http.StatusOK, enrollment, true, "")
}

// confirmMFARotation replaces the authenticator: the password, a current
// code of the old one and a code of the new key. Every session ends; the
// new backup codes show once.
func (p pages) confirmMFARotation(w http.ResponseWriter, r *http.Request) {
	var form stepUpForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	codes, err := p.browser.ConfirmMFARotation(w, r, mfaIssuer, auth.MFAStepUp{Password: form.Password, Code: form.CurrentCode}, form.Code)
	if err != nil {
		p.mfaChangeFailed(w, r, err, true)
		return
	}
	p.renderBackupCodes(w, r, codes, true)
}

// regenerateBackupCodes replaces the backup codes after the password and a
// current code; the old ones stop working.
func (p pages) regenerateBackupCodes(w http.ResponseWriter, r *http.Request) {
	var form stepUpForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	codes, err := p.browser.RegenerateMFABackupCodes(w, r, auth.MFAStepUp{Password: form.Password, Code: form.Code})
	if err != nil {
		p.mfaChangeFailed(w, r, err, false)
		return
	}
	p.renderBackupCodes(w, r, codes, false)
}

// disableMFA turns two-factor authentication off after the password and a
// current code. Every session of the account ends.
func (p pages) disableMFA(w http.ResponseWriter, r *http.Request) {
	var form stepUpForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	if err := p.browser.DisableMFA(w, r, auth.MFAStepUp{Password: form.Password, Code: form.Code}); err != nil {
		p.mfaChangeFailed(w, r, err, false)
		return
	}
	redirect(w, r, SignInPath, web.FlashNotice, i18n.T(r.Context(), "mfa.disabled"))
}

// mfaChangeFailed answers a refused two-factor change. A wrong password or
// code shows the settings again with one message (422, 429 when
// throttled); only a right password (and current code) with a wrong code of
// the new key shows the pending key again.
func (p pages) mfaChangeFailed(w http.ResponseWriter, r *http.Request, err error, rotation bool) {
	var (
		throttled *auth.LoginThrottledError
		pending   *auth.MFAPendingCodeError
	)
	ctx := r.Context()
	switch {
	case errors.As(err, &throttled):
		p.renderMFASettings(w, r, http.StatusTooManyRequests, i18n.T(ctx, "throttled.code", "count", retryMinutes(throttled.RetryAfter)))
	case errors.Is(err, auth.ErrMFAStepUpInvalid):
		p.renderMFASettings(w, r, http.StatusUnprocessableEntity, i18n.T(ctx, "mfa.errors.step_up"))
	case errors.As(err, &pending):
		p.renderMFAKey(w, r, http.StatusUnprocessableEntity, pending.Enrollment, rotation, i18n.T(ctx, "mfa.errors.invalid_code"))
	case errors.Is(err, auth.ErrMFAEnrollmentInvalid):
		redirect(w, r, MFASettingsPath, web.FlashAlert, i18n.T(ctx, "mfa.errors.expired"))
	case errors.Is(err, auth.ErrMFAAlreadyEnabled), errors.Is(err, auth.ErrMFANotEnabled):
		redirect(w, r, MFASettingsPath, web.FlashAlert, i18n.T(ctx, "mfa.errors.changed"))
	case errors.Is(err, auth.ErrMFAUnavailable):
		redirect(w, r, MFASettingsPath, web.FlashAlert, i18n.T(ctx, "mfa.show.unavailable"))
	default:
		web.Error(w, r, err)
	}
}

func (p pages) renderMFASettings(w http.ResponseWriter, r *http.Request, status int, message string) {
	page := mfaSettingsPage{Available: p.browser.MFASettingsAvailable(), Error: message}
	if page.Available {
		state, err := p.browser.MFAStatus(r)
		if err != nil {
			web.Error(w, r, err)
			return
		}
		page.Enabled, page.Remaining = state.Enabled, state.BackupCodesRemaining
	}
	p.render(w, r, "mfa/show", status, page)
}

func (p pages) renderMFAKey(w http.ResponseWriter, r *http.Request, status int, enrollment auth.TOTPEnrollment, rotation bool, message string) {
	w.Header().Set("Cache-Control", "no-store")
	p.render(w, r, "mfa/new", status, mfaKeyPage{
		Rotation: rotation,
		Key:      enrollment.Secret.Reveal(),
		// html/template drops URLs with schemes other than http(s) and
		// mailto; this otpauth:// URI is built by Forge with every part
		// escaped, so it is marked safe.
		URI:   template.URL(enrollment.ProvisioningURI.Reveal()), // #nosec G203 -- Forge-built otpauth URI with escaped components
		Error: message,
	})
}

func (p pages) renderBackupCodes(w http.ResponseWriter, r *http.Request, codes []auth.MFABackupCode, signedOut bool) {
	w.Header().Set("Cache-Control", "no-store")
	page := backupCodesPage{SignedOut: signedOut, Codes: make([]string, 0, len(codes))}
	for _, code := range codes {
		page.Codes = append(page.Codes, code.Reveal())
	}
	p.render(w, r, "mfa/backup_codes", http.StatusOK, page)
}

// newPassword asks for the account whose password was forgotten.
func (p pages) newPassword(w http.ResponseWriter, r *http.Request) {
	p.render(w, r, "passwords/new", http.StatusOK, passwordRequestPage{Tenant: r.URL.Query().Get("tenant")})
}

// createPassword sends reset instructions. Every outcome but throttling looks
// the same, so the form cannot tell anyone whether an account exists.
func (p pages) createPassword(w http.ResponseWriter, r *http.Request) {
	var form passwordRequestForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	err := p.browser.RequestPasswordReset(w, r, form.Email, form.Tenant)
	var throttled *auth.RecoveryThrottledError
	switch {
	case errors.As(err, &throttled):
		p.render(w, r, "passwords/new", http.StatusTooManyRequests, passwordRequestPage{
			Tenant: form.Tenant, Email: form.Email, Error: i18n.T(r.Context(), "throttled.reset", "count", retryMinutes(throttled.RetryAfter)),
		})
	case err != nil:
		web.Error(w, r, err)
	default:
		redirect(w, r, SignInPath, web.FlashNotice, i18n.T(r.Context(), "passwords.reset_requested"))
	}
}

// editPassword is the page the reset email links to (?token=...). The token
// moves into the form; the page is never cached, and Forge sends
// Referrer-Policy: no-referrer, so the link does not leak through Referer.
func (p pages) editPassword(w http.ResponseWriter, r *http.Request) {
	token := r.URL.Query().Get("token")
	if _, err := auth.ParseRecoveryToken(token); err != nil {
		redirect(w, r, newPasswordPath, web.FlashAlert, i18n.T(r.Context(), "passwords.invalid_link"))
		return
	}
	w.Header().Set("Cache-Control", "no-store")
	p.render(w, r, "passwords/edit", http.StatusOK, passwordResetPage{Token: token})
}

// updatePassword sets the new password. Success signs every session of the
// account out and sends the user to sign in again.
func (p pages) updatePassword(w http.ResponseWriter, r *http.Request) {
	var form passwordResetForm
	if err := web.DecodeForm(r, &form); err != nil {
		web.Error(w, r, err)
		return
	}
	w.Header().Set("Cache-Control", "no-store")
	page := passwordResetPage{Token: form.Token}
	if utf8.RuneCountInString(form.Password) < minimumPasswordLength {
		page.Errors.Add("password", "too_short", i18n.T(r.Context(), "passwords.errors.too_short", "count", minimumPasswordLength))
	}
	if form.PasswordConfirmation != form.Password {
		page.Errors.Add("password_confirmation", "mismatch", i18n.T(r.Context(), "passwords.errors.mismatch"))
	}
	if len(page.Errors) > 0 {
		p.render(w, r, "passwords/edit", http.StatusUnprocessableEntity, page)
		return
	}
	err := p.browser.ResetPassword(w, r, form.Token, form.Password)
	var throttled *auth.RecoveryThrottledError
	switch {
	case errors.As(err, &throttled):
		page.Error = i18n.T(r.Context(), "throttled.reset", "count", retryMinutes(throttled.RetryAfter))
		p.render(w, r, "passwords/edit", http.StatusTooManyRequests, page)
	case errors.Is(err, auth.ErrRecoveryInvalid):
		redirect(w, r, newPasswordPath, web.FlashAlert, i18n.T(r.Context(), "passwords.invalid_link"))
	case errors.Is(err, auth.ErrPasswordInvalid):
		page.Errors.Add("password", "invalid", i18n.T(r.Context(), "passwords.errors.invalid"))
		p.render(w, r, "passwords/edit", http.StatusUnprocessableEntity, page)
	case err != nil:
		web.Error(w, r, err)
	default:
		redirect(w, r, SignInPath, web.FlashNotice, i18n.T(r.Context(), "passwords.changed"))
	}
}

func (p pages) render(w http.ResponseWriter, r *http.Request, page string, status int, data any) {
	if err := p.renderer.RenderRequest(w, r, page, status, data); err != nil {
		web.Error(w, r, err)
	}
}

// redirect answers 303 See Other to a local target, with a flash message
// when kind is set.
func redirect(w http.ResponseWriter, r *http.Request, target string, kind web.FlashKind, message string) {
	if kind != "" {
		if err := web.SetFlash(w, r, kind, message); err != nil {
			web.Error(w, r, err)
			return
		}
	}
	if err := web.Redirect(w, target); err != nil {
		web.Error(w, r, err)
	}
}

// withReturnTo adds a validated return path to target.
func withReturnTo(target, returnTo string) string {
	if returnTo == "" {
		return target
	}
	return target + "?" + url.Values{auth.ReturnToParameter: {returnTo}}.Encode()
}

// retryMinutes is the wait a throttled form announces, in whole minutes
// (the throttled.* translations choose their plural form by it); the
// response also carries Retry-After.
func retryMinutes(retryAfter time.Duration) int {
	return max(int((retryAfter+time.Minute-1)/time.Minute), 1)
}
