{{define "title"}}Sign in{{end}}
{{define "content"}}
<h1>Sign in</h1>
{{with .Error}}<p class="flash flash-alert" role="alert">{{.}}</p>{{end}}
<form method="post" action="/session" class="auth-form">
	{{csrfField}}
	{{with .ReturnTo}}<input type="hidden" name="return_to" value="{{.}}">{{end}}
	<p>
		<label for="tenant">Organization</label>
		<input id="tenant" name="tenant" type="text" value="{{.Tenant}}" required maxlength="63" autocapitalize="none" spellcheck="false" aria-describedby="tenant-hint">
		<small id="tenant-hint">The short name of your organization, such as <code>acme</code>.</small>
	</p>
	<p>
		<label for="email">Email</label>
		<input id="email" name="email" type="email" value="{{.Email}}" required maxlength="320" autocomplete="username">
	</p>
	<p>
		<label for="password">Password</label>
		<input id="password" name="password" type="password" required maxlength="4096" autocomplete="current-password">
	</p>
	<p><button type="submit">Sign in</button></p>
</form>
{{if .RecoveryEnabled}}<p><a href="/passwords/new">Forgot your password?</a></p>{{end}}
{{end}}
