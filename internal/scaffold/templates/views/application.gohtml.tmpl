<!doctype html>
<html lang="{{locale}}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{block "title" .}}[[.Name]]{{end}}</title>
	{{csrfMeta}}
	{{stylesheetTag "application"}}
	{{javascriptImportmapTags "application"}}
</head>
<body>
	<a class="skip-link" href="#main">{{t "layout.skip_to_content"}}</a>
	<main id="main">
		{{template "shared/_flash" .}}
		{{block "content" .}}{{end}}
	</main>
</body>
</html>
