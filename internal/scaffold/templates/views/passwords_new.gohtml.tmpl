{{define "title"}}Forgot your password?{{end}}
{{define "content"}}
<h1>Forgot your password?</h1>
{{with .Error}}<p class="flash flash-alert" role="alert">{{.}}</p>{{end}}
<p>Enter your organization and email. If they match an account, we send a link to choose a new password.</p>
<form method="post" action="/passwords" class="auth-form">
	{{csrfField}}
	<p>
		<label for="tenant">Organization</label>
		<input id="tenant" name="tenant" type="text" value="{{.Tenant}}" required maxlength="63" autocapitalize="none" spellcheck="false">
	</p>
	<p>
		<label for="email">Email</label>
		<input id="email" name="email" type="email" value="{{.Email}}" required maxlength="320" autocomplete="username">
	</p>
	<p><button type="submit">Email me a reset link</button></p>
</form>
<p><a href="/session/new">Back to sign in</a></p>
{{end}}
