{{define "title"}}{{t "passwords.new.title"}}{{end}}
{{define "content"}}
<h1>{{t "passwords.new.title"}}</h1>
{{with .Error}}<p class="flash flash-alert" role="alert">{{.}}</p>{{end}}
<p>{{if .Organizations}}{{t "passwords.new.instructions"}}{{else}}{{t "passwords.new.instructions_email"}}{{end}}</p>
<form method="post" action="/passwords" class="auth-form">
	{{csrfField}}
	{{- if .Organizations}}
	<p>
		<label for="tenant">{{t "passwords.new.organization"}}</label>
		<input id="tenant" name="tenant" type="text" value="{{.Tenant}}" required maxlength="63" autocapitalize="none" spellcheck="false">
	</p>
	{{- end}}
	<p>
		<label for="email">{{t "passwords.new.email"}}</label>
		<input id="email" name="email" type="email" value="{{.Email}}" required maxlength="320" autocomplete="username">
	</p>
	<p><button type="submit">{{t "passwords.new.submit"}}</button></p>
</form>
<p><a href="/session/new">{{t "passwords.new.back"}}</a></p>
{{end}}
