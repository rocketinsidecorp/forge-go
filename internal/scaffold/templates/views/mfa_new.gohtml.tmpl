{{define "title"}}{{if .Rotation}}{{t "mfa.new.rotate_title"}}{{else}}{{t "mfa.new.title"}}{{end}}{{end}}
{{define "content"}}
<h1>{{if .Rotation}}{{t "mfa.new.rotate_title"}}{{else}}{{t "mfa.new.title"}}{{end}}</h1>
{{with .Error}}<p class="flash flash-alert" role="alert">{{.}}</p>{{end}}
<p>{{t "mfa.new.instructions"}}</p>
<p><a href="{{.URI}}">{{t "mfa.new.link"}}</a></p>
<p>{{t "mfa.new.key"}}: <code id="mfa-key">{{.Key}}</code></p>
<p><small>{{t "mfa.new.expires"}}</small></p>
<form method="post" action="{{if .Rotation}}/mfa/rotation/confirm{{else}}/mfa/confirm{{end}}" class="auth-form">
	{{csrfField}}
	{{/* Confirming needs the password again, and for a rotation a code of the current authenticator: a session alone cannot finish the change. */}}
	<p>
		<label for="confirm-password">{{t "mfa.show.password"}}</label>
		<input id="confirm-password" name="password" type="password" required maxlength="4096" autocomplete="current-password">
	</p>
	{{if .Rotation}}
	<p>
		<label for="current-code">{{t "mfa.new.current_code"}}</label>
		<input id="current-code" name="current_code" type="text" required maxlength="32" inputmode="numeric" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" aria-describedby="current-code-hint">
		<small id="current-code-hint">{{t "mfa.show.code_hint"}}</small>
	</p>
	{{end}}
	<p>
		<label for="mfa-code">{{t "mfa.new.code"}}</label>
		<input id="mfa-code" name="code" type="text" required maxlength="32" inputmode="numeric" autocomplete="one-time-code" autocapitalize="none" spellcheck="false">
	</p>
	<p><button type="submit">{{if .Rotation}}{{t "mfa.new.rotate_submit"}}{{else}}{{t "mfa.new.submit"}}{{end}}</button></p>
</form>
<p><a href="/mfa">{{t "mfa.show.back"}}</a></p>
{{end}}
