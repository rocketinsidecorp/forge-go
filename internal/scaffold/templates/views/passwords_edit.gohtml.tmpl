{{define "title"}}{{t "passwords.edit.title"}}{{end}}
{{define "content"}}
<h1>{{t "passwords.edit.title"}}</h1>
{{with .Error}}<p class="flash flash-alert" role="alert">{{.}}</p>{{end}}
<form method="post" action="/passwords" class="auth-form">
	{{csrfField}}
	{{methodField "PATCH"}}
	<input type="hidden" name="token" value="{{.Token}}">
	<p>
		<label for="password">{{t "passwords.edit.password"}}</label>
		<input id="password" name="password" type="password" required minlength="12" maxlength="4096" autocomplete="new-password"{{if .Errors.Has "password"}} aria-invalid="true" aria-describedby="password-error"{{end}}>
		{{with .Errors.Message "password"}}<small id="password-error" class="field-error">{{.}}</small>{{end}}
	</p>
	<p>
		<label for="password_confirmation">{{t "passwords.edit.password_confirmation"}}</label>
		<input id="password_confirmation" name="password_confirmation" type="password" required maxlength="4096" autocomplete="new-password"{{if .Errors.Has "password_confirmation"}} aria-invalid="true" aria-describedby="password_confirmation-error"{{end}}>
		{{with .Errors.Message "password_confirmation"}}<small id="password_confirmation-error" class="field-error">{{.}}</small>{{end}}
	</p>
	<p><button type="submit">{{t "passwords.edit.submit"}}</button></p>
</form>
{{end}}
