# Private local overrides for {{.Name}}. This file is git-ignored and is
# loaded by `forge`; never copy its values to production.
{{- if .DB.Identity}}
# Docker Compose also loads it for this application's services.
# App-specific 32-byte MFA encryption key (canonical unpadded base64url).
FORGE_AUTH_MFA_KEY={{.MFAEncryptionKey}}
{{- end}}
