// TestConfigureConnectsToDatabase needs FORGE_TEST_DATABASE_URL (`forge test`
// reads it from .env.development); it is skipped otherwise.
{{- else}}
// TestConfigureConnectsToDatabase runs against a temporary SQLite file.
{{- end}}
func TestConfigureConnectsToDatabase(t *testing.T) {
	cfg := config.Default()
{{- if eq .DB.Adapter "postgres"}}
	// As the runtime role the application serves with (no superuser, no
	// BYPASSRLS, data privileges only).
	cfg.Database = postgrestest.NewRLS(t).RuntimeConfig
{{- else}}
	cfg.Database = {{.DB.TestPackage}}.Config(t)
{{- end}}
{{- if .DB.Identity}}
	cfg.Auth.MFAKey = config.NewSecret("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
{{- end}}
	app, err := forge.New(forge.WithConfig(cfg))
	if err != nil {
		t.Fatal(err)
	}
	if err := Configure(context.Background(), app); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = app.Close(context.Background()) })

	recorder := httptest.NewRecorder()
	app.Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/health/ready", nil))
	if recorder.Code != http.StatusOK || !strings.Contains(recorder.Body.String(), `"database"`) {
		t.Fatalf("readiness status=%d body=%s", recorder.Code, recorder.Body.String())
	}
{{- if and .DB.Identity .APIAuth}}
	// The identity routes describe themselves: Forge's auth handlers carry
	// their operations, so the routes registered above are documented.
	assertOpenAPI(t, app, "/v1/status", "/health", "/v1/auth/session",
		"/auth/login", "/auth/logout", "/auth/mfa/complete",
		"/auth/recovery/request", "/auth/recovery/reset",
		"/auth/cookie/login", "/auth/cookie/mfa/complete", "/auth/cookie/logout")
{{- else}}
	assertOpenAPI(t, app, "/v1/status", "/health")
{{- end}}
{{- if .DB.Identity}}
{{- if .APIAuth}}

	authRecorder := httptest.NewRecorder()
	app.Handler().ServeHTTP(authRecorder, httptest.NewRequest(http.MethodGet, "/v1/auth/session", nil))
	if authRecorder.Code != http.StatusUnauthorized {
		t.Fatalf("unauthenticated session status=%d body=%s", authRecorder.Code, authRecorder.Body.String())
	}
{{- else}}

	// The HTML pages are the only way to sign in: the JSON authentication
	// APIs are opt-in (forge new --api-auth), so they are neither routed nor
	// documented.
	document := httptest.NewRecorder()
	app.Handler().ServeHTTP(document, httptest.NewRequest(http.MethodGet, forge.OpenAPIPath, nil))
	for _, route := range []struct{ method, path string }{
		{http.MethodPost, "/auth/login"}, {http.MethodPost, "/auth/logout"}, {http.MethodPost, "/auth/mfa/complete"},
		{http.MethodPost, "/auth/recovery/request"}, {http.MethodPost, "/auth/recovery/reset"},
		{http.MethodPost, "/auth/cookie/login"}, {http.MethodPost, "/auth/cookie/mfa/complete"}, {http.MethodPost, "/auth/cookie/logout"},
		{http.MethodGet, "/v1/auth/session"},
	} {
		request := httptest.NewRequest(route.method, route.path, strings.NewReader("{}"))
		request.Header.Set("Content-Type", "application/json")
		recorder := httptest.NewRecorder()
		app.Handler().ServeHTTP(recorder, request)
		if recorder.Code != http.StatusNotFound {
			t.Errorf("%s %s = %d, want 404 without --api-auth", route.method, route.path, recorder.Code)
		}
		if strings.Contains(document.Body.String(), `"`+route.path+`"`) {
			t.Errorf("the OpenAPI document describes %s without --api-auth", route.path)
		}
	}
{{- end}}

	signIn := httptest.NewRecorder()
	app.Handler().ServeHTTP(signIn, httptest.NewRequest(http.MethodGet, "/session/new", nil))
	if signIn.Code != http.StatusOK || !strings.Contains(signIn.Body.String(), `action="/session"`) || !strings.Contains(signIn.Body.String(), csrf.FormField) {
		t.Fatalf("sign-in page status=%d body=%s", signIn.Code, signIn.Body.String())
	}
	// Without outgoing mail nothing could deliver a reset link, so the reset
	// pages and the "Forgot your password?" link are absent.
	if strings.Contains(signIn.Body.String(), "/passwords/new") {
		t.Fatalf("the sign-in page offers a password reset without mail:\n%s", signIn.Body.String())
	}
	resetRequest := httptest.NewRecorder()
	app.Handler().ServeHTTP(resetRequest, httptest.NewRequest(http.MethodGet, "/passwords/new", nil))
	if resetRequest.Code != http.StatusNotFound {
		t.Fatalf("password reset page without mail: status=%d", resetRequest.Code)
	}

{{- if .APIAuth}}

	mfaRequest := httptest.NewRequest(http.MethodPost, "/auth/mfa/complete", strings.NewReader("{}"))
	mfaRequest.Header.Set("Content-Type", "application/json")
	mfaRecorder := httptest.NewRecorder()
	app.Handler().ServeHTTP(mfaRecorder, mfaRequest)
	if mfaRecorder.Code != http.StatusUnauthorized {
		t.Fatalf("invalid MFA completion status=%d body=%s", mfaRecorder.Code, mfaRecorder.Body.String())
	}
	// What an identity route answers is what the document says it answers.
	spec, err := app.OpenAPI()
	if err != nil {
		t.Fatal(err)
	}
	if err := spec.ValidateResponse(http.MethodPost, "/auth/mfa/complete", mfaRecorder.Code, mfaRecorder.Header(), mfaRecorder.Body.Bytes()); err != nil {
		t.Fatal(err)
	}
{{- end}}
{{- end}}
}
