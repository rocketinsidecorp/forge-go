func TestRoutes(t *testing.T) {
	t.Parallel()
{{- if .DB}}
	t.Skip("skipped for database apps; Configure tested in TestConfigureConnectsToDatabase")
{{- else}}
	app, err := forge.New()
	if err != nil {
		t.Fatal(err)
	}
	if err := Configure(context.Background(), app); err != nil {
		t.Fatal(err)
	}
	for _, path := range []string{"/", "/v1/status"} {
		recorder := httptest.NewRecorder()
		request := httptest.NewRequest(http.MethodGet, path, nil)
		request.Header.Set("Accept-Language", "en-US,en;q=0.9")
		app.Handler().ServeHTTP(recorder, request)
		if recorder.Code != http.StatusOK {
			t.Fatalf("GET %s status=%d body=%s", path, recorder.Code, recorder.Body.String())
		}
		if path == "/" && (!strings.Contains(recorder.Body.String(), "Welcome to {{.Name}}") || !strings.Contains(recorder.Body.String(), `src="/assets/forge-go-logo-`)) {
			t.Fatalf("welcome page is missing generated branding: %s", recorder.Body.String())
		}
		if path == "/" && recorder.Header().Get("Content-Security-Policy") != "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; frame-ancestors 'none'" {
			t.Fatalf("welcome page CSP = %q", recorder.Header().Get("Content-Security-Policy"))
		}
	}
	assertOpenAPI(t, app, "/v1/status", "/health")
	// Without Accept-Language the page is in the default locale.
	if page := welcomeResponse(app); page.Header().Get("Content-Language") != locales.DefaultLocale || strings.Contains(page.Body.String(), "translation missing") {
		t.Fatalf("welcome page Content-Language = %q:\n%s", page.Header().Get("Content-Language"), page.Body.String())
	}
	notFound := httptest.NewRecorder()
	app.Handler().ServeHTTP(notFound, httptest.NewRequest(http.MethodGet, "/not-a-route", nil))
	if notFound.Code != http.StatusNotFound {
		t.Fatalf("GET /not-a-route status=%d body=%s", notFound.Code, notFound.Body.String())
	}

	bundle, err := appassets.Load()
	if err != nil {
		t.Fatal(err)
	}
	logoPath, _ := bundle.Set.Path("forge-go-logo.png")
	if !strings.Contains(welcomeBody(t, app), logoPath) {
		t.Fatalf("the welcome page does not link the digested logo %s", logoPath)
	}
	logo := httptest.NewRecorder()
	app.Handler().ServeHTTP(logo, httptest.NewRequest(http.MethodGet, logoPath, nil))
	if logo.Code != http.StatusOK || logo.Header().Get("Content-Type") != "image/png" || len(logo.Body.Bytes()) < 8 {
		t.Fatalf("GET logo status=%d content-type=%q bytes=%d", logo.Code, logo.Header().Get("Content-Type"), logo.Body.Len())
	}
	if logo.Header().Get("Cache-Control") != "public, max-age=31536000, immutable" {
		t.Fatalf("logo Cache-Control = %q", logo.Header().Get("Cache-Control"))
	}
	// Assets do not depend on the visitor's language: no Vary, so caches keep one copy.
	if vary := logo.Header().Values("Vary"); len(vary) != 0 {
		t.Fatalf("logo Vary = %v", vary)
	}

	stylesheetPath, _ := bundle.Set.Path("application.css")
	stylesheet := httptest.NewRecorder()
	app.Handler().ServeHTTP(stylesheet, httptest.NewRequest(http.MethodGet, stylesheetPath, nil))
	if stylesheet.Code != http.StatusOK || !strings.HasPrefix(stylesheet.Header().Get("Content-Type"), "text/css") || stylesheet.Header().Get("Set-Cookie") != "" {
		t.Fatalf("GET stylesheet status=%d headers=%v", stylesheet.Code, stylesheet.Header())
	}

	// Only the digested names are served: no undigested name, no listing.
	for _, path := range []string{"/assets/application.css", "/assets/", "/assets/forge-go-logo.png"} {
		missing := httptest.NewRecorder()
		app.Handler().ServeHTTP(missing, httptest.NewRequest(http.MethodGet, path, nil))
		if missing.Code != http.StatusNotFound {
			t.Fatalf("GET %s status=%d, want 404", path, missing.Code)
		}
	}
{{- end}}
}


// assertOpenAPI checks the OpenAPI document Forge serves in development and
// test: valid JSON describing paths, and the real /v1/status response
// matching what it declares (a contract test; do the same for your routes).
func assertOpenAPI(t *testing.T, app *forge.App, paths ...string) {
	t.Helper()
	recorder := httptest.NewRecorder()
	app.Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, forge.OpenAPIPath, nil))
	var document struct {
		OpenAPI string         `json:"openapi"`
		Info    map[string]any `json:"info"`
		Paths   map[string]any `json:"paths"`
	}
	if err := json.Unmarshal(recorder.Body.Bytes(), &document); recorder.Code != http.StatusOK || err != nil || document.OpenAPI != "3.1.0" || document.Info["title"] != "{{.Name}}" {
		t.Fatalf("GET %s status=%d err=%v body=%s", forge.OpenAPIPath, recorder.Code, err, recorder.Body.String())
	}
	for _, path := range paths {
		if _, ok := document.Paths[path]; !ok {
			t.Errorf("the OpenAPI document does not describe %s", path)
		}
	}
	spec, err := app.OpenAPI()
	if err != nil {
		t.Fatal(err)
	}
	status := httptest.NewRecorder()
	app.Handler().ServeHTTP(status, httptest.NewRequest(http.MethodGet, "/v1/status", nil))
	if err := spec.ValidateResponse(http.MethodGet, "/v1/status", status.Code, status.Header(), status.Body.Bytes()); err != nil {
		t.Fatal(err)
	}
}
