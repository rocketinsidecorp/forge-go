func welcomeBody(t *testing.T, app *forge.App) string {
	t.Helper()
	return welcomeResponse(app).Body.String()
}

func welcomeResponse(app *forge.App) *httptest.ResponseRecorder {
	recorder := httptest.NewRecorder()
	app.Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/", nil))
	return recorder
}
