package assets

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
)

func TestBundleServesDigestedAssets(t *testing.T) {
	t.Parallel()
	bundle, err := Load()
	if err != nil {
		t.Fatal(err)
	}
	again, _ := Load()
	if again != bundle {
		t.Fatal("Load must return one shared bundle")
	}
	for _, logical := range []string{"application.css", "forge-go-logo.png", "application.js", "controllers/index.js", "controllers/hello_controller.js", "vendor/turbo.js", "vendor/stimulus.js"} {
		url, ok := bundle.Set.Path(logical)
		if !ok {
			t.Fatalf("%s is not in the asset table", logical)
		}
		recorder := httptest.NewRecorder()
		bundle.Set.Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, url, nil))
		if recorder.Code != http.StatusOK || recorder.Header().Get("Cache-Control") != "public, max-age=31536000, immutable" || recorder.Header().Get("Set-Cookie") != "" {
			t.Fatalf("GET %s: status=%d headers=%v", url, recorder.Code, recorder.Header())
		}
	}
	// Undigested names are not served.
	recorder := httptest.NewRecorder()
	bundle.Set.Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/assets/application.css", nil))
	if recorder.Code != http.StatusNotFound {
		t.Fatalf("GET /assets/application.css status=%d", recorder.Code)
	}
}

// TestImportMapPinsTurboStimulusAndControllers keeps the pieces
// app/javascript imports resolvable: a missing pin is a blank page in the
// browser, not a build error.
func TestImportMapPinsTurboStimulusAndControllers(t *testing.T) {
	t.Parallel()
	bundle, err := Load()
	if err != nil {
		t.Fatal(err)
	}
	for _, specifier := range []string{"@hotwired/turbo", "@hotwired/stimulus", "controllers", "controllers/application", "controllers/hello_controller"} {
		if !strings.Contains(bundle.ImportMap.JSON(), `"`+specifier+`":"/assets/`) {
			t.Errorf("the import map does not pin %q: %s", specifier, bundle.ImportMap.JSON())
		}
	}
}
