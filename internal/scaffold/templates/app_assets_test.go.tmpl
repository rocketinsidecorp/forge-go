// TestServedControllersAreCompiledJavaScript fails if TypeScript reaches the
// browser: the binary serves what `forge build` compiled into
// app/javascript/dist, which has no type annotations and no `declare` fields.
func TestServedControllersAreCompiledJavaScript(t *testing.T) {
	t.Parallel()
	bundle, err := Load()
	if err != nil {
		t.Fatal(err)
	}
	url, ok := bundle.Set.Path("controllers/hello_controller.js")
	if !ok {
		t.Fatal("controllers/hello_controller.js is not in the asset table")
	}
	recorder := httptest.NewRecorder()
	bundle.Set.Handler().ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, url, nil))
	body := recorder.Body.String()
	if recorder.Code != http.StatusOK || !strings.Contains(body, "class ") || !strings.Contains(body, "static targets") {
		t.Fatalf("GET %s: status=%d body=%s", url, recorder.Code, body)
	}
	for _, typescript := range []string{"declare ", ": HTMLInputElement", ": HTMLElement", "): void"} {
		if strings.Contains(body, typescript) {
			t.Errorf("%s still has TypeScript syntax %q:\n%s", url, typescript, body)
		}
	}
}
