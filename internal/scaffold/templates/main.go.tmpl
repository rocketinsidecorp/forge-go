// Command {{.Name}} runs the {{.Name}} service.
//
//	{{.Name}}              serve HTTP (default)
//	{{.Name}} healthcheck  probe the running server{{if not .SkipDocker}}; used by the Docker HEALTHCHECK{{end}}
{{- if .DB}}
//	{{.Name}} migrate      apply database migrations ("migrate status" lists them)
//	{{.Name}} rollback     revert the latest migration
//	{{.Name}} seed         load db.Seed's data in one transaction
//	{{.Name}} setup        create the owner account, once (with Forge identity)
//
// The commands come from app/bootstrap/app_gen.go, which `forge generate
// authentication` and `forge generate tenancy` rewrite.
{{- end}}
package main

import (
	forge "github.com/rocketinsidecorp/forge-go"

	"{{.Module}}/app/bootstrap"
)

{{ if .DB -}}
func main() { forge.Main(bootstrap.Configure, bootstrap.Commands()...) }
{{- else -}}
func main() { forge.Main(bootstrap.Configure) }
{{- end}}
