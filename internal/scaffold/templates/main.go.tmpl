// Command {{.Name}} runs the {{.Name}} service.
//
//	{{.Name}}              serve HTTP (default)
//	{{.Name}} healthcheck  probe the running server; used by the Docker HEALTHCHECK
{{- if .DB}}
//	{{.Name}} migrate      apply database migrations ("migrate status" lists them)
//	{{.Name}} rollback     revert the latest migration
//	{{.Name}} seed         load db.Seed's data in one transaction
{{- end}}
{{- if and .DB .DB.Identity}}
//	{{.Name}} setup        create the first tenant and its owner account, once
{{- end}}
package main

import (
	forge "github.com/rocketinsidecorp/forge-go"
{{- if and .DB .DB.Identity}}
	authpostgres "github.com/rocketinsidecorp/forge-go/auth/postgres"
{{- end}}
{{- if and .DB .DB.Jobs}}
	jobs{{.DB.Adapter}} "github.com/rocketinsidecorp/forge-go/jobs/{{.DB.Adapter}}"
{{- end}}
{{- if .DB}}
	"github.com/rocketinsidecorp/forge-go/{{.DB.Adapter}}"
{{- end}}

	"{{.Module}}/app/bootstrap"
{{- if .DB}}
	"{{.Module}}/db"
{{- end}}
)

{{ if and .DB .DB.Identity -}}
func main() {
	forge.Main(
		bootstrap.Configure,
		append(
			postgres.CommandsFromSets(authpostgres.Migrations(), jobspostgres.Migrations(), db.Migrations()),
			authpostgres.SetupCommand(),
			postgres.SeedCommand(db.Seed),
		)...,
	)
}
{{- else if and .DB .DB.Jobs -}}
func main() {
	forge.Main(bootstrap.Configure, append({{.DB.Adapter}}.CommandsFromSets(jobs{{.DB.Adapter}}.Migrations(), db.Migrations()), {{.DB.Adapter}}.SeedCommand(db.Seed))...)
}
{{- else if .DB -}}
func main() {
	forge.Main(bootstrap.Configure, append({{.DB.Adapter}}.Commands(db.Migrations()), {{.DB.Adapter}}.SeedCommand(db.Seed))...)
}
{{- else -}}
func main() { forge.Main(bootstrap.Configure) }
{{- end}}
