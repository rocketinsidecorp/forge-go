func Test[[.Title]]PagesBroadcastChanges(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)
	updates := browser.subscribe()

	// A form that fails validation changes nothing and publishes nothing.
	invalid := [[.Camel]]FirstValues()
	invalid.Set("[[.InvalidField.Name]]", [[.InvalidValue]])
	[[.Camel]]Expect(t, browser.submit("/[[.Plural]]/new", http.MethodPost, "/[[.Plural]]", invalid), http.StatusUnprocessableEntity)
	[[.Camel]]Silent(t, updates)

	// Create: the row appears at the top of every open list.
	location := [[.Camel]]Redirected(t, browser.submit("/[[.Plural]]/new", http.MethodPost, "/[[.Plural]]", [[.Camel]]FirstValues()))
	entity := browser.stored()
	row := `<tr id="[[.Name]]_` + entity.ID.String() + `">`
	created := [[.Camel]]Next(t, updates)
	for _, want := range []string{
		`<turbo-stream action="remove" target="[[.Plural]]_empty"></turbo-stream>`,
		`<turbo-stream action="prepend" target="[[.Plural]]"><template>` + row,
		`href="/[[.Plural]]/` + entity.ID.String() + `"`,
[[- with .Marker]]
		[[.First]],
[[- end]]
	} {
		if !strings.Contains(created, want) {
			t.Errorf("the create update does not contain %q:\n%s", want, created)
		}
	}
	if strings.Contains(created, csrf.FormField) || strings.Contains(created, "<form") {
		t.Errorf("a broadcast must carry nothing specific to the person who made the change:\n%s", created)
	}

	// Update: the row is replaced.
	[[.Camel]]Redirected(t, browser.submit(location+"/edit", http.MethodPatch, location, [[.Camel]]WithVersion([[.Camel]]SecondValues(), "1")))
	replaced := [[.Camel]]Next(t, updates)
	if !strings.Contains(replaced, `<turbo-stream action="replace" target="[[.Name]]_`+entity.ID.String()+`"><template>`+row) {
		t.Errorf("the update is not a replace of the row:\n%s", replaced)
	}
[[- with .Marker]]
	if !strings.Contains(replaced, [[.Second]]) || strings.Contains(replaced, [[.First]]) {
		t.Errorf("the replaced row does not show the new values:\n%s", replaced)
	}
[[- end]]

	// A stale delete changes nothing and publishes nothing.
	[[.Camel]]Redirected(t, browser.submit(location, http.MethodDelete, location, url.Values{"version": {"1"}}))
	[[.Camel]]Silent(t, updates)

	// Delete: the row is removed.
	[[.Camel]]Redirected(t, browser.submit(location, http.MethodDelete, location, url.Values{"version": {"2"}}))
	if removed := [[.Camel]]Next(t, updates); removed != `<turbo-stream action="remove" target="[[.Name]]_`+entity.ID.String()+`"></turbo-stream>`+"\n" {
		t.Errorf("the delete update = %q", removed)
	}
}
