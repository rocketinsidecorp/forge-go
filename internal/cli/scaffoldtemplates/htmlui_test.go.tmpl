[[- if .Broadcast]]

// channel is where the pages publish: the tenant's "[[.Plural]]" channel, or the global one.
func (b *[[.Camel]]Browser) channel() broadcast.Channel {
	b.t.Helper()
[[- if .Tenant]]
	channel, err := broadcast.ForTenant(b.tenant, "[[.Plural]]")
[[- else]]
	channel, err := broadcast.Global("[[.Plural]]")
[[- end]]
	if err != nil {
		b.t.Fatal(err)
	}
	return channel
}

// subscribe listens like an open index page does.
func (b *[[.Camel]]Browser) subscribe() broadcast.Subscription {
	b.t.Helper()
	subscription, err := b.broker.Subscribe(context.Background(), b.channel())
	if err != nil {
		b.t.Fatal(err)
	}
	b.t.Cleanup(subscription.Close)
	return subscription
}

// next returns the message just published.
func [[.Camel]]Next(t *testing.T, subscription broadcast.Subscription) string {
	t.Helper()
	select {
	case message, ok := <-subscription.Messages():
		if !ok {
			t.Fatal("the subscription ended")
		}
		return message.Data
	case <-time.After(5 * time.Second):
		t.Fatal("no update was published")
		return ""
	}
}

// [[.Camel]]Silent fails if anything was published.
func [[.Camel]]Silent(t *testing.T, subscription broadcast.Subscription) {
	t.Helper()
	select {
	case message := <-subscription.Messages():
		t.Fatalf("unexpected update: %s", message.Data)
	default:
	}
}

