// new[[.Title]]Service builds the use cases over an in-memory store with a clock
// that advances one second per reading.
func new[[.Title]]Service(t *testing.T) *application.[[.Title]]Service {
	t.Helper()
	repo := &[[.Camel]]MemoryRepository{rows: make(map[uuid.UUID]domain.[[.Title]])}
	var mu sync.Mutex
	ticks := 0
	clock := func() time.Time {
		mu.Lock()
		defer mu.Unlock()
		ticks++
		return time.Date(2026, 9, 26, 12, 0, 0, 0, time.UTC).Add(time.Duration(ticks) * time.Second)
	}
	service, err := application.New[[.Title]]Service(repo,[[.StubArgs]] clock, uuid.New)
	if err != nil {
		t.Fatal(err)
	}
	return service
}

// [[.Camel]]Browser is a minimal browser: it keeps cookies between requests, so a
// CSRF token and a flash message travel as they do in real use.
type [[.Camel]]Browser struct {
	t       *testing.T
	service *application.[[.Title]]Service
	handler http.Handler
	cookies map[string]*http.Cookie
[[- if .Broadcast]]
	broker  *broadcast.Memory
[[- if .Tenant]]
	tenant  uuid.UUID
[[- end]]
[[- end]]
}

// [[.Camel]]Translator loads config/locales with English as the default
// locale, so the pages read as the assertions expect whatever the
// application's default is. Missing translations show and fail the test.
func [[.Camel]]Translator(t *testing.T) *i18n.Translator {
	t.Helper()
	cfg := config.Default()
	cfg.I18n.DefaultLocale = "en"
	translator, err := locales.New(cfg, nil)
	if err != nil {
		t.Fatal(err)
	}
	return translator
}

// new[[.Title]]Browser serves the pages from a forge.App with the middleware
// bootstrap installs (method override, CSRF protection, flash messages) and
// the application's own templates.
func new[[.Title]]Browser(t *testing.T, protect htmlui.[[.Title]]Protect) *[[.Camel]]Browser {
	t.Helper()
[[- if .Broadcast]]
	signerKey, err := broadcast.RandomKey()
	if err != nil {
		t.Fatal(err)
	}
	signer, err := broadcast.NewSigner(broadcast.SignerOptions{Key: signerKey})
	if err != nil {
		t.Fatal(err)
	}
	translator := [[.Camel]]Translator(t)
	renderer, err := appviews.New(appviews.WithI18n(translator), appviews.WithStreams(signer))
[[- else]]
	translator := [[.Camel]]Translator(t)
	renderer, err := appviews.New(appviews.WithI18n(translator))
[[- end]]
	if err != nil {
		t.Fatal(err)
	}
	app, err := forge.New()
	if err != nil {
		t.Fatal(err)
	}
	translations, err := translator.Middleware(i18n.NegotiationOptions{})
	if err != nil {
		t.Fatal(err)
	}
	protection, err := csrf.New(csrf.Options{})
	if err != nil {
		t.Fatal(err)
	}
	middlewares := []func(http.Handler) http.Handler{translations, web.MethodOverride, protection.Handler, web.Flash}
[[- if and .Broadcast .Tenant]]
	// The application's authentication puts the caller's tenant in the
	// request context; the pages publish to and subscribe on that tenant's channel.
	tenant := uuid.MustNew()
	middlewares = append(middlewares, func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			ctx, err := tenancy.WithContext(r.Context(), tenancy.Tenant{ID: tenant})
			if err != nil {
				t.Error(err)
			}
			next.ServeHTTP(w, r.WithContext(ctx))
		})
	})
[[- end]]
	for _, middleware := range middlewares {
		if err := app.Use(middleware); err != nil {
			t.Fatal(err)
		}
	}
	service := new[[.Title]]Service(t)
[[- if .Broadcast]]
	broker, err := broadcast.NewMemory(context.Background(), broadcast.MemoryOptions{})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(broker.Close)
	if err := htmlui.Register[[.PluralTitle]](app, service, renderer, protect, htmlui.With[[.Title]]Broadcast(broker)); err != nil {
		t.Fatal(err)
	}
	return &[[.Camel]]Browser{t: t, service: service, handler: app.Handler(), cookies: make(map[string]*http.Cookie), broker: broker[[if .Tenant]], tenant: tenant[[end]]}
[[- else]]
	if err := htmlui.Register[[.PluralTitle]](app, service, renderer, protect); err != nil {
		t.Fatal(err)
	}
	return &[[.Camel]]Browser{t: t, service: service, handler: app.Handler(), cookies: make(map[string]*http.Cookie)}
[[- end]]
}

// request sends form (url-encoded) as the body when it is not nil.
func (b *[[.Camel]]Browser) request(method, target string, form url.Values) *httptest.ResponseRecorder {
	b.t.Helper()
	var body io.Reader
	if form != nil {
		body = strings.NewReader(form.Encode())
	}
	request := httptest.NewRequest(method, target, body)
	request.Header.Set("Accept", "text/html")
	if form != nil {
		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	}
	for _, cookie := range b.cookies {
		request.AddCookie(cookie)
	}
	recorder := httptest.NewRecorder()
	b.handler.ServeHTTP(recorder, request)
	if strings.Contains(recorder.Body.String(), "translation missing") {
		b.t.Errorf("%s %s shows a missing translation:\n%s", method, target, recorder.Body.String())
	}
	for _, cookie := range recorder.Result().Cookies() {
		if cookie.MaxAge < 0 || cookie.Value == "" {
			delete(b.cookies, cookie.Name)
		} else {
			b.cookies[cookie.Name] = cookie
		}
	}
	return recorder
}

func (b *[[.Camel]]Browser) get(target string) *httptest.ResponseRecorder {
	b.t.Helper()
	return b.request(http.MethodGet, target, nil)
}

// token opens page, which sets the CSRF cookie, and returns the form token.
func (b *[[.Camel]]Browser) token(page string) string {
	b.t.Helper()
	[[.Camel]]Expect(b.t, b.get(page), http.StatusOK)
	cookie := b.cookies[csrf.CookieName]
	if cookie == nil {
		b.t.Fatal("the page did not set the CSRF cookie")
	}
	return cookie.Value
}

// submit does what a browser does with a form on page: it sends values, with
// the page's CSRF token, to target. A method other than POST travels as the
// _method field.
func (b *[[.Camel]]Browser) submit(page, method, target string, values url.Values) *httptest.ResponseRecorder {
	b.t.Helper()
	submitted := maps.Clone(values)
	if submitted == nil {
		submitted = url.Values{}
	}
	submitted.Set(csrf.FormField, b.token(page))
	if method != http.MethodPost {
		submitted.Set("_method", method)
	}
	return b.request(http.MethodPost, target, submitted)
}

func [[.Camel]]Expect(t *testing.T, recorder *httptest.ResponseRecorder, status int) {
	t.Helper()
	if recorder.Code != status {
		t.Fatalf("status %d, want %d; body %s", recorder.Code, status, recorder.Body)
	}
}

// [[.Camel]]Contains fails unless the page has every fragment.
func [[.Camel]]Contains(t *testing.T, recorder *httptest.ResponseRecorder, fragments ...string) {
	t.Helper()
	for _, fragment := range fragments {
		if !strings.Contains(recorder.Body.String(), fragment) {
			t.Errorf("the page does not contain %q:\n%s", fragment, recorder.Body)
		}
	}
}

// [[.Camel]]Redirected checks for 303 See Other and returns where to.
func [[.Camel]]Redirected(t *testing.T, recorder *httptest.ResponseRecorder) string {
	t.Helper()
	[[.Camel]]Expect(t, recorder, http.StatusSeeOther)
	return recorder.Header().Get("Location")
}

// [[.Camel]]FirstValues is a submission every field accepts, all fields set.
func [[.Camel]]FirstValues() url.Values {
	values := url.Values{}
[[.FormSetters 1 true]]	return values
}

// [[.Camel]]SecondValues differs from the first in every field.
func [[.Camel]]SecondValues() url.Values {
	values := url.Values{}
[[.FormSetters 2 true]]	return values
}
