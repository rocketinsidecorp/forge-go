	[[.Camel]]Expect(t, readOnly.submit("/[[.Plural]]", http.MethodPost, "/[[.Plural]]", [[.Camel]]FirstValues()), http.StatusForbidden)
	[[.Camel]]Expect(t, readOnly.submit("/[[.Plural]]", http.MethodPatch, target, [[.Camel]]WithVersion([[.Camel]]SecondValues(), "1")), http.StatusForbidden)
	[[.Camel]]Expect(t, readOnly.submit("/[[.Plural]]", http.MethodDelete, target, url.Values{"version": {"1"}}), http.StatusForbidden)
	if got := readOnly.stored(); !reflect.DeepEqual(got, entity) {
