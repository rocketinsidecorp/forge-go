	}
	own := browser.subscribe()
	[[.Camel]]Redirected(t, browser.submit("/[[.Plural]]/new", http.MethodPost, "/[[.Plural]]", [[.Camel]]FirstValues()))
	[[.Camel]]Next(t, own)
	[[.Camel]]Silent(t, foreign)
	global, err := broadcast.Global("[[.Plural]]")
	if err != nil {
