// [[.Camel]]MemoryRepository keeps the page tests independent of any database.
type [[.Camel]]MemoryRepository struct {
	mu   sync.Mutex
	rows map[uuid.UUID]domain.[[.Title]]
}

var _ application.[[.Title]]Repository = (*[[.Camel]]MemoryRepository)(nil)

func (r *[[.Camel]]MemoryRepository) Create(_ context.Context, entity domain.[[.Title]]) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.rows[entity.ID] = entity
	return entity, nil
}

func (r *[[.Camel]]MemoryRepository) Get(_ context.Context, id uuid.UUID) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	entity, ok := r.rows[id]
	if !ok {
		return domain.[[.Title]]{}, domain.Err[[.Title]]NotFound
	}
	return entity, nil
}

func (r *[[.Camel]]MemoryRepository) List(_ context.Context, after uuid.UUID, limit int) ([]domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	newestFirst := slices.SortedFunc(maps.Values(r.rows), func(a, b domain.[[.Title]]) int { return cmp.Compare(0, a.ID.Compare(b.ID)) })
	var page []domain.[[.Title]]
	for _, entity := range newestFirst {
		if after != (uuid.UUID{}) && entity.ID.Compare(after) >= 0 {
			continue
		}
		if len(page) == limit {
			break
		}
		page = append(page, entity)
	}
	return page, nil
}

func (r *[[.Camel]]MemoryRepository) Update(_ context.Context, entity domain.[[.Title]]) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	stored, ok := r.rows[entity.ID]
	switch {
	case !ok:
		return domain.[[.Title]]{}, domain.Err[[.Title]]NotFound
	case stored.Version != entity.Version:
		return domain.[[.Title]]{}, domain.ErrStale[[.Title]]Version
	}
	entity.Version++
	r.rows[entity.ID] = entity
	return entity, nil
}

func (r *[[.Camel]]MemoryRepository) Delete(_ context.Context, id uuid.UUID, version int) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	stored, ok := r.rows[id]
	switch {
	case !ok:
		return domain.Err[[.Title]]NotFound
	case stored.Version != version:
		return domain.ErrStale[[.Title]]Version
	}
	delete(r.rows, id)
	return nil
}

// [[.Camel]]AllowAll stands in for the application's guard: it lets every request
// through. It exists only in tests.
func [[.Camel]]AllowAll(_ string, next http.Handler) (http.Handler, error) { return next, nil }

// [[.Camel]]Grant returns a guard that lets through only the named permissions.
func [[.Camel]]Grant(granted ...string) htmlui.[[.Title]]Protect {
	return func(permission string, next http.Handler) (http.Handler, error) {
		if slices.Contains(granted, permission) {
			return next, nil
		}
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			web.Error(w, r, fault.New("permission_denied", "permission denied", fault.CategoryForbidden, 0))
		}), nil
	}
}

