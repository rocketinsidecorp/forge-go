// A form loaded before someone else saved must not overwrite their change.
func Test[[.Title]]PagesRejectAStaleUpdateWith409(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)
	loaded := browser.seed()
	target := "/[[.Plural]]/" + loaded.ID.String()
	current := browser.changeBehindTheirBack(loaded)

	conflict := browser.submit(target+"/edit", http.MethodPatch, target, [[.Camel]]WithVersion([[.Camel]]SecondValues(), "1"))
	[[.Camel]]Expect(t, conflict, http.StatusConflict)
	[[.Camel]]Contains(t, conflict, "was changed by someone else", `href="`+target+`/edit"`[[with .Marker]], [[.Second]][[end]])
	if after := browser.stored(); !reflect.DeepEqual(after, current) {
		t.Errorf("a stale form changed the [[.Name]]: %+v, want %+v", after, current)
	}
}

func Test[[.Title]]PagesKeepAStaleDelete(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)
	loaded := browser.seed()
	target := "/[[.Plural]]/" + loaded.ID.String()
	browser.changeBehindTheirBack(loaded)

	location := [[.Camel]]Redirected(t, browser.submit(target, http.MethodDelete, target, url.Values{"version": {"1"}}))
	if location != target {
		t.Fatalf("Location = %q, want %q", location, target)
	}
	if browser.count() != 1 {
		t.Fatal("a stale delete removed the [[.Name]]")
	}
	[[.Camel]]Contains(t, browser.get(location), "was not deleted", `class="flash flash-alert"`)
}

func Test[[.Title]]PagesAnswerMissingRecordsWith404(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)
	for _, id := range []string{uuid.MustNew().String(), "not-a-uuid"} {
		target := "/[[.Plural]]/" + id
		for _, path := range []string{target, target + "/edit"} {
			missing := browser.get(path)
			[[.Camel]]Expect(t, missing, http.StatusNotFound)
			[[.Camel]]Contains(t, missing, "[[.HumanTitle]] not found", `href="/[[.Plural]]"`)
		}
		[[.Camel]]Expect(t, browser.submit("/[[.Plural]]/new", http.MethodPatch, target, [[.Camel]]WithVersion([[.Camel]]SecondValues(), "1")), http.StatusNotFound)
		[[.Camel]]Expect(t, browser.submit("/[[.Plural]]/new", http.MethodDelete, target, url.Values{"version": {"1"}}), http.StatusNotFound)
	}
}

func Test[[.Title]]PagesRequireTheCSRFToken(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)
	entity := browser.seed()
	target := "/[[.Plural]]/" + entity.ID.String()
	browser.token("/[[.Plural]]/new") // the browser holds the cookie but the form lacks the field

	withMethod := func(method string, values url.Values) url.Values {
		values.Set("_method", method)
		return values
	}
	for name, values := range map[string]url.Values{
		"create": [[.Camel]]FirstValues(),
		"update": withMethod(http.MethodPatch, [[.Camel]]WithVersion([[.Camel]]SecondValues(), "1")),
		"delete": withMethod(http.MethodDelete, url.Values{"version": {"1"}}),
	} {
		path := target
		if name == "create" {
			path = "/[[.Plural]]"
		}
		forged := maps.Clone(values)
		forged.Set(csrf.FormField, "forged")
		for label, submitted := range map[string]url.Values{"missing": values, "wrong": forged} {
			[[.Camel]]Expect(t, browser.request(http.MethodPost, path, submitted), http.StatusForbidden)
			if got := browser.stored(); !reflect.DeepEqual(got, entity) {
				t.Fatalf("%s with a %s token changed the [[.Name]]: %+v", name, label, got)
			}
		}
	}
}

