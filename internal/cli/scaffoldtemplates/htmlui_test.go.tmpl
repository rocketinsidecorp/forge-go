// Test...BroadcastsStayInTheirTenant: the channel belongs to the caller's tenant, so
// a subscriber of another tenant's channel never receives the change.
func Test[[.Title]]BroadcastsStayInTheirTenant(t *testing.T) {
	t.Parallel()
