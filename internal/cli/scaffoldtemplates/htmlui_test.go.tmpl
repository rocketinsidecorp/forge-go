[[- end]]

// [[.Camel]]WithVersion returns values with the version an edit form carries.
func [[.Camel]]WithVersion(values url.Values, version string) url.Values {
	values.Set("version", version)
	return values
}

// seed stores a [[.Name]] directly through the use cases.
func (b *[[.Camel]]Browser) seed() domain.[[.Title]] {
	b.t.Helper()
	entity, err := b.service.Create(context.Background(), domain.[[.Title]]Input{
		[[.SampleInput 1 true]]
	})
	if err != nil {
		b.t.Fatal(err)
	}
	return entity
}

// changeBehindTheirBack updates the [[.Name]] as another person would, so a form
// loaded earlier is stale.
func (b *[[.Camel]]Browser) changeBehindTheirBack(entity domain.[[.Title]]) domain.[[.Title]] {
	b.t.Helper()
	changed, err := b.service.Update(context.Background(), entity.ID, entity.Version, domain.[[.Title]]Changes{
		[[.SampleChanges 3]]
	})
	if err != nil {
		b.t.Fatal(err)
	}
	return changed
}

func (b *[[.Camel]]Browser) count() int {
	b.t.Helper()
	page, err := b.service.List(context.Background(), pagination.Request{})
	if err != nil {
		b.t.Fatal(err)
	}
	return len(page.Items)
}

// stored returns the only [[.Name]] there is.
func (b *[[.Camel]]Browser) stored() domain.[[.Title]] {
	b.t.Helper()
	page, err := b.service.List(context.Background(), pagination.Request{})
	if err != nil || len(page.Items) != 1 {
		b.t.Fatalf("want exactly one [[.Name]], got %d (%v)", len(page.Items), err)
	}
	return page.Items[0]
}

func Test[[.Title]]PagesRenderTheirForms(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)

	index := browser.get("/[[.Plural]]")
	[[.Camel]]Expect(t, index, http.StatusOK)
	[[.Camel]]Contains(t, index, "No [[.PluralHuman]] yet.", `href="/[[.Plural]]/new"`)
	if got := index.Header().Get("Content-Security-Policy"); !strings.Contains(got, "script-src 'self'") {
		t.Errorf("Content-Security-Policy = %q", got)
	}

	form := browser.get("/[[.Plural]]/new")
	[[.Camel]]Expect(t, form, http.StatusOK)
	[[.Camel]]Contains(t, form,
		`<form method="post" action="/[[.Plural]]" id="new_[[.Name]]">`,
		`name="`+csrf.FormField+`"`,
[[- range .Fields]]
		`name="[[.Name]]"`,
[[- end]]
	)
	if strings.Contains(form.Body.String(), `name="_method"`) || strings.Contains(form.Body.String(), `name="version"`) {
		t.Errorf("the new form must not carry a method override or a version:\n%s", form.Body)
	}

	entity := browser.seed()
	listed := browser.get("/[[.Plural]]")
	[[.Camel]]Expect(t, listed, http.StatusOK)
	[[.Camel]]Contains(t, listed, `id="[[.Name]]_`+entity.ID.String()+`"`, `href="/[[.Plural]]/`+entity.ID.String()+`"`, `href="/[[.Plural]]/`+entity.ID.String()+`/edit"`)
}

func Test[[.Title]]PagesLifecycle(t *testing.T) {
	t.Parallel()
	browser := new[[.Title]]Browser(t, [[.Camel]]AllowAll)

	location := [[.Camel]]Redirected(t, browser.submit("/[[.Plural]]/new", http.MethodPost, "/[[.Plural]]", [[.Camel]]FirstValues()))
	entity := browser.stored()
	if location != "/[[.Plural]]/"+entity.ID.String() {
		t.Fatalf("Location = %q, want the new [[.Name]]", location)
	}
	if entity.Version != 1 {
		t.Errorf("version = %d, want 1", entity.Version)
	}

	// The redirect lands on the [[.Name]], with the notice shown once.
	shown := browser.get(location)
	[[.Camel]]Expect(t, shown, http.StatusOK)
	[[.Camel]]Contains(t, shown, "[[.HumanTitle]] was created.", `class="flash flash-notice"`[[with .Marker]], [[.First]][[end]])
	if again := browser.get(location); strings.Contains(again.Body.String(), "was created") {
		t.Error("the notice was shown twice")
	}

	// The edit form is filled in and carries the version.
	edit := browser.get(location + "/edit")
	[[.Camel]]Expect(t, edit, http.StatusOK)
	[[.Camel]]Contains(t, edit, `action="`+location+`"`, `name="_method" value="PATCH"`, `name="version" value="1"`[[with .Marker]], [[.First]][[end]])

	// PATCH, sent as a POST with _method like a browser form.
	updated := [[.Camel]]Redirected(t, browser.submit(location+"/edit", http.MethodPatch, location, [[.Camel]]WithVersion([[.Camel]]SecondValues(), "1")))
	if updated != location {
		t.Fatalf("Location = %q, want %q", updated, location)
	}
	if got := browser.stored().Version; got != 2 {
		t.Errorf("version = %d after the update, want 2", got)
	}
	shown = browser.get(location)
	[[.Camel]]Contains(t, shown, "[[.HumanTitle]] was updated."[[with .Marker]], [[.Second]][[end]])
[[- with .Marker]]
	if strings.Contains(shown.Body.String(), [[.First]]) {
		t.Error("the old value is still shown")
	}
[[- end]]

	// DELETE, with the version the page showed.
	deleted := [[.Camel]]Redirected(t, browser.submit(location, http.MethodDelete, location, url.Values{"version": {"2"}}))
	if deleted != "/[[.Plural]]" {
		t.Fatalf("Location = %q, want the index", deleted)
	}
	if browser.count() != 0 {
		t.Error("the [[.Name]] was not deleted")
	}
	[[.Camel]]Contains(t, browser.get(deleted), "[[.HumanTitle]] was deleted.")
	gone := browser.get(location)
	[[.Camel]]Expect(t, gone, http.StatusNotFound)
	[[.Camel]]Contains(t, gone, "[[.HumanTitle]] not found")
}
