// [[.Camel]]As serves handler to a signed-in principal holding only
// permissions, as the application's authentication middleware does.
func [[.Camel]]As(t *testing.T, handler http.Handler, permissions ...string) http.Handler {
	t.Helper()
	tenant, err := tenancy.New(uuid.MustNew())
	if err != nil {
		t.Fatal(err)
	}
	var granted []auth.Permission
	for _, name := range permissions {
		permission, err := auth.NewPermission(name)
		if err != nil {
			t.Fatal(err)
		}
		granted = append(granted, permission)
	}
	principal, err := auth.NewPrincipal(uuid.MustNew(), tenant, granted...)
	if err != nil {
		t.Fatal(err)
	}
	token, err := auth.NewToken()
	if err != nil {
		t.Fatal(err)
	}
	middleware, err := auth.NewMiddleware(auth.ResolverFunc(func(context.Context, auth.Digest) (auth.Session, bool, error) {
		return auth.Session{Principal: principal, ExpiresAt: time.Now().Add(time.Hour)}, true, nil
	}))
	if err != nil {
		t.Fatal(err)
	}
	authenticated := middleware.Authenticate(handler)
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		r.Header.Set("Authorization", "Bearer "+token.Reveal())
		authenticated.ServeHTTP(w, r)
	})
}
