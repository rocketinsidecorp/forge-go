// A [[$.Name]] belongs to a [[.Human]]: the form offers the [[.Plural]] in a select (the
// [[.Human]]'s page preselects it), a [[.Human]] the caller cannot see is refused with
// 422 even when the select is bypassed, and /[[.Plural]]/{id}/[[$.Plural]] lists the
// [[.Human]]'s [[$.Plural]] in the frame its page loads.
func Test[[$.Title]]PagesBelongTo[[.Title]](t *testing.T) {
	t.Parallel()
	browser := new[[$.Title]]Browser(t, [[$.Camel]]AllowAll)
	known := [[.KnownVar]].String()

	form := browser.get("/[[$.Plural]]/new?[[.Field.Name]]=" + known)
	[[$.Camel]]Expect(t, form, http.StatusOK)
	[[$.Camel]]Contains(t, form, `<select id="[[$.Name]]_[[.Field.Name]]" name="[[.Field.Name]]"`, `<option value="`+known+`" selected>`)

	values := [[$.Camel]]FirstValues()
	values.Set("[[.Field.Name]]", [[.MissingVar]].String())
	rejected := browser.submit("/[[$.Plural]]/new", http.MethodPost, "/[[$.Plural]]", values)
	[[$.Camel]]Expect(t, rejected, http.StatusUnprocessableEntity)
	[[$.Camel]]Contains(t, rejected, `id="[[$.Name]]_[[.Field.Name]]_error"`, "must name an existing [[.Human]]")
	if browser.count() != 0 {
		t.Fatal("a [[$.Name]] of a missing [[.Human]] was stored")
	}

	values.Set("[[.Field.Name]]", known)
	[[$.Camel]]Redirected(t, browser.submit("/[[$.Plural]]/new", http.MethodPost, "/[[$.Plural]]", values))
	entity := browser.stored()
	nested := browser.get("/[[.Plural]]/" + known + "/[[$.Plural]]")
	[[$.Camel]]Expect(t, nested, http.StatusOK)
	[[$.Camel]]Contains(t, nested, `<turbo-frame id="[[.Name]]_[[$.Plural]]" target="_top">`, `href="/[[$.Plural]]/`+entity.ID.String()+`"`, `href="/[[$.Plural]]/new?[[.Field.Name]]=`+known+`"`)
	empty := browser.get("/[[.Plural]]/" + uuid.MustNew().String() + "/[[$.Plural]]")
	[[$.Camel]]Expect(t, empty, http.StatusOK)
	[[$.Camel]]Contains(t, empty, "No [[$.PluralHuman]] yet.")
	[[$.Camel]]Expect(t, browser.get("/[[.Plural]]/"+[[.MissingVar]].String()+"/[[$.Plural]]"), http.StatusNotFound)
}
