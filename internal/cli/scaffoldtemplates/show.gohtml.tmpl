{{define "title"}}{{t "[[.Plural]].show.title"}}{{end}}
{{define "content"}}
<h1>{{t "[[.Plural]].show.title"}}</h1>
<dl id="{{domID "[[.Name]]" .Item.ID}}">
[[- range .Fields]]
	<dt>{{t "[[$.Plural]].fields.[[.Name]]"}}</dt>
[[- if .Optional]]
	<dd>{{with .Item.[[.Title]]}}[[if .IsText]]<pre>{{.}}</pre>[[else]]{{.}}[[end]]{{else}}<span class="muted">{{t "[[$.Plural]].form.not_set"}}</span>{{end}}</dd>
[[- else]]
	<dd>[[if .IsText]]<pre>{{.Item.[[.Title]]}}</pre>[[else]]{{.Item.[[.Title]]}}[[end]]</dd>
[[- end]]
[[- end]]
	<dt>{{t "[[.Plural]].fields.created_at"}}</dt>
	<dd>{{.Item.CreatedAt}}</dd>
	<dt>{{t "[[.Plural]].fields.updated_at"}}</dt>
	<dd>{{.Item.UpdatedAt}}</dd>
</dl>
<p class="actions">
	<a href="{{.Path}}/{{.Item.ID}}/edit">{{t "[[.Plural]].index.edit"}}</a>
	<a href="{{.Path}}">{{t "[[.Plural]].back"}}</a>
</p>
<form method="post" action="{{.Path}}/{{.Item.ID}}">
	{{csrfField}}
	{{methodField "DELETE"}}
	<input type="hidden" name="version" value="{{.Item.Version}}">
	<button type="submit">{{t "[[.Plural]].show.delete"}}</button>
</form>
{{end}}
