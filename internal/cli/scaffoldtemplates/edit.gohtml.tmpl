{{define "title"}}{{t "[[.Plural]].edit.title"}}{{end}}
{{define "content"}}
<h1>{{t "[[.Plural]].edit.title"}}</h1>
{{if .Conflict}}
<div class="flash flash-alert" role="alert">
	<p>{{t "[[.Plural]].edit.conflict"}} <a href="{{.Action}}/edit">{{t "[[.Plural]].edit.reload"}}</a></p>
</div>
{{end}}
{{template "[[.Plural]]/_form" .}}
<p><a href="{{.Action}}">{{t "[[.Plural]].edit.back_to_item"}}</a> | <a href="{{.Path}}">{{t "[[.Plural]].back"}}</a></p>
{{end}}
