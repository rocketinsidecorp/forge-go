{{define "title"}}[[.PluralHumanTitle]]{{end}}
{{define "content"}}
<h1>[[.PluralHumanTitle]]</h1>
<p><a href="{{.Path}}/new">New [[.Human]]</a></p>
{{if .Items}}
<table>
	<thead>
		<tr>
[[- range .IndexColumns]]
			<th scope="col">[[.Label]]</th>
[[- else]]
			<th scope="col">ID</th>
[[- end]]
			<th scope="col">Actions</th>
		</tr>
	</thead>
	<tbody>
		{{range .Items}}
		<tr id="{{domID "[[.Name]]" .ID}}">
[[- range .IndexColumns]]
			<td>{{.[[.Title]]}}</td>
[[- else]]
			<td>{{.ID}}</td>
[[- end]]
			<td><a href="{{$.Path}}/{{.ID}}">Show</a> <a href="{{$.Path}}/{{.ID}}/edit">Edit</a></td>
		</tr>
		{{end}}
	</tbody>
</table>
{{if .NextCursor}}<p><a href="{{.Path}}?cursor={{.NextCursor}}">Next page</a></p>{{end}}
{{else}}
<p>No [[.PluralHuman]] yet.</p>
{{end}}
{{end}}
