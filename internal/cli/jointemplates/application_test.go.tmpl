func Test[[.Title]]ServiceRequiresDependencies(t *testing.T) {
	t.Parallel()
	repo := &[[.Camel]]MemoryRepository{}
	for name, build := range map[string]func() (*application.[[.Title]]Service, error){
		"repository":        func() (*application.[[.Title]]Service, error) { return application.New[[.Title]]Service(nil,[[.StubArgs]] time.Now) },
		"[[.Left.Human]] repository": func() (*application.[[.Title]]Service, error) {
			return application.New[[.Title]]Service(repo, nil, [[.Right.StubType]]{}, time.Now)
		},
		"[[.Right.Human]] repository": func() (*application.[[.Title]]Service, error) {
			return application.New[[.Title]]Service(repo, [[.Left.StubType]]{}, nil, time.Now)
		},
		"clock": func() (*application.[[.Title]]Service, error) { return application.New[[.Title]]Service(repo,[[.StubArgs]] nil) },
	} {
		if _, err := build(); err == nil {
			t.Errorf("nil %s accepted", name)
		}
	}
}

// Attaching is idempotent, the list is newest first and pages, detaching
// removes one [[.Right.Human]] and only it.
func Test[[.Title]]ServiceAttachListDetach(t *testing.T) {
	t.Parallel()
	service, _ := new[[.Title]]Fixture(t)
	ctx := context.Background()
	[[.Left.Camel]] := uuid.MustNew()
	var attached []uuid.UUID
	for range 3 {
		[[.Right.Camel]] := uuid.MustNew()
		attached = append([]uuid.UUID{[[.Right.Camel]]}, attached...)
		for range 2 {
			if err := service.Attach(ctx, [[.Left.Camel]], [[.Right.Camel]]); err != nil {
				t.Fatal(err)
			}
		}
	}
	first, err := service.[[.Right.PluralTitle]](ctx, [[.Left.Camel]], pagination.Request{Limit: 2})
	if err != nil || len(first.Items) != 2 || first.NextCursor == "" {
		t.Fatalf("first page = %+v, %v", first, err)
	}
	after, err := pagination.DecodeCursor(first.NextCursor)
	if err != nil {
		t.Fatal(err)
	}
	rest, err := service.[[.Right.PluralTitle]](ctx, [[.Left.Camel]], pagination.Request{After: after})
	if err != nil {
		t.Fatal(err)
	}
	var got []uuid.UUID
	for _, entity := range append(first.Items, rest.Items...) {
		got = append(got, entity.ID)
	}
	if !slices.Equal(got, attached) {
		t.Fatalf("[[.Right.Plural]] = %v, want %v (newest first, each once)", got, attached)
	}
	if err := service.Detach(ctx, [[.Left.Camel]], attached[1]); err != nil {
		t.Fatal(err)
	}
	if err := service.Detach(ctx, [[.Left.Camel]], attached[1]); err != nil {
		t.Fatalf("detaching again: %v", err)
	}
	page, err := service.[[.Right.PluralTitle]](ctx, [[.Left.Camel]], pagination.Request{})
	if err != nil || len(page.Items) != 2 || page.Items[0].ID != attached[0] || page.Items[1].ID != attached[2] {
		t.Fatalf("after detach: %+v, %v", page, err)
	}
}

// A [[.Left.Human]] or [[.Right.Human]] the caller cannot see is refused, and nothing is stored.
func Test[[.Title]]ServiceRefusesMissingRows(t *testing.T) {
	t.Parallel()
	service, repo := new[[.Title]]Fixture(t)
	ctx := context.Background()
	if err := service.Attach(ctx, [[.Left.MissingVar]], uuid.MustNew()); !errors.Is(err, domain.Err[[.Left.Title]]NotFound) {
		t.Errorf("missing [[.Left.Human]]: err = %v, want Err[[.Left.Title]]NotFound", err)
	}
	if err := service.Attach(ctx, uuid.MustNew(), [[.Right.MissingVar]]); !errors.Is(err, domain.Err[[.Title]][[.Right.Title]]NotFound) {
		t.Errorf("missing [[.Right.Human]]: err = %v, want Err[[.Title]][[.Right.Title]]NotFound", err)
	}
	if err := service.Detach(ctx, [[.Left.MissingVar]], uuid.MustNew()); !errors.Is(err, domain.Err[[.Left.Title]]NotFound) {
		t.Errorf("detach from a missing [[.Left.Human]]: err = %v", err)
	}
	if _, err := service.[[.Right.PluralTitle]](ctx, [[.Left.MissingVar]], pagination.Request{}); !errors.Is(err, domain.Err[[.Left.Title]]NotFound) {
		t.Errorf("list of a missing [[.Left.Human]]: err = %v", err)
	}
	if len(repo.rows) != 0 {
		t.Errorf("a refused attach stored %v", repo.rows)
	}
	choices, err := service.[[.Right.Title]]Choices(ctx)
	if err != nil || len(choices) != 1 || choices[0].ID != [[.Right.KnownVar]] {
		t.Errorf("choices = %v, %v", choices, err)
	}
}
