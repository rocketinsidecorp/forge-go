// [[.Camel]]MemoryRepository keeps the handler tests independent of any database.
type [[.Camel]]MemoryRepository struct {
	mu   sync.Mutex
	rows map[uuid.UUID]map[uuid.UUID]time.Time
}

var _ application.[[.Title]]Repository = (*[[.Camel]]MemoryRepository)(nil)

func (r *[[.Camel]]MemoryRepository) Attach(_ context.Context, [[.Left.Camel]]ID, [[.Right.Camel]]ID uuid.UUID, at time.Time) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.rows[ [[.Left.Camel]]ID] == nil {
		r.rows[ [[.Left.Camel]]ID] = make(map[uuid.UUID]time.Time)
	}
	if _, ok := r.rows[ [[.Left.Camel]]ID][ [[.Right.Camel]]ID]; !ok {
		r.rows[ [[.Left.Camel]]ID][ [[.Right.Camel]]ID] = at
	}
	return nil
}

func (r *[[.Camel]]MemoryRepository) Detach(_ context.Context, [[.Left.Camel]]ID, [[.Right.Camel]]ID uuid.UUID) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	delete(r.rows[ [[.Left.Camel]]ID], [[.Right.Camel]]ID)
	return nil
}

func (r *[[.Camel]]MemoryRepository) List[[.Right.PluralTitle]](_ context.Context, [[.Left.Camel]]ID, after uuid.UUID, limit int) ([]domain.[[.Right.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	var ids []uuid.UUID
	for id := range r.rows[ [[.Left.Camel]]ID] {
		if after == (uuid.UUID{}) || id.Compare(after) < 0 {
			ids = append(ids, id)
		}
	}
	slices.SortFunc(ids, func(a, b uuid.UUID) int { return cmp.Compare(0, a.Compare(b)) })
	var page []domain.[[.Right.Title]]
	for _, id := range ids[:min(limit, len(ids))] {
		page = append(page, domain.[[.Right.Title]]{ID: id})
	}
	return page, nil
}
