package domain_test

import (
	"encoding/json"
	"errors"
[[- if .HasText]]
	"strings"
[[- end]]
	"testing"
	"time"

	"[[.Module]]/app/domain"
	"github.com/rocketinsidecorp/forge-go/uuid"
