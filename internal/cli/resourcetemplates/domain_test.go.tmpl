func Test[[.Title]]NewAcceptsTextAtTheLimitAndLineBreaks(t *testing.T) {
	t.Parallel()
[[- range .Fields]]
[[- if .IsText]]
	t.Run("[[.Name]]", func(t *testing.T) {
		t.Parallel()
		input := valid[[$.Title]]Input()
		input.[[.Title]] = [[.Literal `strings.Repeat("a", 65535)`]]
		if _, err := domain.New[[$.Title]](uuid.MustNew(), input, [[$.Name]]Created()); err != nil {
			t.Fatalf("65535 bytes: %v", err)
		}
		input.[[.Title]] = [[.Literal `"first\r\n\tsecond\n"`]]
		if _, err := domain.New[[$.Title]](uuid.MustNew(), input, [[$.Name]]Created()); err != nil {
			t.Fatalf("line breaks: %v", err)
		}
	})
[[- end]]
[[- end]]
}
