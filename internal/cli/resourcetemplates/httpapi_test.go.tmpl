// [[.Name]]MemoryRepository keeps the handler tests independent of any database.
type [[.Name]]MemoryRepository struct {
	mu   sync.Mutex
	rows map[uuid.UUID]domain.[[.Title]]
}

var _ application.[[.Title]]Repository = (*[[.Name]]MemoryRepository)(nil)

func (r *[[.Name]]MemoryRepository) Create(_ context.Context, entity domain.[[.Title]]) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.rows[entity.ID] = entity
	return entity, nil
}

func (r *[[.Name]]MemoryRepository) Get(_ context.Context, id uuid.UUID) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	entity, ok := r.rows[id]
	if !ok {
		return domain.[[.Title]]{}, domain.Err[[.Title]]NotFound
	}
	return entity, nil
}

func (r *[[.Name]]MemoryRepository) List(_ context.Context, after uuid.UUID, limit int) ([]domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	newestFirst := slices.SortedFunc(maps.Values(r.rows), func(a, b domain.[[.Title]]) int { return cmp.Compare(0, a.ID.Compare(b.ID)) })
	var page []domain.[[.Title]]
	for _, entity := range newestFirst {
		if after != (uuid.UUID{}) && entity.ID.Compare(after) >= 0 {
			continue
		}
		if len(page) == limit {
			break
		}
		page = append(page, entity)
	}
	return page, nil
}

func (r *[[.Name]]MemoryRepository) Update(_ context.Context, entity domain.[[.Title]]) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	stored, ok := r.rows[entity.ID]
	switch {
	case !ok:
		return domain.[[.Title]]{}, domain.Err[[.Title]]NotFound
	case stored.Version != entity.Version:
		return domain.[[.Title]]{}, domain.ErrStale[[.Title]]Version
	}
	entity.Version++
	r.rows[entity.ID] = entity
	return entity, nil
}

func (r *[[.Name]]MemoryRepository) Delete(_ context.Context, id uuid.UUID, version int) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	stored, ok := r.rows[id]
	switch {
	case !ok:
		return domain.Err[[.Title]]NotFound
	case stored.Version != version:
		return domain.ErrStale[[.Title]]Version
	}
	delete(r.rows, id)
	return nil
}

// [[.Name]]AllowAll stands in for the application's guard: it lets every request
// through. It exists only in tests.
func [[.Name]]AllowAll(_ string, next http.Handler) (http.Handler, error) { return next, nil }

// [[.Name]]Grant returns a guard that lets through only the named permissions.
func [[.Name]]Grant(granted ...string) httpapi.[[.Title]]Protect {
	return func(permission string, next http.Handler) (http.Handler, error) {
		if slices.Contains(granted, permission) {
			return next, nil
		}
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			web.Error(w, r, fault.New("permission_denied", "permission denied", fault.CategoryForbidden, 0))
		}), nil
	}
}

// new[[.Title]]Service builds the use cases over an in-memory store with a clock
// that advances one second per reading.
func new[[.Title]]Service(t *testing.T) *application.[[.Title]]Service {
	t.Helper()
	repo := &[[.Name]]MemoryRepository{rows: make(map[uuid.UUID]domain.[[.Title]])}
	var mu sync.Mutex
	ticks := 0
	clock := func() time.Time {
		mu.Lock()
		defer mu.Unlock()
		ticks++
		return time.Date(2026, 9, 26, 12, 0, 0, 0, time.UTC).Add(time.Duration(ticks) * time.Second)
	}
	service, err := application.New[[.Title]]Service(repo, clock, uuid.New)
	if err != nil {
		t.Fatal(err)
	}
	return service
}

// new[[.Title]]Handler serves the API from a forge.App, so requests pass through
// the framework's middleware (request IDs, body limit, error format). Every
// response is also checked against the OpenAPI document the routes declare,
// so each test below is a contract test too.
func new[[.Title]]HandlerFor(t *testing.T, service *application.[[.Title]]Service, protect httpapi.[[.Title]]Protect) http.Handler {
	t.Helper()
	app, err := forge.New()
	if err != nil {
		t.Fatal(err)
	}
	if err := httpapi.Register[[.PluralTitle]](app, service, protect); err != nil {
		t.Fatal(err)
	}
	spec, err := app.OpenAPI()
	if err != nil {
		t.Fatal(err)
	}
	return spec.CheckResponses(app.Handler(), func(r *http.Request, err error) {
		t.Errorf("%s %s: the response does not match the OpenAPI document: %v", r.Method, r.URL, err)
	})
}

// Test[[.Title]]OpenAPIDocument checks what the routes declare: every route is
// described, with its permission and types.
func Test[[.Title]]OpenAPIDocument(t *testing.T) {
	t.Parallel()
	app, err := forge.New()
	if err != nil {
		t.Fatal(err)
	}
	if err := httpapi.Register[[.PluralTitle]](app, new[[.Title]]Service(t), [[.Name]]AllowAll); err != nil {
		t.Fatal(err)
	}
	spec, err := app.OpenAPI()
	if err != nil {
		t.Fatal(err)
	}
	if undocumented := spec.Undocumented(); len(undocumented) != 0 {
		t.Fatalf("undocumented routes: %v", undocumented)
	}
	var document struct {
		Paths map[string]map[string]struct {
			OperationID string         `json:"operationId"`
			Permission  string         `json:"x-forge-permission"`
			RequestBody map[string]any `json:"requestBody"`
		} `json:"paths"`
		Components struct {
			Schemas map[string]any `json:"schemas"`
		} `json:"components"`
	}
	if err := json.Unmarshal(spec.JSON(), &document); err != nil {
		t.Fatal(err)
	}
	for _, want := range []struct{ path, method, id, permission string }{
		{"/v1/[[.Plural]]", "post", "create[[.Title]]", "[[.Plural]]:write"},
		{"/v1/[[.Plural]]", "get", "list[[.PluralTitle]]", "[[.Plural]]:read"},
		{"/v1/[[.Plural]]/{id}", "get", "get[[.Title]]", "[[.Plural]]:read"},
		{"/v1/[[.Plural]]/{id}", "patch", "update[[.Title]]", "[[.Plural]]:write"},
		{"/v1/[[.Plural]]/{id}", "delete", "delete[[.Title]]", "[[.Plural]]:write"},
	} {
		operation, ok := document.Paths[want.path][want.method]
		if !ok || operation.OperationID != want.id || operation.Permission != want.permission {
			t.Errorf("%s %s = %+v, want %s requiring %s", want.method, want.path, operation, want.id, want.permission)
		}
	}
	for _, name := range []string{"[[.Title]]Response", "[[.Title]]CreateRequest", "[[.Title]]PatchRequest", "ErrorBody"} {
		if _, ok := document.Components.Schemas[name]; !ok {
			t.Errorf("component %s is missing", name)
		}
	}
}

