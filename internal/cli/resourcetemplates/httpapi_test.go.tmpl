func Test[[.Title]]ListPagination(t *testing.T) {
	t.Parallel()
	handler := new[[.Title]]Handler(t)
	const total = 5
	var created []string
	for range total {
		recorder := [[.Name]]Send(t, handler, http.MethodPost, "/v1/[[.Plural]]", [[.Name]]Body{
			[[.SampleBody 1 true]]
		})
		[[.Name]]Expect(t, recorder, http.StatusCreated)
		created = append(created, [[.Name]]Decode(t, recorder)["id"].(string))
	}

	var seen []string
	target := "/v1/[[.Plural]]?limit=2"
	for pages := 1; ; pages++ {
		recorder := [[.Name]]Send(t, handler, http.MethodGet, target, nil)
		[[.Name]]Expect(t, recorder, http.StatusOK)
		var page pagination.Page[map[string]any]
		if err := json.Unmarshal(recorder.Body.Bytes(), &page); err != nil {
			t.Fatal(err)
		}
		for _, item := range page.Items {
			seen = append(seen, item["id"].(string))
		}
		if page.NextCursor == "" {
			if pages != 3 {
				t.Fatalf("walked %d pages, want 3", pages)
			}
			break
		}
		target = "/v1/[[.Plural]]?limit=2&cursor=" + page.NextCursor
	}
	if len(seen) != total {
		t.Fatalf("saw %d rows, want %d", len(seen), total)
	}
	for i, id := range seen {
		if want := created[total-1-i]; id != want {
			t.Fatalf("position %d: got %s, want %s (newest first)", i, id, want)
		}
	}

	// Without parameters the default limit covers everything.
	recorder := [[.Name]]Send(t, handler, http.MethodGet, "/v1/[[.Plural]]", nil)
	[[.Name]]Expect(t, recorder, http.StatusOK)
	var page pagination.Page[map[string]any]
	if err := json.Unmarshal(recorder.Body.Bytes(), &page); err != nil || len(page.Items) != total || page.NextCursor != "" {
		t.Fatalf("default page: %d items, cursor %q, err %v", len(page.Items), page.NextCursor, err)
	}
}

