// [[.Name]]Body is a JSON request body.
type [[.Name]]Body = map[string]any

// [[.Name]]Send issues a request with a JSON content type when it has a body.
func [[.Name]]Send(t *testing.T, handler http.Handler, method, target string, body any) *httptest.ResponseRecorder {
	t.Helper()
	return [[.Name]]SendAs(t, handler, method, target, "", body)
}

// [[.Name]]SendAs is Send with an explicit content type. body is raw text, a
// value to encode as JSON, or nil.
func [[.Name]]SendAs(t *testing.T, handler http.Handler, method, target, contentType string, body any) *httptest.ResponseRecorder {
	t.Helper()
	var payload string
	switch body := body.(type) {
	case nil:
	case string:
		payload = body
	default:
		encoded, err := json.Marshal(body)
		if err != nil {
			t.Fatal(err)
		}
		payload = string(encoded)
	}
	request := httptest.NewRequest(method, target, strings.NewReader(payload))
	switch {
	case contentType != "":
		request.Header.Set("Content-Type", contentType)
	case payload != "":
		request.Header.Set("Content-Type", "application/json")
	}
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	return recorder
}

func [[.Name]]Expect(t *testing.T, recorder *httptest.ResponseRecorder, status int) {
	t.Helper()
	if recorder.Code != status {
		t.Fatalf("status %d, want %d; body %s", recorder.Code, status, recorder.Body)
	}
}

func [[.Name]]Decode(t *testing.T, recorder *httptest.ResponseRecorder) map[string]any {
	t.Helper()
	if got := recorder.Header().Get("Content-Type"); got != "application/json" {
		t.Fatalf("content type %q, body %s", got, recorder.Body)
	}
	var value map[string]any
	if err := json.Unmarshal(recorder.Body.Bytes(), &value); err != nil {
		t.Fatalf("decode %s: %v", recorder.Body, err)
	}
	return value
}

// [[.Name]]RoundTrip encodes and decodes body, so values compare the way the
// client sees them.
func [[.Name]]RoundTrip(t *testing.T, body [[.Name]]Body) map[string]any {
	t.Helper()
	encoded, err := json.Marshal(body)
	if err != nil {
		t.Fatal(err)
	}
	var value map[string]any
	if err := json.Unmarshal(encoded, &value); err != nil {
		t.Fatal(err)
	}
	return value
}

// [[.Name]]AssertFields checks that every member of want appears in got unchanged.
func [[.Name]]AssertFields(t *testing.T, got map[string]any, want [[.Name]]Body) {
	t.Helper()
	for key, value := range [[.Name]]RoundTrip(t, want) {
		if !reflect.DeepEqual(got[key], value) {
			t.Errorf("%s = %v, want %v", key, got[key], value)
		}
	}
}

func [[.Name]]Version(t *testing.T, entity map[string]any) int {
	t.Helper()
	version, ok := entity["version"].(float64)
	if !ok {
		t.Fatalf("version missing in %v", entity)
	}
	return int(version)
}

func Test[[.Title]]Lifecycle(t *testing.T) {
	t.Parallel()
	handler := new[[.Title]]Handler(t)

	request := [[.Name]]Body{
		[[.SampleBody 1 true]]
	}
	recorder := [[.Name]]Send(t, handler, http.MethodPost, "/v1/[[.Plural]]", request)
	[[.Name]]Expect(t, recorder, http.StatusCreated)
	created := [[.Name]]Decode(t, recorder)
	id, _ := created["id"].(string)
	if parsed, err := uuid.Parse(id); err != nil || parsed.Version() != 7 {
		t.Fatalf("id %q is not a UUIDv7: %v", id, err)
	}
	[[.Name]]AssertFields(t, created, request)
	if [[.Name]]Version(t, created) != 1 || created["created_at"] == nil || created["created_at"] != created["updated_at"] {
		t.Fatalf("created = %v", created)
	}
	location := recorder.Header().Get("Location")
	if location != "/v1/[[.Plural]]/"+id {
		t.Fatalf("Location = %q", location)
	}

	recorder = [[.Name]]Send(t, handler, http.MethodGet, location, nil)
	[[.Name]]Expect(t, recorder, http.StatusOK)
	if got := [[.Name]]Decode(t, recorder); !reflect.DeepEqual(got, created) {
		t.Fatalf("got = %v, want %v", got, created)
	}

	// PATCH changes only the members it names.
	patch := [[.Name]]Body{
		"version": 1,
[[- with index .Fields 0]]
		"[[.Name]]": [[.SampleExpr 2]],
[[- end]]
	}
	recorder = [[.Name]]Send(t, handler, http.MethodPatch, location, patch)
	[[.Name]]Expect(t, recorder, http.StatusOK)
	patched := [[.Name]]Decode(t, recorder)
	want := maps.Clone(created)
	maps.Copy(want, [[.Name]]RoundTrip(t, patch))
	want["version"] = float64(2)
	for key, value := range want {
		if key != "updated_at" && !reflect.DeepEqual(patched[key], value) {
			t.Errorf("patched %s = %v, want %v", key, patched[key], value)
		}
	}
	if patched["updated_at"] == created["updated_at"] {
		t.Errorf("updated_at did not move: %v", patched["updated_at"])
	}
[[- if .HasOptional]]

	// null clears an optional field.
	nulls := [[.Name]]Body{
		"version": 2,
[[- range .OptionalFields]]
		"[[.Name]]": nil,
[[- end]]
	}
	recorder = [[.Name]]Send(t, handler, http.MethodPatch, location, nulls)
	[[.Name]]Expect(t, recorder, http.StatusOK)
	current := [[.Name]]Decode(t, recorder)
[[- range .OptionalFields]]
	if value, present := current["[[.Name]]"]; !present || value != nil {
		t.Errorf("[[.Name]] = %v after null, want null", value)
	}
[[- end]]
	if [[.Name]]Version(t, current) != 3 {
		t.Errorf("version = %d after the second update, want 3", [[.Name]]Version(t, current))
	}
[[- else]]
	current := patched
[[- end]]
[[- with .FirstRequired]]

	// null is not a value for a required field.
	recorder = [[$.Name]]Send(t, handler, http.MethodPatch, location, [[$.Name]]Body{"version": [[$.Name]]Version(t, current), "[[.Name]]": nil})
	[[$.Name]]Expect(t, recorder, http.StatusBadRequest)
	if code := [[$.Name]]Decode(t, recorder)["error"].(map[string]any)["code"]; code != "invalid_[[$.Name]]_[[.Name]]" {
		t.Errorf("code = %v", code)
	}
[[- end]]

	// Replaying the first version is rejected as stale.
	recorder = [[.Name]]Send(t, handler, http.MethodPatch, location, [[.Name]]Body{
		"version": 1,
[[- with index .Fields 0]]
		"[[.Name]]": [[.SampleExpr 3]],
[[- end]]
	})
	[[.Name]]Expect(t, recorder, http.StatusConflict)
	if body := [[.Name]]Decode(t, recorder); body["error"].(map[string]any)["code"] != "stale_version" {
		t.Fatalf("error = %v", body)
	}

	version := strconv.Itoa([[.Name]]Version(t, current))
	recorder = [[.Name]]Send(t, handler, http.MethodDelete, location+"?version=1", nil)
	[[.Name]]Expect(t, recorder, http.StatusConflict)
	recorder = [[.Name]]Send(t, handler, http.MethodDelete, location+"?version="+version, nil)
	[[.Name]]Expect(t, recorder, http.StatusNoContent)
	if recorder.Body.Len() != 0 {
		t.Errorf("204 response has a body: %s", recorder.Body)
	}
	recorder = [[.Name]]Send(t, handler, http.MethodGet, location, nil)
	[[.Name]]Expect(t, recorder, http.StatusNotFound)
}
[[- if .OptionalFields]]

