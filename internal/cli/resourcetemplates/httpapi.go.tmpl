type [[.Name]]Handlers struct {
	service *application.[[.Title]]Service
}

// [[.Name]]CreateRequest uses pointers so a missing member is reported instead of
// silently becoming a zero value.
type [[.Name]]CreateRequest struct {
[[- range .Fields]]
[[- if .Optional]]
	[[.Title]] *[[.RequestType]] `json:"[[.Name]],omitempty"[[if .IsTime]] format:"date-time"[[else if .IsUUID]] format:"uuid"[[end]]`
[[- else]]
	[[.Title]] *[[.RequestType]] `json:"[[.Name]]" openapi:"required,nonnull"[[if .IsTime]] format:"date-time"[[else if .IsUUID]] format:"uuid"[[end]]`
[[- end]]
[[- end]]
}

func (b [[.Name]]CreateRequest) input() (domain.[[.Title]]Input, error) {
	var input domain.[[.Title]]Input
[[- range .Fields]]
[[- if .Optional]]
[[- if or .IsTime .IsUUID]]
	if b.[[.Title]] != nil {
		value, err := parse[[$.Title]][[if .IsTime]]Time[[else]]UUID[[end]](*b.[[.Title]], domain.[[.Err]])
		if err != nil {
			return domain.[[$.Title]]Input{}, err
		}
		input.[[.Title]] = &value
	}
[[- else]]
	input.[[.Title]] = b.[[.Title]]
[[- end]]
[[- else]]
	if b.[[.Title]] == nil {
		return domain.[[$.Title]]Input{}, domain.[[.Err]]
	}
[[- if or .IsTime .IsUUID]]
	{
		value, err := parse[[$.Title]][[if .IsTime]]Time[[else]]UUID[[end]](*b.[[.Title]], domain.[[.Err]])
		if err != nil {
			return domain.[[$.Title]]Input{}, err
		}
		input.[[.Title]] = value
	}
[[- else]]
	input.[[.Title]] = *b.[[.Title]]
[[- end]]
[[- end]]
[[- end]]
	return input, nil
}
[[- if .HasTime]]

// parse[[.Title]]Time reads an RFC 3339 timestamp; anything else is invalid.
func parse[[.Title]]Time(value string, invalid error) (time.Time, error) {
	parsed, err := time.Parse(time.RFC3339, value)
	if err != nil {
		return time.Time{}, invalid
	}
	return parsed, nil
}
[[- end]]
[[- if .HasUUID]]

// parse[[.Title]]UUID reads a UUIDv7; anything else is invalid.
func parse[[.Title]]UUID(value string, invalid error) (uuid.UUID, error) {
	parsed, err := uuid.Parse(value)
	if err != nil {
		return uuid.UUID{}, invalid
	}
	return parsed, nil
}
[[- end]]

// [[.Name]]PatchField records whether a JSON member was present and whether it
// was null, which a plain pointer cannot tell apart from absent.
type [[.Name]]PatchField[T any] struct {
	Set   bool
	Value *T
}

// OpenAPIType documents the field as T or null (openapi.Typer).
func ([[.Name]]PatchField[T]) OpenAPIType() openapi.Type { return openapi.TypeOf[*T]() }

func (f *[[.Name]]PatchField[T]) UnmarshalJSON(data []byte) error {
	f.Set = true
	if bytes.Equal(bytes.TrimSpace(data), []byte("null")) {
		f.Value = nil
		return nil
	}
	var value T
	if err := json.Unmarshal(data, &value); err != nil {
		return err
	}
	f.Value = &value
	return nil
}

// [[.Name]]PatchRequest carries the version the client last read and only the
// fields to change. A member left out stays as it is; null clears an optional
// field and is rejected for a required one.
type [[.Name]]PatchRequest struct {
	Version int `json:"version" doc:"The version the client last read."`
[[- range .Fields]]
	[[.Title]] [[printf "%sPatchField[%s]" $.Name .RequestType]] `json:"[[.Name]],omitzero"[[if not .Optional]] openapi:"nonnull"[[end]][[if .IsTime]] format:"date-time"[[else if .IsUUID]] format:"uuid"[[end]]`
[[- end]]
}

func (b [[.Name]]PatchRequest) changes() (domain.[[.Title]]Changes, error) {
	var changes domain.[[.Title]]Changes
[[- range .Fields]]
	if b.[[.Title]].Set {
[[- if .Optional]]
		if b.[[.Title]].Value == nil {
			changes.Clear[[.Title]] = true
		} else {
[[- if or .IsTime .IsUUID]]
			value, err := parse[[$.Title]][[if .IsTime]]Time[[else]]UUID[[end]](*b.[[.Title]].Value, domain.[[.Err]])
			if err != nil {
				return domain.[[$.Title]]Changes{}, err
			}
			changes.[[.Title]] = &value
[[- else]]
			changes.[[.Title]] = b.[[.Title]].Value
[[- end]]
		}
[[- else]]
		if b.[[.Title]].Value == nil {
			return domain.[[$.Title]]Changes{}, domain.[[.Err]]
		}
[[- if or .IsTime .IsUUID]]
		value, err := parse[[$.Title]][[if .IsTime]]Time[[else]]UUID[[end]](*b.[[.Title]].Value, domain.[[.Err]])
		if err != nil {
			return domain.[[$.Title]]Changes{}, err
		}
		changes.[[.Title]] = &value
[[- else]]
		changes.[[.Title]] = b.[[.Title]].Value
[[- end]]
[[- end]]
	}
[[- end]]
	return changes, nil
}

type [[.Name]]Response struct {
	ID uuid.UUID `json:"id"`
[[- range .Fields]]
	[[.Title]] [[.FieldType]] `json:"[[.Name]]"`
[[- end]]
	Version   int       `json:"version"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

func new[[.Title]]Response(entity domain.[[.Title]]) [[.Name]]Response {
	return [[.Name]]Response{
		ID: entity.ID,
[[- range .Fields]]
		[[.Title]]: entity.[[.Title]],
[[- end]]
		Version:   entity.Version,
		CreatedAt: entity.CreatedAt,
		UpdatedAt: entity.UpdatedAt,
	}
}

func (h [[.Name]]Handlers) create(w http.ResponseWriter, r *http.Request) {
	var body [[.Name]]CreateRequest
	if err := web.DecodeJSON(r, &body); err != nil {
		web.Error(w, r, err)
		return
	}
	input, err := body.input()
	if err != nil {
		web.Error(w, r, err)
		return
	}
	entity, err := h.service.Create(r.Context(), input)
	if err != nil {
		web.Error(w, r, err)
		return
	}
	w.Header().Set("Location", [[.Plural]]Path+"/"+entity.ID.String())
	web.JSON(w, http.StatusCreated, new[[.Title]]Response(entity))
}

func (h [[.Name]]Handlers) list(w http.ResponseWriter, r *http.Request) {
	request, err := pagination.FromQuery(r.URL.Query())
	if err != nil {
		web.Error(w, r, err)
		return
	}
	page, err := h.service.List(r.Context(), request)
	if err != nil {
		web.Error(w, r, err)
		return
	}
	items := make([][[.Name]]Response, len(page.Items))
	for i, entity := range page.Items {
		items[i] = new[[.Title]]Response(entity)
	}
	web.JSON(w, http.StatusOK, [[printf "pagination.Page[%sResponse]" .Name]]{Items: items, NextCursor: page.NextCursor})
}

[[- range .References]]

// listBy[[.Title]] lists the [[$.Plural]] of the [[.Human]] the path names; a [[.Human]] the
// caller cannot see is not found.
func (h [[$.Name]]Handlers) listBy[[.Title]](w http.ResponseWriter, r *http.Request) {
	[[.Camel]]ID, err := domain.Parse[[.Title]]ID(r.PathValue("[[.Field.Name]]"))
	if err != nil {
		web.Error(w, r, err)
		return
	}
	request, err := pagination.FromQuery(r.URL.Query())
	if err != nil {
		web.Error(w, r, err)
		return
	}
	page, err := h.service.ListBy[[.Title]](r.Context(), [[.Camel]]ID, request)
	if err != nil {
		web.Error(w, r, err)
		return
	}
	items := make([][[$.Name]]Response, len(page.Items))
	for i, entity := range page.Items {
		items[i] = new[[$.Title]]Response(entity)
	}
	web.JSON(w, http.StatusOK, [[printf "pagination.Page[%sResponse]" $.Name]]{Items: items, NextCursor: page.NextCursor})
}
[[- end]]

func (h [[.Name]]Handlers) get(w http.ResponseWriter, r *http.Request) {
	id, err := domain.Parse[[.Title]]ID(r.PathValue("id"))
	if err != nil {
		web.Error(w, r, err)
		return
	}
	entity, err := h.service.Get(r.Context(), id)
	if err != nil {
		web.Error(w, r, err)
		return
	}
	web.JSON(w, http.StatusOK, new[[.Title]]Response(entity))
}

func (h [[.Name]]Handlers) update(w http.ResponseWriter, r *http.Request) {
	id, err := domain.Parse[[.Title]]ID(r.PathValue("id"))
	if err != nil {
		web.Error(w, r, err)
		return
	}
	var body [[.Name]]PatchRequest
	if err := web.DecodeJSON(r, &body); err != nil {
		web.Error(w, r, err)
		return
	}
	changes, err := body.changes()
	if err != nil {
		web.Error(w, r, err)
		return
	}
	entity, err := h.service.Update(r.Context(), id, body.Version, changes)
	if err != nil {
		web.Error(w, r, err)
		return
	}
	web.JSON(w, http.StatusOK, new[[.Title]]Response(entity))
}

// delete takes the version the client last read as ?version=N.
func (h [[.Name]]Handlers) delete(w http.ResponseWriter, r *http.Request) {
	id, err := domain.Parse[[.Title]]ID(r.PathValue("id"))
	if err != nil {
		web.Error(w, r, err)
		return
	}
	version, err := strconv.Atoi(r.URL.Query().Get("version"))
	if err != nil {
		web.Error(w, r, domain.ErrInvalid[[.Title]]Version)
		return
	}
	if err := h.service.Delete(r.Context(), id, version); err != nil {
		web.Error(w, r, err)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
