const (
	[[.Plural]]Path            = "/v1/[[.Plural]]"
	[[.Plural]]ReadPermission  = "[[.Plural]]:read"
	[[.Plural]]WritePermission = "[[.Plural]]:write"
)

// [[.Title]]Router is where Register[[.PluralTitle]] mounts the routes; *forge.App satisfies it.
type [[.Title]]Router interface {
	Handle(pattern string, handler http.Handler) error
}

// [[.Title]]Protect wraps next so that only callers holding permission reach it.
// The application decides how: the PostgreSQL identity wiring authenticates the
// bearer token and requires the permission. Register[[.PluralTitle]] never mounts a
// route without it, so these endpoints cannot be public by accident.
type [[.Title]]Protect func(permission string, next http.Handler) (http.Handler, error)

// Register[[.PluralTitle]] mounts the [[.Name]] endpoints. Reads require
// "[[.Plural]]:read" and writes "[[.Plural]]:write".[[range .References]]
// GET /v1/[[.Plural]]/{[[.Field.Name]]}/[[$.Plural]] lists the [[$.Plural]] of one [[.Human]].[[end]]
func Register[[.PluralTitle]](router [[.Title]]Router, service *application.[[.Title]]Service, protect [[.Title]]Protect) error {
	if router == nil || service == nil {
		return errors.New("httpapi: router and [[.Name]] service are required")
	}
	if protect == nil {
		return errors.New("httpapi: a protect function is required: [[.Name]] routes are never public")
	}
	h := [[.Name]]Handlers{service: service}
	// Each route declares its request, response and error types for the
	// OpenAPI document (GET /openapi.json, `forge openapi`); the handler
	// tests check the actual responses against it.
	tags := []string{"[[.Plural]]"}
	routes := []struct {
		pattern    string
		permission string
		handler    http.HandlerFunc
		operation  openapi.Operation
	}{
		{"POST " + [[.Plural]]Path, [[.Plural]]WritePermission, h.create, openapi.Operation{
			ID: "create[[.Title]]", Summary: "Create a [[.Name]]", Tags: tags,
			Request:   [[printf "openapi.TypeOf[%sCreateRequest]" .Name]](),
			Responses: []openapi.Response{{Status: http.StatusCreated, Body: [[printf "openapi.TypeOf[%sResponse]" .Name]](), Headers: []string{"Location"}}},
[[- if .References]]
			Errors:    []int{http.StatusUnprocessableEntity},
[[- end]]
		}},
		{"GET " + [[.Plural]]Path, [[.Plural]]ReadPermission, h.list, openapi.Operation{
			ID: "list[[.PluralTitle]]", Summary: "List [[.Plural]], newest first", Tags: tags,
			Params:    openapi.TypeOf[pagination.Query](),
			Responses: []openapi.Response{[[printf "openapi.JSON[pagination.Page[%sResponse]]" .Name]](http.StatusOK)},
			Errors:    []int{http.StatusBadRequest},
		}},
		{"GET " + [[.Plural]]Path + "/{id}", [[.Plural]]ReadPermission, h.get, openapi.Operation{
			ID: "get[[.Title]]", Summary: "Get a [[.Name]]", Tags: tags,
			Params:    [[printf "openapi.TypeOf[%sIDParam]" .Name]](),
			Responses: []openapi.Response{[[printf "openapi.JSON[%sResponse]" .Name]](http.StatusOK)},
			Errors:    []int{http.StatusBadRequest, http.StatusNotFound},
		}},
		{"PATCH " + [[.Plural]]Path + "/{id}", [[.Plural]]WritePermission, h.update, openapi.Operation{
			ID: "update[[.Title]]", Summary: "Change some fields of a [[.Name]]", Tags: tags,
			Params:    [[printf "openapi.TypeOf[%sIDParam]" .Name]](),
			Request:   [[printf "openapi.TypeOf[%sPatchRequest]" .Name]](),
			Responses: []openapi.Response{[[printf "openapi.JSON[%sResponse]" .Name]](http.StatusOK)},
			Errors:    []int{http.StatusNotFound, http.StatusConflict[[if .References]], http.StatusUnprocessableEntity[[end]]},
		}},
		{"DELETE " + [[.Plural]]Path + "/{id}", [[.Plural]]WritePermission, h.delete, openapi.Operation{
			ID: "delete[[.Title]]", Summary: "Delete a [[.Name]]", Tags: tags,
			Params:    [[printf "openapi.TypeOf[%sDeleteParams]" .Name]](),
			Responses: []openapi.Response{openapi.Empty(http.StatusNoContent)},
			Errors:    []int{http.StatusBadRequest, http.StatusNotFound, http.StatusConflict},
		}},
[[- range .References]]
		// The [[$.Plural]] of one [[.Human]] (it has many): /v1/[[.Plural]]/{[[.Field.Name]]}/[[$.Plural]].
		{"GET /v1/[[.Plural]]/{[[.Field.Name]]}/[[$.Plural]]", [[$.Plural]]ReadPermission, h.listBy[[.Title]], openapi.Operation{
			ID: "list[[.Title]][[$.PluralTitle]]", Summary: "List the [[$.Plural]] of a [[.Human]], newest first", Tags: tags,
			Params:    [[printf "openapi.TypeOf[%sBy%sParams]" $.Name .Title]](),
			Responses: []openapi.Response{[[printf "openapi.JSON[pagination.Page[%sResponse]]" $.Name]](http.StatusOK)},
			Errors:    []int{http.StatusBadRequest, http.StatusNotFound},
		}},
[[- end]]
	}
	for _, route := range routes {
		route.operation.Permission = route.permission
		protected, err := protect(route.permission, route.handler)
		if err != nil {
			return fmt.Errorf("protect %s: %w", route.pattern, err)
		}
		if protected == nil {
			return fmt.Errorf("protect %s: the protect function returned no handler", route.pattern)
		}
		if err := router.Handle(route.pattern, openapi.Describe(protected, route.operation)); err != nil {
			return err
		}
	}
	return nil
}

// [[.Name]]IDParam documents the {id} path parameter.
type [[.Name]]IDParam struct {
	ID uuid.UUID `path:"id" doc:"The [[.Name]]'s ID."`
}

// [[.Name]]DeleteParams documents DELETE's parameters.
type [[.Name]]DeleteParams struct {
	[[.Name]]IDParam
	Version int `query:"version" openapi:"required" doc:"The version the client last read."`
}

