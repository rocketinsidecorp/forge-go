func Test[[.Title]]RepositoryListWalksEveryRowOnceNewestFirst(t *testing.T) {
	repo, _ := new[[.Title]]Repository(t)
[[- if .Tenant]]
	_, ctx := new[[.Title]]Tenant(t)
[[- else]]
	ctx := context.Background()
[[- end]]
	const total, limit = 23, 5
	created := make([]domain.[[.Title]], 0, total)
	for range total {
		created = append(created, mustCreate[[.Title]](t, ctx, repo, true))
	}

	seen := make(map[uuid.UUID]bool, total)
	var order []uuid.UUID
	var after uuid.UUID
	for pages := 0; ; pages++ {
		if pages > total {
			t.Fatal("pagination does not terminate")
		}
		rows, err := repo.List(ctx, after, limit)
		if err != nil {
			t.Fatal(err)
		}
		if len(rows) == 0 {
			break
		}
		for _, entity := range rows {
			if seen[entity.ID] {
				t.Fatalf("[[.Name]] %v returned twice", entity.ID)
			}
			seen[entity.ID] = true
			order = append(order, entity.ID)
		}
		after = rows[len(rows)-1].ID
	}

	if len(order) != total {
		t.Fatalf("walked %d rows, want %d", len(order), total)
	}
	for i, id := range order {
		if want := created[total-1-i].ID; id != want {
			t.Fatalf("position %d: got %v, want %v (newest first)", i, id, want)
		}
	}
}

