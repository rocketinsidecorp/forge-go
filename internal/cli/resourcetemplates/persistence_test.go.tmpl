// new[[.Title]]Tenant returns a fresh tenant and a context carrying it.
func new[[.Title]]Tenant(t *testing.T) (tenancy.Tenant, context.Context) {
	t.Helper()
	tenant, err := tenancy.New(uuid.MustNew())
	if err != nil {
		t.Fatal(err)
	}
	ctx, err := tenancy.WithContext(context.Background(), tenant)
	if err != nil {
		t.Fatal(err)
	}
	return tenant, ctx
}
[[- end]]

