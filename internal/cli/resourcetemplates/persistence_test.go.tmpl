func Test[[.Title]]RepositoryUpdate(t *testing.T) {
	repo, _ := new[[.Title]]Repository(t)
[[- if .Tenant]]
	_, ctx := new[[.Title]]Tenant(t)
[[- else]]
	ctx := context.Background()
[[- end]]
	original := mustCreate[[.Title]](t, ctx, repo, true)

	changed, err := original.Apply(domain.[[.Title]]Changes{
		[[.SampleChanges 2]]
	}, original.UpdatedAt.Add(time.Second))
	if err != nil {
		t.Fatal(err)
	}
	updated, err := repo.Update(ctx, changed)
	if err != nil {
		t.Fatal(err)
	}
	want := changed
	want.Version = original.Version + 1
	if [[.Name]]JSON(t, updated) != [[.Name]]JSON(t, want) {
		t.Fatalf("updated = %s, want %s", [[.Name]]JSON(t, updated), [[.Name]]JSON(t, want))
	}
	stored, err := repo.Get(ctx, original.ID)
	if err != nil || [[.Name]]JSON(t, stored) != [[.Name]]JSON(t, want) {
		t.Fatalf("stored = %v, %v; want %s", stored, err, [[.Name]]JSON(t, want))
	}

	// changed still carries the old version, which is now stale.
	if _, err := repo.Update(ctx, changed); !errors.Is(err, domain.ErrStale[[.Title]]Version) {
		t.Fatalf("stale update: err = %v, want ErrStale[[.Title]]Version", err)
	}
	missing := new[[.Title]]Entity(t, true)
	if _, err := repo.Update(ctx, missing); !errors.Is(err, domain.Err[[.Title]]NotFound) {
		t.Fatalf("missing update: err = %v, want Err[[.Title]]NotFound", err)
	}
	if after, _ := repo.Get(ctx, original.ID); [[.Name]]JSON(t, after) != [[.Name]]JSON(t, want) {
		t.Fatalf("a rejected update changed the row: %s", [[.Name]]JSON(t, after))
	}
}
