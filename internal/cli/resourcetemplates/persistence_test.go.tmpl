// Two tenants hold rows with identical field values. Whatever tenant A asks
// for, it never reads, changes or removes tenant B's rows, and each tenant's
// list holds only its own.
func Test[[.Title]]RepositoryIsolatesTenants(t *testing.T) {
	repo, _ := new[[.Title]]Repository(t)
	_, ctxA := new[[.Title]]Tenant(t)
	_, ctxB := new[[.Title]]Tenant(t)

	var rowsA, rowsB []domain.[[.Title]]
	for range 3 {
		rowsA = append(rowsA, mustCreate[[.Title]](t, ctxA, repo, true))
		rowsB = append(rowsB, mustCreate[[.Title]](t, ctxB, repo, true))
	}

	for _, foreign := range rowsB {
		if _, err := repo.Get(ctxA, foreign.ID); !errors.Is(err, domain.Err[[.Title]]NotFound) {
			t.Errorf("tenant A Get(B's row): err = %v, want Err[[.Title]]NotFound", err)
		}
		// Not stale: tenant A must not even learn that the row exists.
		if _, err := repo.Update(ctxA, foreign); !errors.Is(err, domain.Err[[.Title]]NotFound) {
			t.Errorf("tenant A Update(B's row): err = %v, want Err[[.Title]]NotFound", err)
		}
		if err := repo.Delete(ctxA, foreign.ID, foreign.Version); !errors.Is(err, domain.Err[[.Title]]NotFound) {
			t.Errorf("tenant A Delete(B's row): err = %v, want Err[[.Title]]NotFound", err)
		}
	}

	if got, want := [[.Name]]IDs(t, ctxA, repo), idsNewestFirst[[.Title]](rowsA); !sameIDs[[.Title]](got, want) {
		t.Errorf("tenant A list = %v, want only its own rows %v", got, want)
	}
	if got, want := [[.Name]]IDs(t, ctxB, repo), idsNewestFirst[[.Title]](rowsB); !sameIDs[[.Title]](got, want) {
		t.Errorf("tenant B list = %v, want only its own rows %v", got, want)
	}
	for _, own := range rowsB {
		got, err := repo.Get(ctxB, own.ID)
		if err != nil || [[$.Name]]JSON(t, got) != [[$.Name]]JSON(t, own) {
			t.Errorf("tenant B row %v changed after tenant A's attempts: %v, %v", own.ID, got, err)
		}
	}
}

func idsNewestFirst[[.Title]](rows []domain.[[.Title]]) []uuid.UUID {
	ids := make([]uuid.UUID, len(rows))
	for i, row := range rows {
		ids[len(rows)-1-i] = row.ID
	}
	return ids
}

func sameIDs[[.Title]](a, b []uuid.UUID) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func Test[[.Title]]RepositoryRequiresTenant(t *testing.T) {
	repo, _ := new[[.Title]]Repository(t)
	ctx := context.Background()
	entity := new[[.Title]]Entity(t, true)
	checks := map[string]error{}
	_, checks["Create"] = repo.Create(ctx, entity)
	_, checks["Get"] = repo.Get(ctx, entity.ID)
	_, checks["List"] = repo.List(ctx, uuid.UUID{}, 10)
	_, checks["Update"] = repo.Update(ctx, entity)
	checks["Delete"] = repo.Delete(ctx, entity.ID, entity.Version)
	for method, err := range checks {
		if !errors.Is(err, tenancy.ErrMissing) {
			t.Errorf("%s without a tenant: err = %v, want tenant_required", method, err)
		}
	}
}
