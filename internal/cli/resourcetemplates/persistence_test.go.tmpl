[[- if .Postgres]]

// insufficientPrivilege[[.Title]] reports PostgreSQL's 42501, also raised for a row
// that violates a row-level security policy.
func insufficientPrivilege[[.Title]](err error) bool {
	var pgErr *pgconn.PgError
	return errors.As(err, &pgErr) && pgErr.Code == "42501"
}

// The runtime role holds data privileges only: whatever an attacker makes the
// application run, it cannot change, drop or empty the table[[if .Tenant]] or switch its
// row-level security off[[end]].
func Test[[.Title]]RuntimeRoleCannotChangeTheSchema(t *testing.T) {
	_, database := new[[.Title]]Repository(t)
	ctx := context.Background()
	for _, statement := range []string{
		`CREATE TABLE [[.Q "intruders"]] ([[.Q "id"]] uuid)`,
		`CREATE TEMPORARY TABLE [[.Q "scratch"]] ([[.Q "id"]] uuid)`,
		`ALTER TABLE [[.Q .Plural]] ADD COLUMN [[.Q "intruder"]] text`,
[[- if .Tenant]]
		`ALTER TABLE [[.Q .Plural]] DISABLE ROW LEVEL SECURITY`,
		`ALTER TABLE [[.Q .Plural]] NO FORCE ROW LEVEL SECURITY`,
[[- end]]
		`TRUNCATE [[.Q .Plural]]`,
		`DROP TABLE [[.Q .Plural]]`,
	} {
		if _, err := database.Runtime.Exec(ctx, statement); !insufficientPrivilege[[.Title]](err) {
			t.Errorf("the runtime role ran %s: err = %v, want insufficient privilege (42501)", statement, err)
		}
	}
}
[[- end]]
[[- if and .Postgres .Tenant]]

// The repository's own predicates are not the only protection: as the runtime
// role the application serves with, the table's row-level security policy
// confines every statement to the tenant InTenantTx set, even one without a
// tenant predicate, and a session without a tenant sees nothing.
func Test[[.Title]]RowLevelSecurity(t *testing.T) {
	repo, database := new[[.Title]]Repository(t)
	_, ctxA := new[[.Title]]Tenant(t)
	tenantB, ctxB := new[[.Title]]Tenant(t)
	own := mustCreate[[.Title]](t, ctxA, repo, true)
	foreign := mustCreate[[.Title]](t, ctxB, repo, true)

	// As tenant A, with no tenant_id predicate anywhere.
	ctx := context.Background()
	tenantID := tenantB.ID
	err := database.Runtime.InTenantTx(ctxA, func(tx pgx.Tx) error {
		var visible, foreignVisible int
		if err := tx.QueryRow(ctx, `SELECT count(*) FROM [[.Q .Plural]]`).Scan(&visible); err != nil {
			return err
		}
		if err := tx.QueryRow(ctx, `SELECT count(*) FROM [[.Q .Plural]] WHERE [[.Q "id"]] = $1`, foreign.ID).Scan(&foreignVisible); err != nil {
			return err
		}
		if visible != 1 || foreignVisible != 0 {
			t.Errorf("tenant A sees %d rows (%d of tenant B's), want exactly its own", visible, foreignVisible)
		}
		update, err := tx.Exec(ctx, `UPDATE [[.Q .Plural]] SET [[.Q "version"]] = [[.Q "version"]] + 1 WHERE [[.Q "id"]] = $1`, foreign.ID)
		if err != nil {
			return err
		}
		remove, err := tx.Exec(ctx, `DELETE FROM [[.Q .Plural]] WHERE [[.Q "id"]] = $1`, foreign.ID)
		if err != nil {
			return err
		}
		if update.RowsAffected() != 0 || remove.RowsAffected() != 0 {
			t.Errorf("tenant A changed %d and removed %d of tenant B's rows", update.RowsAffected(), remove.RowsAffected())
		}
		if _, err := tx.Exec(ctx, "SAVEPOINT cross_tenant_insert"); err != nil {
			return err
		}
		_, err = tx.Exec(ctx, `[[.RawInsert]]`, [[.RawInsertArgs]])
		if !insufficientPrivilege[[.Title]](err) {
			t.Errorf("inserting a row for tenant B as tenant A: err = %v, want a row-level security violation (42501)", err)
		}
		_, err = tx.Exec(ctx, "ROLLBACK TO SAVEPOINT cross_tenant_insert")
		return err
	})
	if err != nil {
		t.Fatal(err)
	}

	// Without InTenantTx nothing is visible: the policy fails closed.
	var visible int
	if err := database.Runtime.QueryRow(ctx, `SELECT count(*) FROM [[.Q .Plural]]`).Scan(&visible); err != nil {
		t.Fatal(err)
	}
	if visible != 0 {
		t.Errorf("a session without a tenant sees %d rows, want none", visible)
	}

	for _, check := range []struct {
		name string
		ctx  context.Context
		row  domain.[[.Title]]
	}{{"tenant A", ctxA, own}, {"tenant B", ctxB, foreign}} {
		got, err := repo.Get(check.ctx, check.row.ID)
		if err != nil || [[.Name]]JSON(t, got) != [[.Name]]JSON(t, check.row) {
			t.Errorf("%s row after the checks: %v, %v", check.name, got, err)
		}
	}
}

// FORCE ROW LEVEL SECURITY is what subjects the table's owner, the migration
// role, to the policy (an owner otherwise bypasses it). Without it, a service
// that connects as the owner would see every tenant's rows.
func Test[[.Title]]RowLevelSecurityAppliesToTheOwner(t *testing.T) {
	repo, database := new[[.Title]]Repository(t)
	_, ctxA := new[[.Title]]Tenant(t)
	_, ctxB := new[[.Title]]Tenant(t)
	mustCreate[[.Title]](t, ctxA, repo, true)
	mustCreate[[.Title]](t, ctxB, repo, true)

	err := database.Migrator.InTenantTx(ctxA, func(tx pgx.Tx) error {
		var visible int
		if err := tx.QueryRow(ctxA, `SELECT count(*) FROM [[.Q .Plural]]`).Scan(&visible); err != nil {
			return err
		}
		if visible != 1 {
			t.Errorf("the table owner sees %d rows as tenant A, want 1: is FORCE ROW LEVEL SECURITY missing?", visible)
		}
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
}
[[- end]]
