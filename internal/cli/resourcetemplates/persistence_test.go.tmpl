func Test[[.Title]]RepositoryCreateAndGet(t *testing.T) {
	repo, _ := new[[.Title]]Repository(t)
[[- if .Tenant]]
	_, ctx := new[[.Title]]Tenant(t)
[[- else]]
	ctx := context.Background()
[[- end]]
	for name, full := range map[string]bool{"all fields": true, "required fields only": false} {
		entity := new[[.Title]]Entity(t, full)
		created, err := repo.Create(ctx, entity)
		if err != nil {
			t.Fatalf("%s: %v", name, err)
		}
		if [[.Name]]JSON(t, created) != [[.Name]]JSON(t, entity) {
			t.Fatalf("%s: created = %s, want %s", name, [[.Name]]JSON(t, created), [[.Name]]JSON(t, entity))
		}
		got, err := repo.Get(ctx, entity.ID)
		if err != nil {
			t.Fatalf("%s: %v", name, err)
		}
		if [[.Name]]JSON(t, got) != [[.Name]]JSON(t, entity) {
			t.Fatalf("%s: stored = %s, want %s", name, [[.Name]]JSON(t, got), [[.Name]]JSON(t, entity))
		}
		if got.CreatedAt.Location() != time.UTC || got.UpdatedAt.Location() != time.UTC {
			t.Fatalf("%s: timestamps must be UTC, got %v and %v", name, got.CreatedAt.Location(), got.UpdatedAt.Location())
		}
	}
}

