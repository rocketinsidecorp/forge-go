// These are integration tests. Each one migrates a database of its own, and
// they run one after another so a shared test server is not asked to create
// dozens of databases at once.
[[- if .SQLite]]
// SQLite needs no server.
[[- else]]
// They need a [[.Database]] server (FORGE_TEST_DATABASE_URL or the adapter-specific
// FORGE_TEST_*_URL variable) and fail instead of skipping when
// FORGE_TEST_REQUIRE_DATABASE=true.
[[- end]]

func new[[.Title]]Repository(t *testing.T) (*persistence.[[.Title]]Repository, [[if .Postgres]]*postgrestest.RLS[[else]]*sqldb.DB[[end]]) {
	t.Helper()
[[- if .Postgres]]
	// Migrated as the migration role that owns the schema[[if .Identity]] (the migration
	// seeds forge_permissions, so the identity migrations run first)[[end]]. The
	// repository runs as the runtime role the application serves with: not a
	// superuser, no BYPASSRLS, not the owner, only data privileges.
	database := postgrestest.NewRLS(t, [[if .Identity]]authpostgres.Migrations(), [[end]]db.Migrations())
	return persistence.New[[.Title]]Repository(database.Runtime), database
[[- else]]
	database := [[.Database]]test.NewMigrated(t, db.Migrations())
	return persistence.New[[.Title]]Repository(database), database
[[- end]]
}
