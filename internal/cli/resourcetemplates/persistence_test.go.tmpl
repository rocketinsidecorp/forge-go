// Versions are 64-bit: a client-supplied version beyond 32 bits must be a stale
// version, not a database error.
func Test[[.Title]]RepositoryHugeVersionsAreStale(t *testing.T) {
	[[- if .Tenant]]
	_, ctx := new[[.Title]]Tenant(t)
	[[- else]]
	ctx := context.Background()
	[[- end]]
	repo, _ := new[[.Title]]Repository(t)
	entity := mustCreate[[.Title]](t, ctx, repo, true)
	huge := int(int64(math.MaxInt32) + 1)

	if err := repo.Delete(ctx, entity.ID, huge); !errors.Is(err, domain.ErrStale[[.Title]]Version) {
		t.Fatalf("delete with version %d: err = %v, want ErrStale[[.Title]]Version", huge, err)
	}
	entity.Version = huge
	if _, err := repo.Update(ctx, entity); !errors.Is(err, domain.ErrStale[[.Title]]Version) {
		t.Fatalf("update with version %d: err = %v, want ErrStale[[.Title]]Version", huge, err)
	}
}

func Test[[.Title]]RepositoryDelete(t *testing.T) {
	repo, _ := new[[.Title]]Repository(t)
[[- if .Tenant]]
	_, ctx := new[[.Title]]Tenant(t)
[[- else]]
	ctx := context.Background()
[[- end]]
	entity := mustCreate[[.Title]](t, ctx, repo, true)

	if err := repo.Delete(ctx, entity.ID, entity.Version+1); !errors.Is(err, domain.ErrStale[[.Title]]Version) {
		t.Fatalf("stale delete: err = %v, want ErrStale[[.Title]]Version", err)
	}
	if _, err := repo.Get(ctx, entity.ID); err != nil {
		t.Fatalf("a stale delete removed the row: %v", err)
	}
	if err := repo.Delete(ctx, uuid.MustNew(), 1); !errors.Is(err, domain.Err[[.Title]]NotFound) {
		t.Fatalf("missing delete: err = %v, want Err[[.Title]]NotFound", err)
	}
	if err := repo.Delete(ctx, entity.ID, entity.Version); err != nil {
		t.Fatal(err)
	}
	if _, err := repo.Get(ctx, entity.ID); !errors.Is(err, domain.Err[[.Title]]NotFound) {
		t.Fatalf("after delete: err = %v, want Err[[.Title]]NotFound", err)
	}
}
