// [[.Name]]MemoryRepository is an in-memory [[.Title]]Repository with the same error
// contract as the database adapters.
type [[.Name]]MemoryRepository struct {
	mu   sync.Mutex
	rows map[uuid.UUID]domain.[[.Title]]
}

var _ application.[[.Title]]Repository = (*[[.Name]]MemoryRepository)(nil)

func new[[.Title]]MemoryRepository() *[[.Name]]MemoryRepository {
	return &[[.Name]]MemoryRepository{rows: make(map[uuid.UUID]domain.[[.Title]])}
}

func (r *[[.Name]]MemoryRepository) Create(_ context.Context, entity domain.[[.Title]]) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.rows[entity.ID] = entity
	return entity, nil
}

func (r *[[.Name]]MemoryRepository) Get(_ context.Context, id uuid.UUID) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	entity, ok := r.rows[id]
	if !ok {
		return domain.[[.Title]]{}, domain.Err[[.Title]]NotFound
	}
	return entity, nil
}

func (r *[[.Name]]MemoryRepository) List(_ context.Context, after uuid.UUID, limit int) ([]domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	newestFirst := slices.SortedFunc(maps.Values(r.rows), func(a, b domain.[[.Title]]) int { return cmp.Compare(0, a.ID.Compare(b.ID)) })
	var page []domain.[[.Title]]
	for _, entity := range newestFirst {
		if after != (uuid.UUID{}) && entity.ID.Compare(after) >= 0 {
			continue
		}
		if len(page) == limit {
			break
		}
		page = append(page, entity)
	}
	return page, nil
}

func (r *[[.Name]]MemoryRepository) Update(_ context.Context, entity domain.[[.Title]]) (domain.[[.Title]], error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	stored, ok := r.rows[entity.ID]
	switch {
	case !ok:
		return domain.[[.Title]]{}, domain.Err[[.Title]]NotFound
	case stored.Version != entity.Version:
		return domain.[[.Title]]{}, domain.ErrStale[[.Title]]Version
	}
	entity.Version++
	r.rows[entity.ID] = entity
	return entity, nil
}

func (r *[[.Name]]MemoryRepository) Delete(_ context.Context, id uuid.UUID, version int) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	stored, ok := r.rows[id]
	switch {
	case !ok:
		return domain.Err[[.Title]]NotFound
	case stored.Version != version:
		return domain.ErrStale[[.Title]]Version
	}
	delete(r.rows, id)
	return nil
}

// bump simulates another request changing the [[.Name]] behind the service's back.
func (r *[[.Name]]MemoryRepository) bump(id uuid.UUID) {
	r.mu.Lock()
	defer r.mu.Unlock()
	entity := r.rows[id]
	entity.Version++
	r.rows[id] = entity
}

var [[.Name]]ClockStart = time.Date(2026, 9, 26, 12, 0, 0, 0, time.UTC)

// [[.Name]]Fixture is a service over an in-memory store with a clock that advances
// one second per reading, so every timestamp in a test is distinct and known.
type [[.Name]]Fixture struct {
	service *application.[[.Title]]Service
	repo    *[[.Name]]MemoryRepository
}

func new[[.Title]]Fixture(t *testing.T) [[.Name]]Fixture {
	t.Helper()
	repo := new[[.Title]]MemoryRepository()
	ticks := 0
	clock := func() time.Time {
		ticks++
		return [[.Name]]ClockStart.Add(time.Duration(ticks) * time.Second)
	}
	service, err := application.New[[.Title]]Service(repo, clock, uuid.New)
	if err != nil {
		t.Fatal(err)
	}
	return [[.Name]]Fixture{service: service, repo: repo}
}

func (f [[.Name]]Fixture) create(t *testing.T, n int) domain.[[.Title]] {
	t.Helper()
	entity, err := f.service.Create(context.Background(), domain.[[.Title]]Input{
		[[.SampleInput 1 true]]
	})
	if err != nil {
		t.Fatalf("create #%d: %v", n, err)
	}
	return entity
}

