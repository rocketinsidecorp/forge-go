func Test[[.Title]]ServiceRequiresDependencies(t *testing.T) {
	t.Parallel()
	repo := new[[.Title]]MemoryRepository()
	if _, err := application.New[[.Title]]Service(nil, time.Now, uuid.New); err == nil {
		t.Error("nil repository accepted")
	}
	if _, err := application.New[[.Title]]Service(repo, nil, uuid.New); err == nil {
		t.Error("nil clock accepted")
	}
	if _, err := application.New[[.Title]]Service(repo, time.Now, nil); err == nil {
		t.Error("nil id source accepted")
	}
}

func Test[[.Title]]ServiceCreate(t *testing.T) {
	t.Parallel()
	f := new[[.Title]]Fixture(t)
	entity := f.create(t, 1)
	if entity.Version != 1 || !entity.CreatedAt.Equal([[.Name]]ClockStart.Add(time.Second)) || !entity.UpdatedAt.Equal(entity.CreatedAt) {
		t.Fatalf("entity = %s", [[.Name]]JSON(t, entity))
	}
	if entity.ID.Version() != 7 {
		t.Fatalf("id %v is not a UUIDv7", entity.ID)
	}
	stored, err := f.service.Get(context.Background(), entity.ID)
	if err != nil || [[.Name]]JSON(t, stored) != [[.Name]]JSON(t, entity) {
		t.Fatalf("stored = %v, %v", stored, err)
	}
}

