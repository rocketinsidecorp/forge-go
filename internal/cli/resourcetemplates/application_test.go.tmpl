func Test[[.Title]]ServiceListPagesNewestFirst(t *testing.T) {
	t.Parallel()
	f := new[[.Title]]Fixture(t)
	const total = 5
	created := make([]domain.[[.Title]], 0, total)
	for i := range total {
		created = append(created, f.create(t, i))
	}

	var seen []uuid.UUID
	request := pagination.Request{Limit: 2}
	pages := 0
	for {
		pages++
		page, err := f.service.List(context.Background(), request)
		if err != nil {
			t.Fatal(err)
		}
		for _, entity := range page.Items {
			seen = append(seen, entity.ID)
		}
		if page.NextCursor == "" {
			break
		}
		if request.After, err = pagination.DecodeCursor(page.NextCursor); err != nil {
			t.Fatal(err)
		}
		if pages > total {
			t.Fatal("pagination does not terminate")
		}
	}
	if pages != 3 || len(seen) != total {
		t.Fatalf("walked %d pages and %d rows, want 3 and %d", pages, len(seen), total)
	}
	for i, id := range seen {
		if want := created[total-1-i].ID; id != want {
			t.Fatalf("position %d: got %v, want %v (newest first)", i, id, want)
		}
	}

	// A zero limit means the default; an oversized limit is capped.
	for _, limit := range []int{0, 1 << 20} {
		page, err := f.service.List(context.Background(), pagination.Request{Limit: limit})
		if err != nil || len(page.Items) != total || page.NextCursor != "" {
			t.Fatalf("limit %d: %d items, cursor %q, err %v", limit, len(page.Items), page.NextCursor, err)
		}
	}
}

func Test[[.Title]]ServiceUpdate(t *testing.T) {
	t.Parallel()
	f := new[[.Title]]Fixture(t)
	entity := f.create(t, 1)
	ctx := context.Background()

	updated, err := f.service.Update(ctx, entity.ID, entity.Version, domain.[[.Title]]Changes{
		[[.SampleChanges 2]]
	})
	if err != nil {
		t.Fatal(err)
	}
	if updated.Version != 2 || !updated.CreatedAt.Equal(entity.CreatedAt) || !updated.UpdatedAt.After(entity.UpdatedAt) {
		t.Fatalf("updated = %s", [[.Name]]JSON(t, updated))
	}
	stored, err := f.service.Get(ctx, entity.ID)
	if err != nil || [[.Name]]JSON(t, stored) != [[.Name]]JSON(t, updated) {
		t.Fatalf("stored = %v, %v; want the updated [[.Name]]", stored, err)
	}

	// Replaying the first request is rejected as stale and changes nothing.
	f.repo.bump(entity.ID)
	_, err = f.service.Update(ctx, entity.ID, 2, domain.[[.Title]]Changes{
		[[.SampleChanges 3]]
	})
	if !errors.Is(err, domain.ErrStale[[.Title]]Version) {
		t.Fatalf("stale update: err = %v, want ErrStale[[.Title]]Version", err)
	}
}

func Test[[.Title]]ServiceUpdateErrors(t *testing.T) {
	t.Parallel()
	f := new[[.Title]]Fixture(t)
	entity := f.create(t, 1)
	ctx := context.Background()
	changes := domain.[[.Title]]Changes{
		[[.SampleChanges 2]]
	}
	if _, err := f.service.Update(ctx, uuid.MustNew(), 1, changes); !errors.Is(err, domain.Err[[.Title]]NotFound) {
		t.Errorf("missing: err = %v, want Err[[.Title]]NotFound", err)
	}
	if _, err := f.service.Update(ctx, entity.ID, 0, changes); !errors.Is(err, domain.ErrInvalid[[.Title]]Version) {
		t.Errorf("version 0: err = %v, want ErrInvalid[[.Title]]Version", err)
	}
	if _, err := f.service.Update(ctx, entity.ID, entity.Version, domain.[[.Title]]Changes{}); !errors.Is(err, domain.ErrEmpty[[.Title]]Changes) {
		t.Errorf("empty changes: err = %v, want ErrEmpty[[.Title]]Changes", err)
	}
	stored, err := f.service.Get(ctx, entity.ID)
	if err != nil || [[.Name]]JSON(t, stored) != [[.Name]]JSON(t, entity) {
		t.Fatalf("a rejected update modified the [[.Name]]: %v, %v", stored, err)
	}
}

func Test[[.Title]]ServiceDelete(t *testing.T) {
	t.Parallel()
	f := new[[.Title]]Fixture(t)
	entity := f.create(t, 1)
	ctx := context.Background()

	if err := f.service.Delete(ctx, entity.ID, 0); !errors.Is(err, domain.ErrInvalid[[.Title]]Version) {
		t.Errorf("version 0: err = %v, want ErrInvalid[[.Title]]Version", err)
	}
	if err := f.service.Delete(ctx, entity.ID, entity.Version+1); !errors.Is(err, domain.ErrStale[[.Title]]Version) {
		t.Errorf("stale: err = %v, want ErrStale[[.Title]]Version", err)
	}
	if _, err := f.service.Get(ctx, entity.ID); err != nil {
		t.Fatalf("a stale delete removed the [[.Name]]: %v", err)
	}
	if err := f.service.Delete(ctx, entity.ID, entity.Version); err != nil {
		t.Fatal(err)
	}
	if _, err := f.service.Get(ctx, entity.ID); !errors.Is(err, domain.Err[[.Title]]NotFound) {
		t.Fatalf("after delete: err = %v, want Err[[.Title]]NotFound", err)
	}
	if err := f.service.Delete(ctx, entity.ID, entity.Version); !errors.Is(err, domain.Err[[.Title]]NotFound) {
		t.Errorf("second delete: err = %v, want Err[[.Title]]NotFound", err)
	}
}
